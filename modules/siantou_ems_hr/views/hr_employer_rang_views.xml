<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_employee_rang_view_tree" model="ir.ui.view">
        <field name="name">hr_employee_rang.view.form</field>
        <field name="model">hr.employee.rang</field>
        <field name="arch" type="xml">
            <tree string="Liste des rangs" editable="top">
                <field name="name" />
                <field name="code" />
            </tree>
        </field>
    </record>

    <record id="hr_employee_rang_view_action" model="ir.actions.act_window">
        <field name="name">Rangs</field>
        <field name="res_model">hr.employee.rang</field>
        <field name="view_mode">tree</field>
    </record>

</odoo>