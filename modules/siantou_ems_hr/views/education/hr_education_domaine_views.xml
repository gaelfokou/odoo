<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_education_domaine_view_tree" model="ir.ui.view">
        <field name="name">hr_education_domaine.view.tree</field>
        <field name="model">hr.education.domaine</field>
        <field name="arch" type="xml">
            <tree string="Liste domaine" editable='bottom'>
                <field name="name" />
                <field name="code" />
                <field name="active" />
            </tree>
        </field>
    </record>

    <record id="hr_education_domaine_action" model="ir.actions.act_window">
        <field name="name">Domaine des diplômes</field>
        <field name="res_model">hr.education.domaine</field>
        <field name="view_mode">tree</field>
    </record>


</odoo>