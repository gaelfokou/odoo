<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="motif_lienciement_view_tree" model="ir.ui.view">
        <field name="name">motif_lienciement.view.tree</field>
        <field name="model">hr.motif.licenciement</field>
        <field name="arch" type="xml">
            <tree string="Motifs de licenciément" editable="top">
                <field name="code" />
                <field name="name" />
            </tree>
        </field>
    </record>

    <record id="motif_lienciement_action" model="ir.actions.act_window">
        <field name="name">Motifs de licenciément</field>
        <field name="res_model">hr.motif.licenciement</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
