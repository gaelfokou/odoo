<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="employee_family_view_form" model="ir.ui.view">
        <field name="name">employee_family_view_form.view.form</field>
        <field name="model">hr.employee.family</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group col="4">
                        <group colspan="2">
                            <field name="employee_id" />
                        </group>
                        <group colspan="2">
                            <field name="nom_enfant" />
                        </group>
                        <group colspan="2">
                            <field name="date_naissance" />
                        </group>
                        <group colspan="2">
                            <field name="genre_enfant" />
                        </group>
                        <group colspan="2">
                            <field name="school" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="employee_family_view_tree" model="ir.ui.view">
        <field name="name">employee_family_view_tree.view.tree</field>
        <field name="model">hr.employee.family</field>
        <field name="arch" type="xml">
            <tree string="">
                <field name="employee_id" />
                <field name="nom_enfant" />
                <field name="date_naissance" />
                <field name="genre_enfant" />
            </tree>
        </field>
    </record>

    <record id="employee_family_action" model="ir.actions.act_window">
        <field name="name">Enfant(s)</field>
        <field name="res_model">hr.employee.family</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                créer ici.
            </p>
        </field>
    </record>
</odoo>
