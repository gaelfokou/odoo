<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_employee_fonction_view_form" model="ir.ui.view">
        <field name="name">hr_employee_fonction.view.form</field>
        <field name="model">hr.employee.fonction</field>
        <field name="arch" type="xml">
            <form string="Formulaire d'enregistrement d'un fonction">
                <sheet>
                    <group col="4">
                        <group colspan="2" string="Informations générales">
                            <field name="name" />
                            <field name="is_manager" />
                        </group>

                        <group colspan="2" string="Informations comlémentaires">
                            <field name="code" />
                            <field name="rang" options="{'no_create': True}"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_employee_fonction_view_tree" model="ir.ui.view">
        <field name="name">hr_employee_fonction.view.tree</field>
        <field name="model">hr.employee.fonction</field>
        <field name="arch" type="xml">
            <tree string="Liste des fonctions">
                <field name="name" />
                <field name="code" />
                <field name="active" />
                <field name="rang" />
            </tree>
        </field>
    </record>

    <!-- Action du menu de fonction -->
    <record id="hr_employee_fonction_action" model="ir.actions.act_window">
        <field name="name">Fonctions</field>
        <field name="res_model">hr.employee.fonction</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                créer ici.
            </p>
        </field>
    </record>


</odoo>