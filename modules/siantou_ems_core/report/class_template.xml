<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_class" model="report.paperformat">
        <field name="name">Format du diplome</field>
        <field name="default" eval="True"/>
        <field name="format">A2</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="True"/>
        <field name="header_spacing">5</field>
        <field name="dpi">90</field>
    </record>
    <record id="action_report_class" model="ir.actions.report">
        <field name="name">Classe PDF</field>
        <field name="model">siantou.ems.core.class</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">siantou_ems_core.report_class</field>
        <field name="report_file">siantou_ems_core.report_class</field>
        <field name="print_report_name">'Fiche de - %s' % (docdata.semester)</field>
        <field name="binding_model_id" eval="False"/>
        <field name="paperformat_id" ref="paperformat_class"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Template du rapport -->
    <template id="report_class">
        <t t-call="web.html_container">
            <t t-if="docdata and docdata['class_data']">
                <t t-call="web.external_layout">
                    <style>
                        .table {
                            border-collapse: collapse;
                            width: 100%;
                        }
                        .table .thead th, .table td {
                            border: 1px solid black;
                            padding: 8px;
                            text-align: center;
                        }
                        .table .thead th {
                            background-color: #f2f2f2;
                        }
                    </style>
                    <div class="page">
                        <table class="table table-bordered table-sm text-center">
                            <thead>
                                <tr>
                                    <th class="text-center" colspan="8" style="box-shadow: inset 0 0 0 9999px transparent; border-style: hidden;">
                                        <h3>INSTITUT UNIVERSITAIRE SIANTOU</h3>
                                        <h4>
                                            <span t-esc="'Liste des classes'"/>
                                        </h4>
                                        <h5 class="text-left">
                                            <span t-esc="'Filtre :'"/>
                                            <span t-esc="docdata['filter'] or 'Non spécifié'"/>
                                        </h5>
                                    </th>
                                </tr>
                            </thead>
                            <thead>
                                <tr>
                                    <th class="text-left" colspan="8" style="box-shadow: inset 0 0 0 9999px transparent; border-style: hidden;"><br/></th>
                                </tr>
                            </thead>
                            <thead>
                                <tr class="active">
                                    <th class="text-center">Nom de la classe</th>
                                    <th class="text-center">Année académique</th>
                                    <th class="text-center">École</th>
                                    <th class="text-center">Filière</th>
                                    <th class="text-center">Niveau</th>
                                    <th class="text-center">Spécialité</th>
                                    <th class="text-center">Option</th>
                                    <th class="text-center">Type de cours</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="classes" t-value="docdata['class_data']"/>
                                <t t-foreach="classes" t-as="classe">
                                    <tr>
                                        <td class="text-center">
                                            <span t-esc="classe['name']"/>
                                        </td>
                                        <td class="text-center">
                                            <span t-esc="classe['year']"/>
                                        </td>
                                        <td class="text-center">
                                            <span t-esc="classe['school']"/>
                                        </td>
                                        <td class="text-center">
                                            <span t-esc="classe['field_of_study']"/>
                                        </td>
                                        <td class="text-center">
                                            <span t-esc="classe['level']"/>
                                        </td>
                                        <td class="text-center">
                                            <span t-esc="classe['specialty']"/>
                                        </td>
                                        <td class="text-center">
                                            <span t-esc="classe['option']"/>
                                        </td>
                                        <td class="text-center">
                                            <span t-esc="classe['type_cour']"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
            <t t-else="">
                <div>Aucune donnée d'emploi du temps disponible. Veuillez vérifier vos filtres.</div>
            </t>
        </t>
    </template>
</odoo>
