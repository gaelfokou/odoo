<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Template du rapport -->
    <template id="report_timetable">
        <t t-call="web.basic_layout">
            <div class="page">
                <t t-if="docdata and docdata['timetable_data']">
                    <t t-foreach="docdata['timetable_data']" t-as="record">
                        <h1 style="text-center">INSTITUT UNIVERSITAIRE SIANTOU</h1>
                        <h3 style="text-center">Emploi du Temps <t t-esc="record['semester']"/></h3>
                        <!-- Titre de la filière et du niveau -->
                        <h5>Filière : <t t-esc="record['field_of_study']"/> - Niveau : <t t-esc="record['level']"/></h5>
                        <!-- Tableau des emplois du temps -->
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Date du jour</th>
                                    <th>Matière</th>
                                    <th>Salle</th>
                                    <th>Jour</th>
                                    <th>Heure de Début</th>
                                    <th>Heure de Fin</th>
                                    <th>Enseignant</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="record['timetables']" t-as="timetable">
                                    <tr>
                                        <td><t t-esc="timetable['date']"/></td>
                                        <td><t t-esc="timetable['subject_name']"/></td>
                                        <td><t t-esc="timetable['classroom_name']"/></td>
                                        <td><t t-esc="timetable['day_of_week']"/></td>
                                        <td><t t-esc="timetable['start_time']"/></td>
                                        <td><t t-esc="timetable['end_time']"/></td>
                                        <td><t t-esc="timetable['teacher_name']"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <!-- Saut de page après chaque enregistrement -->
                        <div style="page-break-after: always;"></div>
                    </t>
                </t>
                <t t-else="">
                    <div>Aucune donnée d'emploi du temps disponible. Veuillez vérifier vos filtres.</div>
                </t>
            </div>
        </t>
    </template>
</odoo>
