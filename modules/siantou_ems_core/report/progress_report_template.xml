<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Template du rapport PDF -->
        <template id="template_report_progress_report">
            <t t-call="web.html_container">
                <t t-if="docdata and docdata['report_data']">
                    <t t-call="web.external_layout">
                        <style>
                            .table {
                                border-collapse: collapse;
                                width: 100%;
                            }
                            .table .thead th, .table td {
                                border: 1px solid black;
                                padding: 8px;
                                text-align: center;
                            }
                            .table .thead th {
                                background-color: #f2f2f2;
                            }
                        </style>
                        <t t-set="reports" t-value="docdata['report_data']"/>
                        <t t-foreach="reports" t-as="report">
                            <div class="page">
                                <table class="table table-bordered table-sm text-center">
                                    <thead>
                                        <tr>
                                            <th class="text-center" colspan="5" style="box-shadow: inset 0 0 0 9999px transparent; border-style: hidden;">
                                                <h3>INSTITUT UNIVERSITAIRE SIANTOU</h3>
                                                <h4>
                                                    <span t-esc="'Liste des fiches de progression'"/>
                                                </h4>
                                                <h5 class="text-left">
                                                    <span t-esc="'Filtre :'"/>
                                                    <span t-esc="docdata['filter'] or 'Non spécifié'"/>
                                                </h5>
                                            </th>
                                        </tr>
                                    </thead>
                                    <thead>
                                        <tr>
                                            <th class="text-left" colspan="5" style="box-shadow: inset 0 0 0 9999px transparent; border-style: hidden;"><br/></th>
                                        </tr>
                                    </thead>
                                    <thead>
                                        <tr>
                                            <th class="text-left">
                                                <span t-esc="report['name']"/>
                                            </th>
                                        </tr>
                                    </thead>
                                    <thead class="thead">
                                        <tr class="active">
                                            <th class="text-center">Séance</th>
                                            <th class="text-center">Description</th>
                                            <th class="text-center">Date</th>
                                            <th class="text-center">Heure de début</th>
                                            <th class="text-center">Heure de fin</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="sessions" t-value="report['sessions']"/>
                                        <t t-foreach="sessions" t-as="session">
                                            <tr>
                                                <td class="text-center">
                                                    <span t-esc="session['name']"/>
                                                </td>
                                                <td class="text-center">
                                                    <span t-esc="session['description']"/>
                                                </td>
                                                <td class="text-center">
                                                    <span t-esc="session['date_of_week']"/>
                                                </td>
                                                <td class="text-center">
                                                    <span t-esc="session['start_time']"/>
                                                </td>
                                                <td class="text-center">
                                                    <span t-esc="session['end_time']"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                            <p style="page-break-after:always;"></p>
                            <br/><br/><br/>
                        </t>
                    </t>
                </t>
                <t t-else="">
                    <div>Aucune donnée d'emploi du temps disponible. Veuillez vérifier vos filtres.</div>
                </t>
            </t>
        </template>

        <record id="paperformat_progress_report" model="report.paperformat">
            <field name="name">Format du diplome</field>
            <field name="default" eval="True"/>
            <field name="format">A2</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">5</field>
            <field name="margin_bottom">15</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="True"/>
            <field name="header_spacing">5</field>
            <field name="dpi">90</field>
        </record>
        <record id="action_report_progress_report" model="ir.actions.report">
            <field name="name">Fiche de progression PDF</field>
            <field name="model">siantou.ems.core.progress.report</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">siantou_ems_core.template_report_progress_report</field>
            <field name="report_file">siantou_ems_core.template_report_progress_report</field>
            <field name="print_report_name">'Fiche de - %s' % (docdata.semester)</field>
            <field name="binding_model_id" eval="False"/>
            <field name="paperformat_id" ref="paperformat_progress_report"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>
