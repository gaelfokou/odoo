<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Template du rapport PDF -->
        <template id="template_report_class_subject">
            <t t-call="web.html_container">
                <t t-if="docdata and docdata['subject_data']">
                    <t t-call="web.basic_layout">
                        <style>
                            .table {
                                border-collapse: collapse;
                                width: 100%;
                            }
                            .table .thead th, .table td {
                                border: 1px solid lightgrey !important;
                                padding: 4px 4px !important;
                                margin: 2px 4px !important;
                                text-align: center;
                                font-size: 12px;
                            }
                            .table .thead th {
                                background-color: #f2f2f2;
                                font-size: 12px;
                            }
                            h3 {
                                font-size: 18px;
                                margin: 2px 4px !important;
                            }
                            h4 {
                                font-size: 16px;
                                margin: 2px 4px !important;
                            }
                            h5 {
                                font-size: 14px;
                                margin: 2px 4px !important;
                            }
                            br {
                                padding: 1px 0px !important;
                                margin: 1px 0px !important;
                            }
                        </style>
                        <t t-set="subject_data" t-value="dict(sorted(docdata['subject_data'].items(), key=lambda item: item[1]['name'] if item[1]['name'] else ''))"/>
                        <t t-set="classes" t-value="subject_data.keys()"/>
                        <t t-foreach="classes" t-as="classe">
                            <div class="page">
                                <table class="table table-bordered table-sm text-center">
                                    <thead>
                                        <tr>
                                            <th class="text-center" colspan="5" style="box-shadow: inset 0 0 0 9999px transparent; border-style: hidden;">
                                                <h3>INSTITUT UNIVERSITAIRE SIANTOU</h3>
                                                <h4>
                                                    <span t-esc="subject_data[classe]['name']"/>
                                                </h4>
                                                <h5 class="text-left">
                                                    <span t-esc="'Filtre :'"/>
                                                    <span t-esc="docdata['filter'] or 'Non spécifié'"/>
                                                </h5>
                                            </th>
                                        </tr>
                                    </thead>
                                    <thead>
                                        <tr>
                                            <th class="text-left" colspan="5" style="box-shadow: inset 0 0 0 9999px transparent; border-style: hidden;"><br/></th>
                                        </tr>
                                    </thead>
                                    <thead class="thead">
                                        <tr class="active">
                                            <th class="text-center">Code</th>
                                            <th class="text-center">Nom du cours</th>
                                            <th class="text-center">Volume horaire</th>
                                            <th class="text-center">Crédit</th>
                                            <th class="text-center">Enseignants</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="semester_data" t-value="dict(sorted(subject_data[classe]['data'].items(), key=lambda item: item[1]['name'] if item[1]['name'] else ''))"/>
                                        <t t-set="semesters" t-value="semester_data.keys()"/>
                                        <t t-foreach="semesters" t-as="semester">
                                            <tr>
                                                <td class="text-center" style="background-color: #f2f2f2;"></td>
                                                <td class="text-center" style="background-color: #f2f2f2;">
                                                    <span t-esc="semester_data[semester]['name']"/>
                                                </td>
                                                <td class="text-center" style="background-color: #f2f2f2;"></td>
                                                <td class="text-center" style="background-color: #f2f2f2;"></td>
                                                <td class="text-center" style="background-color: #f2f2f2;"></td>
                                            </tr>
                                            <t t-set="ues" t-value="semester_data[semester]['data'].keys()"/>
                                            <t t-foreach="ues" t-as="ue">
                                                <tr>
                                                    <td class="text-center" style="background-color: #f2f2f2;">
                                                        <span t-esc="semester_data[semester]['data'][ue]['code']"/>
                                                    </td>
                                                    <td class="text-left" style="background-color: #f2f2f2;">
                                                        <span t-esc="semester_data[semester]['data'][ue]['name']"/>
                                                    </td>
                                                    <td class="text-center" style="background-color: #f2f2f2;"></td>
                                                    <td class="text-center" style="background-color: #f2f2f2;"></td>
                                                    <td class="text-center" style="background-color: #f2f2f2;"></td>
                                                </tr>
                                                <t t-foreach="semester_data[semester]['data'][ue]['data']" t-as="subject">
                                                    <t t-set="employees" t-value="list(map(lambda rec: rec['identifier'] + ' - ' + rec['name'], subject['employees']))"/>
                                                    <tr>
                                                        <td class="text-center">
                                                            <span t-esc="subject['code']"/>
                                                        </td>
                                                        <td class="text-left">
                                                            <span t-esc="subject['name']"/>
                                                        </td>
                                                        <td class="text-center">
                                                            <span t-esc="subject['hours_credit']"/>
                                                        </td>
                                                        <td class="text-center">
                                                            <span t-esc="subject['total_credit']"/>
                                                        </td>
                                                        <td class="text-center">
                                                            <t t-set="n" t-value="len(employees)"/>
                                                            <t t-set="i" t-value="1"/>
                                                            <t t-foreach="employees" t-as="employee">
                                                                <span t-esc="employee"/>
                                                                <t t-if="i &lt; n">
                                                                    <br/>
                                                                    <t t-set="i" t-value="i+1"/>
                                                                </t>
                                                            </t>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </t>
                                            <tr>
                                                <td class="text-center" style="background-color: #f2f2f2;">TOTAL SEMESTRIEL</td>
                                                <td class="text-center" style="background-color: #f2f2f2;"></td>
                                                <td class="text-center" style="background-color: #f2f2f2;">
                                                    <span t-esc="semester_data[semester]['hours_credit']"/>
                                                </td>
                                                <td class="text-center" style="background-color: #f2f2f2;">
                                                    <span t-esc="semester_data[semester]['total_credit']"/>
                                                </td>
                                                <td class="text-center" style="background-color: #f2f2f2;"></td>
                                            </tr>
                                        </t>
                                        <tr>
                                            <td class="text-center" style="background-color: #f2f2f2;">TOTAL ANNUEL</td>
                                            <td class="text-center" style="background-color: #f2f2f2;"></td>
                                            <td class="text-center" style="background-color: #f2f2f2;">
                                                <span t-esc="subject_data[classe]['hours_credit']"/>
                                            </td>
                                            <td class="text-center" style="background-color: #f2f2f2;">
                                                <span t-esc="subject_data[classe]['total_credit']"/>
                                            </td>
                                            <td class="text-center" style="background-color: #f2f2f2;"></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <p style="page-break-after:always;"></p>
                            <br/><br/><br/>
                        </t>
                    </t>
                </t>
                <t t-else="">
                    <div>Aucune donnée d'emploi du temps disponible. Veuillez vérifier vos filtres.</div>
                </t>
            </t>
        </template>

        <record id="paperformat_class_subject" model="report.paperformat">
            <field name="name">Format du diplome</field>
            <field name="default" eval="True"/>
            <field name="format">A2</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">5</field>
            <field name="margin_bottom">15</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="True"/>
            <field name="header_spacing">5</field>
            <field name="dpi">90</field>
        </record>
        <record id="action_report_class_subject" model="ir.actions.report">
            <field name="name">Cours PDF</field>
            <field name="model">siantou.ems.core.class</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">siantou_ems_core.template_report_class_subject</field>
            <field name="report_file">siantou_ems_core.template_report_class_subject</field>
            <field name="print_report_name">'Fiche de - %s' % (docdata.semester)</field>
            <field name="binding_model_id" eval="False"/>
            <field name="paperformat_id" ref="paperformat_class_subject"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>
