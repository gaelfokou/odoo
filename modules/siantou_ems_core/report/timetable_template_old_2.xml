<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_timetable" model="report.paperformat">
        <field name="name">Format du diplome</field>
        <field name="default" eval="True"/>
        <field name="orientation">Landscape</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="True"/>
        <field name="header_spacing">5</field>
        <field name="dpi">90</field>
    </record>
    <record id="action_report_timetable" model="ir.actions.report">
        <field name="name">Emploi du temps PDF</field>
        <field name="model">siantou.ems.timetable.timetable</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">siantou_ems_core.report_timetable</field>
        <field name="report_file">siantou_ems_core.report_timetable</field>
        <field name="print_report_name">'Fiche de - %s' % (docdata.semester)</field>
        <field name="binding_model_id" eval="False"/>
        <field name="paperformat_id" ref="paperformat_timetable"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Template du rapport -->
    <template id="report_timetable">
        <t t-call="web.basic_layout">
            <div class="page">
                <style>
                    @page {
                        size: A4 landscape; /* définit la taille du papier en paysage */
                        margin: 1cm; /* ajustez les marges selon vos besoins */
                    }
                    /* Autres styles ici */
                </style>
                <t t-if="docdata and docdata['timetable_data']">
                    <t t-foreach="docdata['timetable_data']" t-as="record">
                        <h1 style="text-align: center;">INSTITUT UNIVERSITAIRE SIANTOU</h1>
                        <h3 style="text-align: center;">Emploi du temps <t t-esc="record['semester']"/></h3>
                        <h5>Département : <t t-esc="record['departement']"/> - Filière : <t t-esc="record['field_of_study']"/> - Niveau : <t t-esc="record['level']"/> - <t t-esc="record['batch']"/></h5>
                        <h5>Periode : <t t-esc="record['week_number']"/></h5>

                        <!-- Tableau des emplois du temps sous forme d'horaire -->
                        <style>
                            .table {
                                border-collapse: collapse;
                                width: 100%;
                            }
                            .table th, .table td {
                                border: 1px solid black;
                                padding: 8px;
                                text-align: center;
                            }
                            .table th {
                                background-color: #f2f2f2;
                            }
                        </style>

                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Heure</th>
                                    <t t-set="days_of_week" t-value="['Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi']"/>
                                    <t t-foreach="days_of_week" t-as="day">
                                        <th><t t-esc="day"/></th>
                                    </t>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="['07:30-09:30', '09:30-11:30', '11:30-12:30', '12:30-14:30', '14:30-16:30']" t-as="horaire">
                                    <tr>
                                        <td><t t-esc="horaire"/></td>
                                        <t t-foreach="days_of_week" t-as="day" t-index="day_index">
                                            <td>
                                                <t t-set="is_occupied" t-value="False"/>
                                                <t t-foreach="record['timetables']" t-as="timetable">
                                                    <t t-if="str(timetable['day_of_week_number']) == str(day_index) and timetable['start_time'][:5] == horaire[:5]">
                                                        <t t-set="is_occupied" t-value="True"/>
                                                        <div>
                                                            <strong><t t-esc="timetable['subject_name']"/> (<t t-esc="timetable['subject_code']"/>)</strong><br/>
                                                            <t t-esc="timetable['classroom_name']"/> / <t t-esc="timetable['building_name']"/><br/>
                                                            <t t-esc="timetable['teacher_name']"/>
                                                        </div>
                                                    </t>
                                                </t>
                                                <t t-if="not is_occupied">
                                                    <!-- <div>Aucun cours</div> -->
                                                </t>
                                            </td>
                                        </t>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <!-- Saut de page après chaque tableau d'emploi du temps -->
                        <div style="page-break-after: always;"></div>
                    </t>
                </t>
                <t t-else="">
                    <div>Aucune donnée d'emploi du temps disponible. Veuillez vérifier vos filtres.</div>
                </t>
            </div>
        </t>
    </template>
</odoo>
