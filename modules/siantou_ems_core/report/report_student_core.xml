<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_fee_payment" model="report.paperformat">
        <field name="name">Format du diplome</field>
        <field name="default" eval="True" />
        <field name="orientation">Landscape</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="True" />
        <field name="header_spacing">5</field>
        <field name="dpi">90</field>
    </record>
    <record id="action_report_student_core_pdf" model="ir.actions.report">
        <field name="name">Paiement PDF</field>
        <field name="model">oe.school.student.enrollment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">siantou_ems_core.report_student_core_pdf_template</field>
        <field name="report_file">siantou_ems_core.report_student_core_pdf_template</field>
        <field name="print_report_name">f"Paiement de - {student['name']}" </field>
        <!-- <field name="print_report_name">'Paiement de - %s' % (data.student)</field> -->
        <!-- <field name="binding_model_id" eval="'False'"/> -->
        <!-- <field name="paperformat_id" ref="paperformat_fee_payment" /> -->
        <!-- <field name="binding_type">report</field> -->
    </record>

    <template id="report_student_core_pdf_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="container">
                        <table classe="table table-striped"
                                        style="width: 100%;">
                            <tbody>
                                <tr>
                                    <td style="border: none;padding: 4px;text-align: left; width:50%">
                                        INSTITUT UNIVERSITE SIANTOU <br/>
                                        ECOLE SUPERIEUR DE MANAGEMENT, <br/>
                                        DE GESTION ET DE <br/>
                                        <small>
                                            B.P. : 04 Yaoundé Cameroun <br/>
                                            Tél : 22-30-62-71 <br/>
                                            Fax :
                                        </small>
                                    </td>
                                    <td style="border: none;padding: 4px; text-align: right; width:50%">
                                        <span>Yaoundé, le <span t-esc="date"
                                        t-options='{"widget": "date","format": "d/MM/Y"}' /></span>
                                    </td>
                                </tr>
                                <tr style="border: none;">
                                    <td colspan="4"
                                        style="text-align: center; border: none;padding: 4px">
                                        <img src="siantou_ems_core/static/src/img/logo.png" 
                                            alt="logo"
                                            style="width: 100px; height: 100px;"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <center>
                            <h2 style="text-decoration:underline">
                                RECU DE CAISSE SCOLARITE N° <span t-esc="payment_id['name']" /> 
                                DU <span t-esc="date"
                                        t-options='{"widget": "date","format": "d/MM/Y"}' />
                            </h2>
                            <h4>
                                Année académique :
                                <span t-esc="payment_id['year']" />
                            </h4>
                        </center>

                        <div class="row">
                            <div class="col-sm-12">
                                <br/>
                                <h3>I. Identification de l'étudiant</h3>
                                <table classe="table table-striped"
                                                style="width: 100%;">
                                    <tbody>
                                        <tr>
                                            <td style="border: none;padding: 4px;text-align: left">
                                                <b>Nom(s) et prénom(s) :</b>
                                                <span t-esc="student['name']" />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="border: none;padding: 4px;text-align: left">
                                                <b>Matricule :</b>
                                                <span t-esc="student['matricule']" />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="border: none;padding: 4px;text-align: left">
                                                <b>Filière :</b>
                                                <span t-esc="student['field_of_study']" />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="border: none;padding: 4px;text-align: left">
                                                <b>Niveau académique :</b>
                                                <span t-esc="student['level']" />
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-12">
                                <table classe="table table-striped"
                                    style="width: 100%;">
                                    <thead>
                                        <tr
                                            style="border: 1px solid black;text-align: left;">
                                            <th style="border: 1px solid black;text-align: left;padding: 4px; width: 50%">Libellé</th>
                                            <th style="border: 1px solid black;text-align: left;padding: 4px; width: 25%">PERÇUE</th>
                                            <th style="border: 1px solid black;text-align: left;padding: 4px; width: 25%">Date de paiement</th>
                                            <!-- <th style="border: 1px solid black;padding: 4px">Reste
                                                à payer</th> -->
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr style="border: 1px solid black">
                                            <td style="border: 1px solid black;padding: 4px">
                                                <t t-esc="facture.get('name')" />
                                            </td>
                                            <td style="border: 1px solid black;padding: 4px;">
                                                <t
                                                    t-esc="'{0:,.0f}'.format(int(facture.get('amount'))).replace(',', ' ')" /> FCFA
                                            </td>
                                            <td style="border: 1px solid black;padding: 4px">
                                                <t t-esc="facture.get('date_payment')" t-options='{"widget": "date","format": "d/MM/Y"}' />
                                            </td>
                                        </tr>
                                        <tr style="border: 1px solid black; background-color:floralwhite">
                                            <td colspan="4"
                                                style="text-align: center; border: 1px solid black;padding: 4px">
                                                <h4><b>Montant total versé : <t
                                                        t-esc="'{0:,.0f}'.format(int(facture.get('amount'))).replace(',', ' ')" />
                                                    FCFA</b></h4>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="row mt-3 mb-3">
                            <div class="col-12 text-center">
                                <h5> Arrête la présente facture à la somme de : <strong><span t-esc="'{0:,.0f}'.format(int(facture.get('amount'))).replace(',', ' ')"/> FCFA</strong>
                                    au titre de l'année académique <span t-esc="payment_id['year']" />
                                </h5>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                <h3>II. Nos coordonnées bancaires</h3>
                                <table
                                    style="width: 100%;border-collapse: collapse;font-size:12px">
                                    <thead>
                                        <tr style="border: 1px solid black;padding: 4px">
                                            <th style="text-align: center;border: 1px solid black;padding: 4px"
                                                scope="col" colspan="6">Paiement nationaux</th>
                                            <th style="text-align: center;border: 1px solid black;padding: 4px"
                                                scope="col" colspan="2">Paiement internationaux</th>
                                        </tr>
                                        <tr style="border: 1px solid black;padding: 4px">
                                            <th style="text-align: center;border: 1px solid black;padding: 4px"
                                                scope="col">Dénomination</th>
                                            <th style="text-align: center;border: 1px solid black;padding: 4px"
                                                scope="col">Banque</th>
                                            <th style="text-align: center;border: 1px solid black;padding: 4px"
                                                scope="col">CIIE DNDLE</th>
                                            <th style="text-align: center;border: 1px solid black;padding: 4px"
                                                scope="col">TTE OU</th>
                                            <th style="text-align: center;border: 1px solid black;padding: 4px"
                                                scope="col">Numéro de compte</th>
                                            <th style="text-align: center;border: 1px solid black;padding: 4px"
                                                scope="col">Clé RIB</th>
                                            <th style="text-align: center;border: 1px solid black;padding: 4px"
                                                scope="col">Swift code</th>
                                            <th style="text-align: center;border: 1px solid black;padding:
                                            4px" scope="col" >IBAN</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td style="border: 1px solid black;padding: 4px"
                                                rowspan="3">Université siantou supérieur</td>
                                            <td style="border: 1px solid black;padding: 4px">AFRILAND
                                                FIRST BANK</td>
                                            <td style="border: 1px solid black;padding: 4px">
                                                10005</td>
                                            <td style="border: 1px solid black;padding: 4px">
                                                00001</td>
                                            <td style="border: 1px solid black;padding: 4px">
                                                02853381001</td>
                                            <td style="border: 1px solid black;padding: 4px">
                                                06</td>
                                            <td style="border: 1px solid black;padding: 4px">
                                                ICLRCMCXXXX</td>
                                            <td style="border: 1px solid black;padding:
                                            4px" >CM21 10005 00001 02853381001-06</td>
                                        </tr>
                                        <!-- <tr>
                                            <td style="border: 1px solid black;padding: 4px">
                                                UBA</td>
                                            <td style="border: 1px solid black;padding: 4px">
                                                10033</td>
                                            <td style="border: 1px solid black;padding: 4px">
                                                05218</td>
                                            <td style="border: 1px solid black;padding: 4px">
                                                18031000020</td>
                                            <td style="border: 1px solid black;padding: 4px">
                                                12</td>
                                            <td style="border: 1px solid black;padding: 4px">
                                                UNAFCMCX</td>
                                            <td style="border: 1px solid black;padding:
                                            4px" >CM21 10033 05218 18031000020-12</td>
                                        </tr> -->
                                        <!-- <tr>
                                            <td style="border: 1px solid black;padding: 4px">
                                                BICEC</td>
                                            <td style="border: 1px solid black;padding: 4px">
                                                10001</td>
                                            <td style="border: 1px solid black;padding: 4px">
                                                06862</td>
                                            <td style="border: 1px solid black;padding: 4px">
                                                51856862001</td>
                                            <td style="border: 1px solid black;padding: 4px">
                                                42</td>
                                            <td style="border: 1px solid black;padding: 4px">
                                                CCEICMCX</td>
                                            <td style="border: 1px solid black;padding:
                                            4px" >CM21 10001 06862 51856862001-42</td>
                                        </tr> -->
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>