<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_fee_payment" model="report.paperformat">
        <field name="name">Format-Paiement-inscription-étudiant</field>
        <field name="default" eval="True"/>
        <field name="format">custom</field>
        <field name="page_height">210</field>
        <field name="page_width">148</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">4</field>
        <field name="margin_right">4</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">5</field>
        <field name="dpi">150</field>
    </record>
    <record id="action_report_student_core_pdf" model="ir.actions.report">
        <field name="name">Paiement-inscription-étudiant</field>
        <field name="model">oe.school.student.enrollment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">siantou_ems_core.report_student_core_pdf_template</field>
        <field name="report_file">siantou_ems_core.report_student_core_pdf_template</field>
        <field name="print_report_name">f"Paiement de - {student['name']}" </field>
        <!-- <field name="print_report_name">'Paiement de - %s' % (data.student)</field> -->
        <!-- <field name="binding_model_id" eval="'False'"/> -->
        <field name="paperformat_id" ref="paperformat_fee_payment"/>
        <!-- <field name="binding_type">report</field> -->
    </record>

    <template id="report_student_core_pdf_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div style="margin-top: 0px;">
                    <div class="container">
                        <table classe="table table-striped"
                                        style="width: 100%;">
                            <tbody>
                                <tr >
                                    <td style="border: none;padding: 4px;text-align: center; width:40%;font-size: 15px;">
                                        INSTITUT UNIVERSITAIRE SIANTOU <br/>
                                        ECOLE SUPERIEUR DE MANAGEMENT, <br/>
                                        DE GESTION ET DE <br/>
                                        <small>
                                            B.P. : 04 Yaoundé Cameroun <br/>
                                            Tél : 22-30-62-71 <br/>
                                            Fax :
                                        </small>
                                    </td>
                                    <td style="border: none;padding: 4px;text-align: center; width:40%;height: auto;font-size: 15px;">
                                        <div style="height: 100%;width: 100%;font-size: 15px;position:relative">
                                            <img src="siantou_ems_fee/static/src/img/logo.png" 
                                                alt="logo"
                                                style="width: 140px; height: 140px;position: fixed; top: 70px; left: 40%; right:0;z-index: -1;opacity:0.8"/>
                                        </div>
                                    </td>
                                    <td style="border: none;padding: 4px; text-align: center; width:40%;font-size: 15px;">
                                        SIANTOU UNIVERSITY INSTITUTE <br/>
                                        MANAGEMENT SCHOOL, <br/>
                                        AND MANAGEMENT <br/>
                                        <small>
                                            B.P. : 04 Yaounde Cameroon <br/>
                                            Phone : 22-30-62-71 <br/>
                                            Fax :
                                        </small>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <center>
                            <h2 style="text-decoration:underline;font-size: 15px;margin-top:25px">
                                RECU DE CAISSE SCOLARITE N° <span t-esc="payment_id['name']"/> 
                                DU <span t-esc="date"
                                        t-options='{"widget": "date","format": "d/MM/Y"}' />
                            </h2>
                            <h4 style="font-size: 12px;margin-top:15px">
                                Année académique :
                                <span t-esc="payment_id['year']"/>
                            </h4>
                        </center>

                        <div class="row">
                            <div class="col-sm-12">
                                <br/>
                                <h3 style="text-decoration:underline;text-transform:uppercase;font-size: 15px;">I. Identification de l'étudiant</h3>
                                <table classe="table table-striped"
                                                style="width: 100%;">
                                    <thead>
                                        <tr
                                            style="border: 1px solid black;text-align: left;font-size: 12px;">
                                            <th style="border: 1px solid black;text-align: left;padding: 4px; width: 25%;text-transform:uppercase;">
                                                Nom(s) et prénom(s)
                                            </th>
                                            <th style="border: 1px solid black;text-align: left;padding: 4px; width: 25%;text-transform:uppercase;">
                                                Code d'enroulement
                                            </th>
                                            <th style="border: 1px solid black;text-align: left;padding: 4px; width: 25%;text-transform:uppercase;">
                                                Filière
                                            </th>
                                            <th style="border: 1px solid black;text-align: left;padding: 4px; width: 25%;text-transform:uppercase;">
                                                Niveau académique
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td style="border: 1px solid black;padding: 4px;text-align: left;font-size: 12px;">
                                                <span t-esc="student['name']"/>
                                            </td>
                                            <td style="border: 1px solid black;padding: 4px;text-align: left;font-size: 12px;">
                                                <span t-esc="student['code_enrol']"/>
                                            </td>
                                            <td style="border: 1px solid black;padding: 4px;text-align: left;font-size: 12px;">
                                                <span t-esc="student['field_of_study']"/>
                                            </td>
                                            <td style="border: 1px solid black;padding: 4px;text-align: left;font-size: 12px;">
                                                <span t-esc="student['level']"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <h3 style="text-decoration:underline;text-transform:uppercase;margin:15px 0px;font-size: 15px;">II. Information du paiement</h3>
                            <div class="col-12">
                                <table classe="table table-striped"
                                    style="width: 100%;">
                                    <thead>
                                        <tr
                                            style="border: 1px solid black;text-align: left;font-size: 12px;">
                                            <th style="border: 1px solid black;text-align: left;padding: 4px; width: 50%;text-transform:uppercase;">Libellé</th>
                                            <th style="border: 1px solid black;text-align: left;padding: 4px; width: 25%;text-transform:uppercase;">PERÇUE</th>
                                            <th style="border: 1px solid black;text-align: left;padding: 4px; width: 25%;text-transform:uppercase;">Date de paiement</th>
                                            <!-- <th style="border: 1px solid black;padding: 4px">Reste
                                                à payer</th> -->
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr style="border: 1px solid black;font-size: 12px;">
                                            <td style="border: 1px solid black;padding: 4px;font-size: 12px;">
                                                <t t-esc="facture.get('name')"/>
                                            </td>
                                            <td style="border: 1px solid black;padding: 4px;font-size: 12px;">
                                                <t
                                                    t-esc="'{0:,.0f}'.format(int(facture.get('amount'))).replace(',', ' ')"/> FCFA
                                            </td>
                                            <td style="border: 1px solid black;padding: 4px;font-size: 12px;">
                                                <t t-esc="facture.get('date_payment')" t-options='{"widget": "date","format": "d/MM/Y"}' />
                                            </td>
                                        </tr>
                                        <tr style="border: 1px solid black; background-color:floralwhite;font-size: 12px;">
                                            <td colspan="4"
                                                style="text-align: center; border: 1px solid black;padding: 4px;font-size: 12px;">
                                                <h4 style="text-align: center; padding: 4px;font-size: 12px;text-transform:uppercase;">
                                                    <b>Montant total versé : <t
                                                        t-esc="'{0:,.0f}'.format(int(facture.get('amount'))).replace(',', ' ')"/>
                                                    FCFA</b>
                                                </h4>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="row mt-3 mb-3">
                            <div class="col-12 text-center">
                                <h5 style="font-size: 12px;"> Arrête la présente facture à la somme de : <strong><span t-esc="'{0:,.0f}'.format(int(facture.get('amount'))).replace(',', ' ')"/> FCFA</strong>
                                    au titre de l'année académique <span t-esc="payment_id['year']"/>
                                </h5>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>