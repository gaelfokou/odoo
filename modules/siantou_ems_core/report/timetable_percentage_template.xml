<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Template du rapport PDF -->
        <template id="template_report_timetable_percentage">
            <t t-call="web.html_container">
                <t t-if="docdata and docdata['timetable_percentage_data']">
                    <t t-call="web.external_layout">
                        <style>
                            .table {
                                border-collapse: collapse;
                                width: 100%;
                            }
                            .table .thead th, .table td {
                                border: 1px solid inherit !important;
                                padding: 2px 4px !important;
                                margin: 2px 4px !important;
                                text-align: center;
                                font-size: 12px;
                            }
                            .table .thead th {
                                background-color: #f2f2f2;
                                font-size: 12px;
                            }
                            h3 {
                                font-size: 16px;
                                margin: 2px 4px !important;
                            }
                            h4 {
                                font-size: 14px;
                                margin: 2px 4px !important;
                            }
                            br {
                                padding: 1px 0px !important;
                                margin: 1px 0px !important;
                            }
                        </style>
                        <div class="page">
                            <table class="table table-bordered table-sm text-center">
                                <thead>
                                    <tr>
                                        <th class="text-center" colspan="11" style="box-shadow: inset 0 0 0 9999px transparent; border-style: hidden;">
                                            <h3>INSTITUT UNIVERSITAIRE SIANTOU</h3>
                                            <h4>
                                                <span t-esc="'Liste des emplois du temps'"/>
                                            </h4>
                                            <h5 class="text-left">
                                                <span t-esc="'Filtre :'"/>
                                                <span t-esc="docdata['filter'] or 'Non spécifié'"/>
                                            </h5>
                                        </th>
                                    </tr>
                                </thead>
                                <thead>
                                    <tr>
                                        <th class="text-left" colspan="11" style="box-shadow: inset 0 0 0 9999px transparent; border-style: hidden;"><br/></th>
                                    </tr>
                                </thead>
                                <thead class="thead">
                                    <tr class="active">
                                        <th class="text-center">Matricule</th>
                                        <th class="text-center">Enseignant</th>
                                        <th class="text-center">Classe</th>
                                        <th class="text-center">Cours</th>
                                        <th class="text-center">Date</th>
                                        <th class="text-center">Heure de début</th>
                                        <th class="text-center">Heure de fin</th>
                                        <th class="text-center">Satut</th>
                                        <th class="text-center">Motif</th>
                                        <th class="text-center">Heure de début effectuée</th>
                                        <th class="text-center">Heure de fin effectuée</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="timetable_percentage_data" t-value="dict(sorted(docdata['timetable_percentage_data'].items(), key=lambda item: item[1]['name'] if item[1]['name'] else ''))"/>
                                    <t t-set="keys" t-value="timetable_percentage_data.keys()"/>
                                    <t t-foreach="keys" t-as="key">
                                        <t t-set="timetables" t-value="timetable_percentage_data[key]['data']"/>
                                        <t t-foreach="timetables" t-as="timetable">
                                            <tr>
                                                <td class="text-center">
                                                    <span t-esc="timetable['identifier']"/>
                                                </td>
                                                <td class="text-left">
                                                    <span t-esc="timetable['employee_name']"/>
                                                </td>
                                                <td class="text-center">
                                                    <span t-esc="timetable['class_name']"/>
                                                </td>
                                                <td class="text-center">
                                                    <span t-esc="timetable['subject_name']"/>
                                                </td>
                                                <td class="text-center">
                                                    <span t-esc="timetable['date_of_week']"/>
                                                </td>
                                                <td class="text-center">
                                                    <span t-esc="timetable['start_time']"/>
                                                </td>
                                                <td class="text-center">
                                                    <span t-esc="timetable['end_time']"/>
                                                </td>
                                                <td class="text-center">
                                                    <span t-esc="timetable['status']"/>
                                                </td>
                                                <td class="text-center">
                                                    <span t-esc="timetable['reason']"/>
                                                </td>
                                                <td class="text-center">
                                                    <span t-esc="timetable['worked_start_time']"/>
                                                </td>
                                                <td class="text-center">
                                                    <span t-esc="timetable['worked_end_time']"/>
                                                </td>
                                            </tr>
                                        </t>
                                        <tr>
                                            <td class="text-center">POURCENTAGE</td>
                                            <td class="text-center">
                                                <span t-esc="str(timetable_percentage_data[key]['percentage']) + '%'"/>
                                            </td>
                                            <td class="text-center"></td>
                                            <td class="text-center"></td>
                                            <td class="text-center"></td>
                                            <td class="text-center"></td>
                                            <td class="text-center"></td>
                                            <td class="text-center"></td>
                                            <td class="text-center"></td>
                                            <td class="text-center"></td>
                                            <td class="text-center"></td>
                                        </tr>
                                    </t>
                                    <tr>
                                        <td class="text-center">POURCENTAGE GLOBAL</td>
                                        <td class="text-center">
                                            <span t-esc="str(docdata['total_percentage']) + '%'"/>
                                        </td>
                                        <td class="text-center"></td>
                                        <td class="text-center"></td>
                                        <td class="text-center"></td>
                                        <td class="text-center"></td>
                                        <td class="text-center"></td>
                                        <td class="text-center"></td>
                                        <td class="text-center"></td>
                                        <td class="text-center"></td>
                                        <td class="text-center"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </t>
                </t>
                <t t-else="">
                    <div>Aucune donnée d'emploi du temps disponible. Veuillez vérifier vos filtres.</div>
                </t>
            </t>
        </template>

        <record id="paperformat_timetable_percentage" model="report.paperformat">
            <field name="name">Format du diplome</field>
            <field name="default" eval="True"/>
            <field name="format">A2</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">5</field>
            <field name="margin_bottom">15</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="True"/>
            <field name="header_spacing">5</field>
            <field name="dpi">90</field>
        </record>
        <record id="action_report_timetable_percentage" model="ir.actions.report">
            <field name="name">Emploi du temps PDF</field>
            <field name="model">teacher.timetable.attendance</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">siantou_ems_core.template_report_timetable_percentage</field>
            <field name="report_file">siantou_ems_core.template_report_timetable_percentage</field>
            <field name="print_report_name">'Fiche de - %s' % (docdata.semester)</field>
            <field name="binding_model_id" eval="False"/>
            <field name="paperformat_id" ref="paperformat_timetable_percentage"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>
