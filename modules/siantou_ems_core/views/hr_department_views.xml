<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_department_form_inherit" model="ir.ui.view">
            <field name="name">hr.department.form</field>
            <field name="model">hr.department</field>
            <field name="inherit_id" ref="hr.view_department_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="attributes">
                    <attribute name="readonly">0</attribute>
                </xpath>
                <xpath expr="//field[@name='color']" position="attributes">
                    <attribute name="string">Couleur</attribute>
                </xpath>
                <xpath expr="//group[1]/group[1]" position="inside">
                    <field name="department_name"/>
                    <field name="code"/>
                    <field name="school_id" options="{'no_create': True}"/>
                    <!-- <field name="cycle_id" options="{'no_create': True}"/> -->
                </xpath>
                <xpath expr="//group[1]" position="inside">
                    <group>
                        <field name="specialty_ids" options="{'no_create': True}" domain="[('school_id', '=', school_id)]" widget="one2many_list">
                            <tree create="0" editable="bottom">
                                <field name="code"/>
                                <field name="name"/>
                                <field name="field_of_study_id"/>
                            </tree>
                        </field>
                    </group>
                </xpath>
            </field>
        </record>

        <record id="view_department_tree_inherit" model="ir.ui.view">
            <field name="name">hr.department.tree</field>
            <field name="model">hr.department</field>
            <field name="inherit_id" ref="hr.view_department_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="before">
                    <field name="code"/>
                </xpath>
                <xpath expr="//field[@name='name']" position="after">
                    <field name="school_id"/>
                </xpath>
            </field>
        </record>

        <record id="hr_department_view_kanban_inherit" model="ir.ui.view" >
            <field name="name">hr.department.kanban</field>
            <field name="model">hr.department</field>
            <field name="inherit_id" ref="hr.hr_department_view_kanban"/>
            <field name="arch" type="xml">
                <xpath expr='//kanban/templates/t[2]/div/div/div/div/a' position="replace">
                    <a type="edit"><field name="name"/></a>
                </xpath>
            </field>
        </record>

        <!-- Menu pour la gestion des départements -->
        <menuitem
                id="menu_siantou_ems_core_program_department"
                name="Départements"
                parent="menu_siantou_ems_core_config_fa"
                action="hr.hr_department_kanban_action"
                groups="siantou_ems_core.group_field_of_study_admin,base.group_system"
            sequence="1"/>
    </data>
</odoo>
