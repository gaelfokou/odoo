<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		<!-- Affichage en vue liste -->
		<record
                id="unite_enseignement_tree_view"
                model="ir.ui.view">
            <field name="name">unite_enseignement.tree.view</field>
			<field name="model">siantou.ems.core.unite.enseignement</field>
			<field name="arch" type="xml">
				<tree string="Unité d'enseignement">
                    <!-- <header>
                        <button name="action_update_semester" 
                                type="object" 
                                string="Mettre à jour les semestres" 
                                class="oe_highlight" 
                                display="always"/>
                    </header> -->
                    <field name="code"/>
                    <field name="name"/>
                    <field name="total_credit"/>
                    <field name="semester_ids" widget="many2many_tags"/>
                    <field name="type_ue"/>
				</tree>
			</field>
		</record>

        <!-- Affichage en vue formulaire -->
		<record
                id="unite_enseignement_form_view"
                model="ir.ui.view">
			<field name="name">unite_enseignement.form.view</field>
			<field name="model">siantou.ems.core.unite.enseignement</field>
			<field name="arch" type="xml">
				<form string="Unité d'enseignement">
					<sheet>
                        <group col="4">
                            <group colspan="2">
                                <field name="code"/>
                                <field name="name"/>
                                <field name="total_credit"/>
                            </group>
                            <group colspan="2">
                                <field name="semester_ids" widget="many2many_tags"/>
                                <field name="class_id_domain" invisible="1"/>
                                <field name="class_ids" domain="class_id_domain" widget="many2many_tags"/>
                                <field name="type_ue"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="subject_ids" string="Cours">
                                <field name="subject_ids">
                                    <tree editable="bottom">
                                        <field name="code"/>
                                        <field name="name"/>
                                        <field name="hours_credit"/>
                                        <field name="total_credit"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
					</sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
				</form>
			</field>
		</record>

        <!-- Affichage en vue recherche -->
         <record
                 id="unite_enseignement_search_view"
                 model="ir.ui.view">
            <field name="name">unite_enseignement.search.view</field>
            <field name="model">siantou.ems.core.unite.enseignement</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                </search>
             </field>
        </record>

        <!-- Action pour le menu d'affichage des syllabus -->
        <record id="action_show_unite_enseignement" model="ir.actions.act_window">
            <field name="name">Unités d'enseignement</field>
            <field name="res_model">siantou.ems.core.unite.enseignement</field>
            <field name="search_view_id" ref="unite_enseignement_search_view"/>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('year_id.active_user_ids', '=', uid)]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer une unité d'enseignement.
                </p>
            </field>
        </record>

        <record id="action_show_unite_enseignement_2" model="ir.actions.act_window">
            <field name="name">Unités d'enseignement</field>
            <field name="res_model">siantou.ems.core.unite.enseignement</field>
            <field name="search_view_id" ref="unite_enseignement_search_view"/>
            <field name="view_mode">tree</field>
            <field name="context">{'create': False, 'edit': False}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer une unité d'enseignement.
                </p>
            </field>
        </record>

        <!-- Menu pour les syllabus -->
        <menuitem
                id="menu_siantou_ems_core_unite_enseignement"
                name="Unité d'enseignement"
                parent="menu_siantou_ems_core_config_pe"
                action="action_show_unite_enseignement"
            sequence="2"/>
        <menuitem
                id="menu_siantou_ems_core_unite_enseignement_2"
                name="Unité d'enseignement"
                parent="menu_siantou_ems_core_program"
                action="action_show_unite_enseignement_2"
            sequence="2"/>
	</data>
</odoo>