<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_subject_score_tree" model="ir.ui.view">
            <field name="name">subject.score.tree</field>
            <field name="model">siantou.ems.core.subject.score</field>
            <field name="arch" type="xml">
                <tree string="Notes d'examen">
                    <!-- <field name="name"/> -->
                    <field name="score"/>
                    <field name="note"/>
                    <field name="exam_id"/>
                    <field name="student_id" invisible="exam_type in ['sn', 'rsn'] and status in ['start_write', 'end_write']"/>
                    <field name="anonymous" invisible="exam_type not in ['sn', 'rsn']"/>
                    <field name="exam_type"/>
					<field name="status" widget="badge"
                        decoration-muted="status == 'start'"
                        decoration-primary="status == 'start_write'"
                        decoration-warning="status == 'end_write'"
                        decoration-success="status == 'end'"/>
                </tree>
            </field>
        </record>

        <record id="view_subject_score_form" model="ir.ui.view">
            <field name="name">subject.score.form</field>
            <field name="model">siantou.ems.core.subject.score</field>
            <field name="arch" type="xml">
                <form string="Note d'examen">
                    <sheet>
                        <group colspan="2">
                            <field name="name"/>
                            <field name="score"/>
                            <field name="note"/>
                        </group>
                        <group colspan="2">
                            <field name="exam_id" options="{'no_create': True}"/>
                            <field name="student_id_domain" invisible="1"/>
                            <field name="student_id" invisible="exam_type in ['sn', 'rsn'] and status in ['start_write', 'end_write']" options="{'no_create': True}" domain="student_id_domain"/>
                            <field name="anonymous" invisible="exam_type not in ['sn', 'rsn']"/>
                            <field name="exam_type" widget="radio"/>
                            <field name="status" invisible="1"/>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="action_show_subject_score" model="ir.actions.act_window">
            <field name="name">Notes d'examen</field>
            <field name="res_model">siantou.ems.core.subject.score</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record id="action_show_subject_score_2" model="ir.actions.act_window">
            <field name="name">Notes d'examen</field>
            <field name="res_model">siantou.ems.core.subject.score</field>
            <field name="view_mode">tree</field>
            <field name="context">{'create': False, 'edit': False}</field>
        </record>

        <menuitem id="siantou_menu_subject_score"
                name="Notes d'examen"
                parent="menu_siantou_ems_core_config_pe"
                action="action_show_subject_score"
                groups="siantou_ems_core.group_subject_admin,base.group_system"
            sequence="20"/>
        <menuitem id="siantou_menu_subject_score_2"
                name="Notes d'examen"
                parent="menu_siantou_ems_core_program"
                action="action_show_subject_score_2"
                groups="siantou_ems_core.group_subject_admin,base.group_system"
            sequence="20"/>
    </data>
</odoo>
