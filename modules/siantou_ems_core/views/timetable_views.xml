<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
        <!-- Affichage en vue liste -->
		<record
                id="timetable_tree_view"
                model="ir.ui.view">
            <field name="name">timetable.tree.view</field>
			<field name="model">siantou.ems.timetable.timetable</field>
			<field name="arch" type="xml">
				<tree string="Emplois du temps">
                    <header>
                        <!-- <button name="action_timetable_automatic" 
                            type="object" 
                            string="Génération automatique" 
                            class="oe_highlight" 
                            display="always"/> -->
                        <button name="action_reset_filter" 
                            type="object" 
                            string="Réinitialiser" 
                            class="oe_highlight" 
                            display="always"/>
                        <button name="action_open_filter" 
                            type="object" 
                            string="Filtrer" 
                            class="oe_highlight" 
                            display="always"/>
                        <button name="action_print_pdf" 
                            type="object" 
                            string="Imprimer PDF" 
                            class="oe_highlight" 
                            display="always"/>
                    </header>
                    <field name="group_id"/>
                    <field name="semester_id"/>
                    <field name="year_id"/>
                    <field name="school_id"/>
                    <field name="field_of_study_id"/>
                    <field name="level_id"/>
                    <field name="specialty_id"/>
                    <field name="option_id"/>
                    <field name="class_id"/>
                    <field name="class_group_id"/>
                    <!-- <field name="ue_id"/> -->
					<field name="subject_id"/>
					<field name="building_id"/>
					<field name="classroom_id"/>
					<field name="employee_id"/>
                    <field name="date"/>
					<field name="day_of_week"/>
					<field name="start_time"/>
					<field name="end_time"/>
					<field name="status" widget="badge"
                        decoration-muted="status == 'pending'"
                        decoration-primary="status == 'progress'"
                        decoration-success="status == 'present'"
                        decoration-danger="status == 'absent'"
                        decoration-info="status == 'permission'"
                        decoration-warning="status == 'exception'"/>
				</tree>
			</field>
		</record>

        <!-- Affichage en vue formulaire -->
		<record
                id="timetable_form_view"
                model="ir.ui.view">
			<field name="name">timetable.form.view</field>
			<field name="model">siantou.ems.timetable.timetable</field>
			<field name="arch" type="xml">
				<form string="Emplois du temps">
                    <header>
                        <button name="state_pending_timetable" class="oe_highlight" invisible="state in ['pending']" string="En attente" type="object"/>
                        <button name="state_progress_timetable" class="oe_highlight" invisible="state in ['progress']" string="En cours" type="object"/>
                        <button name="state_present_timetable" class="oe_highlight" invisible="state in ['present']" string="Présent" type="object"/>
                        <button name="state_absent_timetable" class="oe_highlight" invisible="state in ['absent']" string="Absent" type="object"/>
                        <button name="state_permission_timetable" class="oe_highlight" invisible="state in ['permission']" string="Permissionnaire" type="object"/>
                        <button name="state_exception_timetable" class="oe_highlight" invisible="state in ['exception']" string="Exception" type="object"/>
                        <field name="state" widget="statusbar" statusbar_visible="pending,progress,present,absent,permission,exception"/>
                    </header>
					<sheet>
                        <group>
                            <field name="group_id" options="{'no_open': True, 'no_create': True}" domain="[('is_submit', '=', False), ('is_active', '=', True)]"/>
                            <field name="batch_id" invisible="1" options="{'no_create': True}"/>
                            <field name="date" invisible="1"/>
                            <field name="semester_id" readonly="1" options="{'no_open': True, 'no_create': True}"/>
                            <field name="year_id" readonly="1" options="{'no_open': True, 'no_create': True}"/>
                            <field name="school_id" options="{'no_create': True}"/>
                            <field name="field_of_study_id" options="{'no_create': True}" domain="[('school_id', '=', school_id)]"/>
                            <field name="level_id" options="{'no_create': True}" domain="[('semester_ids', '=', semester_id)]"/>
                            <field name="specialty_id_domain" invisible="1"/>
                            <field name="specialty_id" options="{'no_create': True}" domain="specialty_id_domain"/>
                            <field name="option_id" options="{'no_create': True}" domain="[('specialty_id', '=', specialty_id)]"/>
                            <field name="class_id" options="{'no_create': True}" domain="[('field_of_study_id', '=', field_of_study_id), ('specialty_id', '=', specialty_id), ('option_id', '=', option_id), ('level_id', '=', level_id), ('year_id', '=', year_id)]"/>
                            <field name="class_group_id" options="{'no_create': True}" domain="[('class_id', '=', class_id)]"/>
                            <!-- <field name="ue_id" readonly="1" options="{'no_create': True}" domain="[('class_ids', '=', class_id), ('semestre_id', '=', semester_id)]"/> -->
                            <field name="subject_id_domain" invisible="1"/>
                            <field name="subject_id" options="{'no_create': True}" domain="subject_id_domain"/>
                            <field name="building_id" options="{'no_create': True}"/>
                            <field name="classroom_id" options="{'no_create': True}" domain="[('building_id', '=', building_id)]"/>
                            <field name="employee_id" options="{'no_create': True}" domain="[('subject_ids', '=', subject_id)]"/>
                            <field name="date" invisible="id == False or start_time == end_time"/>
        					<field name="day_of_week" invisible="id == False or start_time == end_time"/>
                            <field name="start_time" invisible="id == False or start_time == end_time"/>
                            <field name="end_time" invisible="id == False or start_time == end_time"/>
                            <field name="subject_day_hour_ids" invisible="id != False and start_time != end_time" widget="one2many_list">
                                <tree>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="day_of_week"/>
                                    <field name="start_time"/>
                                    <field name="end_time"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                            <field name="not_active_slotitems" invisible="1"/>
                            <field name="status" invisible="1"/>
                        </group>
					</sheet>
				</form>
			</field>
		</record>

        <record id="timetable_search_view" model="ir.ui.view">
            <field name="name">timetable.search.view</field>
            <field name="model">siantou.ems.timetable.timetable</field>
            <field name="arch" type="xml">
                <search>
                    <field name="group_id"/>
                    <field name="semester_id"/>
                    <field name="year_id"/>
                    <field name="school_id"/>
                    <field name="field_of_study_id"/>
                    <field name="level_id"/>
                    <field name="specialty_id"/>
                    <field name="option_id"/>
                    <field name="class_id"/>
                    <field name="class_group_id"/>
                    <!-- <field name="ue_id"/> -->
					<field name="subject_id"/>
					<field name="building_id"/>
					<field name="classroom_id"/>
					<field name="employee_id"/>
                    <field name="date"/>
					<field name="day_of_week"/>
					<field name="start_time"/>
					<field name="end_time"/>
					<field name="status"/>
                    <filter string="Mon emploi du temps" name="mytimetable" domain="[('employee_id.user_id', '=', uid)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Semestre" name="semester" context="{'group_by': 'semester_id'}"/>
                        <filter string="Année académique" name="year" context="{'group_by': 'year_id'}"/>
                        <filter string="École" name="school" context="{'group_by': 'school_id'}"/>
                        <filter string="Filière" name="field_of_study" context="{'group_by': 'field_of_study_id'}"/>
                        <filter string="Niveau" name="level" context="{'group_by': 'level_id'}"/>
                        <filter string="Classe" name="class" context="{'group_by': 'class_id'}"/>
                        <filter string="Spécialité" name="specialty" context="{'group_by': 'specialty_id'}"/>
                        <filter string="Option" name="option" context="{'group_by': 'option_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action pour le menu d'affichage des années académiques -->
        <record
                id="action_show_timetable"
                model="ir.actions.act_window">
            <field name="name">Emplois du temps</field>
            <field name="res_model">siantou.ems.timetable.timetable</field>
            <field name="view_mode">tree,form</field>
            <field name="view_ids"
                eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('timetable_tree_view')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('timetable_form_view')})]"/>
            <field name="domain">[('date', '=', datetime.date.today()), ('group_id.is_active', '=', True), ('group_id.is_submit', '=', False)]</field>
            <field name="target">current</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer une nouvelle programmation de cours.
                </p>
            </field>
            <field name="search_view_id" ref="timetable_search_view"/>
        </record>

        <menuitem
            id="menu_timetable"
            name="Emplois du temps"
            parent="menu_siantou_ems_timetable_planning"
            action="action_show_timetable"
            groups="siantou_ems_core.group_timetable_user,siantou_ems_core.group_timetable_admin,base.group_system"
            sequence="1"/>
	</data>
</odoo>