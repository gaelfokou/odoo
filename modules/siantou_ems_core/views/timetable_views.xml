<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
	<data>
        <!-- Affichage en vue liste -->
		<record
                id="timetable_tree_view"
                model="ir.ui.view">
            <field name="name">timetable.tree.view</field>
			<field name="model">siantou.ems.timetable.timetable</field>
			<field name="arch" type="xml">
				<tree delete="False" string="Emploi du temps">
                    <header>
                        <button name="action_timetable_automatic" 
                            type="object" 
                            string="Génération automatique" 
                            class="oe_highlight" 
                            display="always"/>
                        <!-- <button name="teacher_test_dispatch" type="object" string="Teacher test" class="oe_highlight" display="always"/> -->
                        <button name="action_timetable_print" 
                            type="object" 
                            string="Impression" 
                            class="oe_highlight" 
                            display="always"/>
                        <!-- <button name="update_day_of_week" 
                            type="object" 
                            string="Update day" 
                            class="oe_highlight" 
                            groups="siantou_ems_core.group_timetable_admin"
                            display="always"/> -->
                    </header>
                    <field name="group_id"/>
                    <field name="batch_id"/>
                    <field name="date"/>
                    <field name="semester_id"/>
                    <field name="field_of_study_id"/>
                    <field name="level_id"/>
                    <field name="class_id"/>
                    <field name="specialty_id"/>
                    <field name="ue_id"/>
					<field name="subject_id"/>
					<field name="building_id"/>
					<field name="classroom_id"/>
					<field name="employee_id"/>
					<field name="day_of_week"/>
					<field name="start_time"/>
					<field name="end_time"/>
					<field name="status" widget="badge"
                        decoration-muted="status == '0'"
                        decoration-success="status == '1'"
                        decoration-danger="status == '2'"
                        decoration-info="status == '3'"
                        decoration-warning="status == '4'"/>
				</tree>
			</field>
		</record>

        <!-- Affichage en vue formulaire -->
		<record
                id="timetable_form_view"
                model="ir.ui.view">
			<field name="name">timetable.form.view</field>
			<field name="model">siantou.ems.timetable.timetable</field>
			<field name="arch" type="xml">
				<form string="Emploi du temps">
					<sheet>
                        <group>
                            <field name="group_id"/>
                            <field name="batch_id" options="{'no_create': True}"/>
                            <field name="date"/>
                            <field name="semester_id" options="{'no_create': True}"/>
                            <field name="field_of_study_id" options="{'no_create': True}"/>
                            <field name="level_id" options="{'no_create': True}"/>
                            <field name="class_id" options="{'no_create': True}" domain="[('filiere_id', '=', field_of_study_id), ('niveau_id', '=', level_id)]"/>
                            <field name="specialty_id" options="{'no_create': True}"/>
                            <field name="ue_id" options="{'no_create': True}" domain="[('class_id', '=', class_id), ('semestre_id', '=', semester_id)]"/>
                            <field name="subject_id" options="{'no_create': True}" domain="[('ue_ids', '=', ue_id)]"/>
                            <field name="building_id" options="{'no_create': True}"/>
                            <field name="classroom_id" options="{'no_create': True}" domain="[('building_id', '=', building_id)]"/>
                            <field name="employee_id" options="{'no_create': True}"/>
                            <field name="start_time"/>
                            <field name="end_time"/>
                            <field name="not_active_slotitems"/>
                            <field name="status"/>
                        </group>
					</sheet>
				</form>
			</field>
		</record>

        <!-- Action pour le menu d'affichage des années académiques -->
        <record
                id="action_show_timetable"
                model="ir.actions.act_window">
            <field name="name">Emploi du temps</field>
            <field name="res_model">siantou.ems.timetable.timetable</field>
            <field name="view_mode">tree,form</field>
            <field name="view_ids"
                eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('timetable_tree_view')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('timetable_form_view')})]" />
            <field name="target">current</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer une nouvelle programmation de cours.
                </p>
            </field>
        </record>

        
        <menuitem
            id="menu_timetable"
            name="Emploi du temps"
            parent="menu_siantou_ems_timetable_planning"
            action="action_show_timetable"
            groups="siantou_ems_core.group_timetable_user,siantou_ems_core.group_timetable_admin,base.group_system"
            sequence="1"/>
        
	</data>
</odoo>