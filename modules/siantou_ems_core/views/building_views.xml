<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
	<data>
		<!-- Affichage en vue liste -->
		<record
                id="building_tree_view"
                model="ir.ui.view">
            <field name="name">building.tree.view</field>
			<field name="model">siantou.ems.core.building</field>
			<field name="arch" type="xml">
				<tree string="Bâtiments" editable="bottom" edit="1">
                    <field name="active"/>
                    <field name="code"/>
					<field name="name"/>
                    <field name="address_id"/>
				</tree>
			</field>
		</record>

        <!-- Affichage en vue formulaire -->
		<record
                id="building_form_view"
                model="ir.ui.view">
			<field name="name">building.form.view</field>
			<field name="model">siantou.ems.core.building</field>
			<field name="arch" type="xml">
				<form string="Bâtiment">
					<sheet>
                        <group>
                            <field name="active"/>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="address_id"/>
                        </group>
					</sheet>
				</form>
			</field>
		</record>

        <!-- Action pour le menu d'affichage des programmes -->
        <record
                id="action_show_building"
                model="ir.actions.act_window">
            <field name="name">Bâtiments</field>
            <field name="res_model">siantou.ems.core.building</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer un nouveau bâtiment.
                </p>
            </field>
        </record>

        <!-- Menu pour la gestion des filières -->
        <menuitem
                id="menu_siantou_ems_core_building"
                name="Bâtiments"
                parent="menu_siantou_ems_core_configuration"
                action="action_show_building"
                groups="siantou_ems_core.group_building_user,siantou_ems_core.group_building_admin,base.group_system"
                sequence="5"/>
	</data>
</odoo>