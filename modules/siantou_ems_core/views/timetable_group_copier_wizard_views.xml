<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="timetable_group_copier_wizard" model="ir.ui.view">
            <field name="name">timetable.group.copier.wizard.form</field>
            <field name="model">timetable.group.copier.wizard</field>
            <field name="arch" type="xml">
                <form string="Copieur des versions d'emploi du temps">
                    <group>
                        <field name="is_submit" readonly="1"/>
                        <field name="source_year_id" options="{'no_create': True}"/>
                        <field name="group_id" options="{'no_create': True}" domain="['|', ('create_uid', '=', uid), ('write_user_ids', '=', uid), ('semester_id.year_id', '=', source_year_id)]"/>
                        <field name="destination_year_id" options="{'no_create': True}"/>
                    </group>
                    <footer>
                        <button string="Copier" type="object" name="action_copier" class="btn-primary"/>
                        <button string="Annuler" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Define an action to open the form view -->
        <record id="action_copier_timetable_wizard" model="ir.actions.act_window">
            <field name="name">Copieur des versions d'emploi du temps</field>
            <field name="res_model">timetable.group.copier.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="timetable_group_copier_wizard"/>
        </record>
    </data>
</odoo>