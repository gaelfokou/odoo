<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		<!-- Affichage en vue liste -->
		<record
                id="siantou_ems_core_class_tree_view"
                model="ir.ui.view">
            <field name="name">siantou_ems_core_class.tree.view</field>
			<field name="model">siantou.ems.core.class</field>
			<field name="arch" type="xml">
				<tree string="Classe standard">
					<field name="name"/>
                	<field name="field_of_study_id"/>
                	<field name="specialty_id"/>
                	<field name="option_id"/>
                    <field name="school_id"/>
                    <field name="year_id"/>
                    <field name="level_id"/>
                    <field name="type_cour"/>
                    <field name="group_ids" widget="many2many_tags"/>
				</tree>
			</field>
		</record>

        <!-- Affichage en vue formulaire -->
		<record
                id="siantou_ems_core_class_form_view"
                model="ir.ui.view">
			<field name="name">siantou_ems_core_class.form.view</field>
			<field name="model">siantou.ems.core.class</field>
			<field name="arch" type="xml">
				<form string="Classe Standard">
					<sheet>
                        <group>
                            <group>
                                <field name="name" readonly="1"/>
                                <field name="level_id"/>
                                <field name="school_id"/>
                                <field name="year_id"/>
                            </group>
                            <group>
                                <field name="field_of_study_id" options="{'no_create': True}" domain="[('school_id', '=', school_id)]"/>
                                <field name="specialty_id" options="{'no_create': True}" domain="[('field_of_study_id', '=', field_of_study_id)]"/>
                                <field name="option_id" options="{'no_create': True}" domain="[('specialty_id', '=', specialty_id)]"/>
                                <field name="type_cour" widget="radio"/>
                                <field name="group_ids"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="unite_enseignement" string="Unité d'enseignements">
                                <field name="ue_ids">
                                    <tree editable="bottom">
                                        <field name="code"/>
                                        <field name="name"/>
                                        <field name="type_ue"/>
                                        <field name="semestre_id"/>
                                    </tree>
                                </field>
                            </page>
                            <page name="student_ids" string="Étudiants">
                                <field name="student_ids" options="{'create': false, 'create_edit': false}"/>
                            </page>
                        </notebook>
					</sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="message_ids"/>
                    </div>
				</form>
			</field>
		</record>

        <!-- Action pour le menu s'affichage des classes standards -->
        <record
                id="action_show_siantou_ems_core_class"
                model="ir.actions.act_window">
            <field name="name">Classe Standard</field>
            <field name="res_model">siantou.ems.core.class</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer une nouvelle classe.
                </p>
            </field>
        </record>

        <!-- Menu pour la gestion des classes -->
        <menuitem
                id="menu_siantou_ems_core_class"
                name="Classes"
                parent="menu_siantou_ems_core_config_fa"
                action="action_show_siantou_ems_core_class"
                sequence="4"/>

	</data>
</odoo>