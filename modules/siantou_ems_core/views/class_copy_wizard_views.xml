<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="class_copy_wizard" model="ir.ui.view">
            <field name="name">class.copy.wizard.form</field>
            <field name="model">class.copy.wizard</field>
            <field name="arch" type="xml">
                <form string="Copie des classes">
                    <group>
                        <field name="school_id" options="{'no_create': True}"/>
                        <field name="cycle_id_domain" invisible="1"/>
                        <field name="cycle_id" options="{'no_create': True}" domain="cycle_id_domain"/>
                        <field name="level_id_domain" invisible="1"/>
                        <field name="level_id" options="{'no_create': True}" domain="level_id_domain"/>
                        <field name="type_cour" widget="radio"/>
                        <field name="source_year_id" options="{'no_create': True}"/>
                        <field name="source_class_id_domain" invisible="1"/>
                        <field name="source_class_id" options="{'no_create': True}" domain="source_class_id_domain"/>
                        <field name="source_ue_ids" invisible="not source_class_id"/>
                        <field name="destination_year_id" options="{'no_create': True}"/>
                        <field name="destination_class_id_domain" invisible="1"/>
                        <field name="destination_class_id" options="{'no_create': True}" domain="destination_class_id_domain"/>
                        <field name="destination_ue_ids" invisible="not destination_class_id"/>
                    </group>
                    <footer>
                        <button string="Copier" type="object" name="action_copy" class="btn-primary" confirm="Êtes-vous sûr de vouloir confirmer la copie ?"/>
                        <button string="Copier les unités d'enseignement" type="object" name="action_copy_ue" class="btn-primary" confirm="Êtes-vous sûr de vouloir confirmer la copie ?"/>
                        <button string="Copier les emplois du temps" type="object" name="action_copy_timetable" class="btn-primary" confirm="Êtes-vous sûr de vouloir confirmer la copie ?"/>
                        <button string="Annuler" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Define an action to open the form view -->
        <record id="action_copy_ue_wizard" model="ir.actions.act_window">
            <field name="name">Copie des classes</field>
            <field name="res_model">class.copy.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="class_copy_wizard"/>
        </record>
    </data>
</odoo>