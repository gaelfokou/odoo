<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="class_filter_wizard" model="ir.ui.view">
            <field name="name">class.filter.wizard.form</field>
            <field name="model">class.filter.wizard</field>
            <field name="arch" type="xml">
                <form string="Filtre des classes">
                    <group>
                        <field name="year_id" options="{'no_create': True}"/>
                        <field name="semester_id" options="{'no_create': True}" domain="[('year_id', '=', year_id)]"/>
                        <field name="school_id" options="{'no_create': True}"/>
                        <field name="cycle_id_domain" invisible="1"/>
                        <field name="cycle_id" options="{'no_create': True}" domain="cycle_id_domain"/>
                        <field name="level_id_domain" invisible="1"/>
                        <field name="level_id" options="{'no_create': True}" domain="level_id_domain"/>
                        <field name="type_cour" widget="radio"/>
                        <field name="status"/>
                        <field name="number_of_student" invisible="not status or status not in ['student_more_than_or_equal', 'student_less_than']"/>
                        <!-- <field name="semester_id" invisible="not status or status not in ['timetable_available', 'timetable_not_available']" options="{'no_create': True}" domain="[('year_id', '=', year_id)]"/> -->
                    </group>
                    <footer>
                        <button string="Filtrer" type="object" name="action_filter" class="btn-primary"/>
                        <button string="Annuler" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Define an action to open the form view -->
        <record id="action_filter_class_wizard" model="ir.actions.act_window">
            <field name="name">Filtre des classes</field>
            <field name="res_model">class.filter.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="class_filter_wizard"/>
        </record>
    </data>
</odoo>