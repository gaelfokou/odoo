<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_request_track_tree" model="ir.ui.view">
            <field name="name">request.track.tree</field>
            <field name="model">siantou.ems.core.request.track</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string="Requêtes">
                    <!-- <field name="name"/> -->
                    <field name="description"/>
                    <field name="type_request"/>
                    <field name="date"
                        decoration-warning="status in ['pending', 'progress'] and date and date == current_date"
                        decoration-danger="status in ['pending', 'progress'] and date and date &lt; current_date"/>
                    <field name="create_uid"/>
                    <field name="user_ids" widget="many2many_tags"/>
                    <field name="note"/>
					<field name="status" widget="badge"
                        decoration-muted="status == 'pending'"
                        decoration-primary="status == 'progress'"
                        decoration-danger="status == 'rejected'"
                        decoration-success="status == 'done'"/>
                </tree>
            </field>
        </record>

        <record id="view_request_track_form" model="ir.ui.view">
            <field name="name">request.track.form</field>
            <field name="model">siantou.ems.core.request.track</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Requête">
                    <header>
                        <button name="state_pending_request" class="oe_highlight" invisible="state in ['pending', 'progress', 'rejected', 'done']" string="En attente" type="object"/>
                        <button name="state_progress_request" class="oe_highlight" invisible="state in ['progress']" string="En cours" type="object"/>
                        <button name="state_rejected_request" class="oe_highlight" invisible="state in ['rejected', 'done']" string="Rejeté" type="object"/>
                        <button name="state_done_request" class="oe_highlight" invisible="state in ['pending', 'rejected', 'done']" string="Terminé" type="object"/>
                        <field name="state" widget="statusbar" statusbar_visible="pending,progress,rejected,done"/>
                    </header>
                    <sheet>
                        <group colspan="2">
                            <field name="name" readonly="id != False and create_uid != uid"/>
                            <field name="description" readonly="id != False and create_uid != uid"/>
                            <field name="type_request" readonly="id != False and create_uid != uid"/>
                            <field name="date" readonly="id != False and create_uid != uid"/>
                        </group>
                        <group colspan="2">
                            <field name="create_uid"/>
                            <field name="user_ids" widget="many2many_tags" readonly="id != False and create_uid != uid"/>
                            <field name="note"/>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

       <record id="view_request_track_search" model="ir.ui.view">
            <field name="name">request.track.search</field>
            <field name="model">siantou.ems.core.request.track</field>
            <field name="type">search</field>
            <field name="arch" type="xml">
                <search string="Logs des utilisateurs">
                    <filter name="type_request_academic_information" string="Informations académiques" icon="terp-tools" domain="[('type_request', '=', 'academic_information')]"/>
                    <filter name="type_request_exam_score" string="Notes d'examen" icon="terp-tools" domain="[('type_request', '=', 'exam_score')]"/>
    	            <group expand="0" string="Group By">
                    	<filter name="group_by_status" string="Status" context="{'group_by': 'status'}"/>
                	</group>
                </search>
            </field>
        </record>

        <record id="action_show_request_track_dashboard" model="ir.actions.client">
            <field name="name">Tableau de bord</field>
            <field name="tag">owl.request_track_dashboard</field>
        </record>

        <!-- <record id="action_show_request_track" model="ir.actions.act_window">
            <field name="name">Requêtes</field>
            <field name="res_model">siantou.ems.core.request.track</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_request_track_search"/>
            <field name="view_ids"
                eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('view_request_track_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_request_track_form')})]"/>
            <field name="context">{'group_by': ['status']}</field>
            <field name="context">{'search_default_group_by_status': 1}</field>
        </record> -->

        <record id="action_show_request_track_all" model="ir.actions.act_window">
            <field name="name">Toutes les requêtes</field>
            <field name="res_model">siantou.ems.core.request.track</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_request_track_search"/>
            <field name="view_ids"
                eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('view_request_track_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_request_track_form')})]"/>
            <!-- <field name="context">{'group_by': ['status']}</field> -->
            <field name="context">{'search_default_group_by_status': 1}</field>
        </record>

        <record id="action_show_request_track_sent" model="ir.actions.act_window">
            <field name="name">Requêtes envoyées</field>
            <field name="res_model">siantou.ems.core.request.track</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_request_track_search"/>
            <field name="view_ids"
                eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('view_request_track_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_request_track_form')})]"/>
            <!-- <field name="context">{'group_by': ['status']}</field> -->
            <field name="context">{'search_default_group_by_status': 1}</field>
            <field name="domain">[('create_uid', '=', uid)]</field>
        </record>

        <record id="action_show_request_track_received" model="ir.actions.act_window">
            <field name="name">Requêtes reçues</field>
            <field name="res_model">siantou.ems.core.request.track</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_request_track_search"/>
            <field name="view_ids"
                eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('view_request_track_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_request_track_form')})]"/>
            <!-- <field name="context">{'group_by': ['status']}</field> -->
            <field name="context">{'search_default_group_by_status': 1}</field>
            <field name="domain">[('user_ids', '=', uid)]</field>
        </record>

        <menuitem id="siantou_menu_request_track_dashboard"
                name="Requêtes"
            sequence="10"/>
        <menuitem id="siantou_menu_request_track"
                name="Tableau de bord"
                parent="siantou_menu_request_track_dashboard"
                action="action_show_request_track_dashboard"
                groups="siantou_ems_core.group_request_track_perm_all"
            sequence="20"/>
        <menuitem id="siantou_menu_request_track_all"
                name="Toutes les requêtes"
                parent="siantou_menu_request_track_dashboard"
                action="action_show_request_track_all"
                groups="siantou_ems_core.group_request_track_perm_all"
            sequence="21"/>
        <menuitem id="siantou_menu_request_track_sent"
                name="Requêtes envoyées"
                parent="siantou_menu_request_track_dashboard"
                action="action_show_request_track_sent"
                groups="siantou_ems_core.group_request_track_perm_sent"
            sequence="22"/>
        <menuitem id="siantou_menu_request_track_received"
                name="Requêtes reçues"
                parent="siantou_menu_request_track_dashboard"
                action="action_show_request_track_received"
                groups="siantou_ems_core.group_request_track_perm_received"
            sequence="23"/>
    </data>
</odoo>
