<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_hourly_rate_tree" model="ir.ui.view">
            <field name="name">hourly.rate.tree</field>
            <field name="model">siantou.ems.core.hourly.rate</field>
            <field name="arch" type="xml">
                <tree string="Taux horaires standards">
                    <header>
                        <button name="action_update_all_hourly_rate" 
                            type="object" 
                            string="Mettre à jour les taux horaires" 
                            class="oe_highlight"/>
                    </header>
                    <!-- <field name="name"/> -->
                    <field name="school_id"/>
                    <field name="cycle_id"/>
                    <field name="diplome_availability_id"/>
                    <field name="level_id"/>
                    <field name="type_cour"/>
                    <field name="rate"/>
                </tree>
            </field>
        </record>

        <record id="view_hourly_rate_form" model="ir.ui.view">
            <field name="name">hourly.rate.form</field>
            <field name="model">siantou.ems.core.hourly.rate</field>
            <field name="arch" type="xml">
                <form string="Taux horaire standard">
                    <sheet>
                        <group colspan="2">
                            <field name="name"/>
                            <field name="school_id"/>
                            <field name="cycle_id"/>
                        </group>
                        <group colspan="2">
                            <field name="diplome_availability_id"/>
                            <field name="level_id"/>
                            <field name="type_cour" widget="radio"/>
                            <field name="rate"/>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="action_show_hourly_rate" model="ir.actions.act_window">
            <field name="name">Taux horaires standards</field>
            <field name="res_model">siantou.ems.core.hourly.rate</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="siantou_menu_hourly_rate"
                name="Taux horaires standards"
                parent="menu_siantou_ems_core_employee"
                action="action_show_hourly_rate"
            sequence="20"/>
    </data>
</odoo>
