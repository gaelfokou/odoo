?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Vue Formulaire (Form) -->
    <record id="view_student_form" model="ir.ui.view">
        <field name="name">student.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Informations Étudiant">
                    <field name="is_student"/>
                    <field name="user_id" readonly="1"/>
                    <button name="action_create_student_user"
                            string="Créer un utilisateur"
                            type="object"
                            class="btn-primary"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Vue Liste (Tree) -->
    <record id="view_student_tree" model="ir.ui.view">
        <field name="name">student.tree</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <tree string="Étudiants">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- Vue Kanban -->
    <record id="view_student_kanban" model="ir.ui.view">
        <field name="name">student.kanban</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <kanban default_group_by="course_id">
                <templates>
                    <t t-name="kanban-box">
                        <div class="o_kanban_record">
                            <div class="o_kanban_image">
                                <img t-att-src="'/web/image/res.partner/' + record.id + '/image_128'" class="img-circle"/>
                            </div>
                            <strong><field name="name"/></strong>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action Server pour ouvrir la vue Form -->
    <record id="action_student_form" model="ir.actions.act_window">
        <field name="name">Étudiants</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="domain">[('is_student', '=', True)]</field>
    </record>

    <!-- Menu pour accéder aux étudiants -->
    <menuitem
            id="menu_siantou_ems_core_students_students"
            name="Gestion des Étudiants"
            parent="menu_siantou_ems_core_students"
            action="action_student_form"/>
</odoo>
