<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
	<data>
		<!-- Affichage en vue liste -->
		<record
                id="semester_tree_view"
                model="ir.ui.view">
            <field name="name">semester.tree.view</field>
			<field name="model">siantou.ems.core.year.semester</field>
			<field name="arch" type="xml">
				<tree string="Semestres" editable="bottom" edit="1">
                    <field name="name"/>
                    <field name="year_id"/>
					<field name="start_time"/>
					<field name="end_time"/>
					<field name="number_of_week"/>
				</tree>
			</field>
		</record>

        <!-- Affichage en vue formulaire -->
		<record
                id="semester_form_view"
                model="ir.ui.view">
			<field name="name">semester.form.view</field>
			<field name="model">siantou.ems.core.year.semester</field>
			<field name="arch" type="xml">
				<form string="Semestre">
					<sheet>
                        <group string="Informations sur le semestre">
                            <field name="name"/>
							<field name="year_id"/>
							<field name="start_time"/>
							<field name="end_time"/>
							<field name="number_of_week"/>
                        </group>
						<group string="Cours du semestre">
							<field name="subject_ids"/>
						</group>
					</sheet>
				</form>
			</field>
		</record>

        <!-- Action pour le menu s'affichage des semestre -->
        <record
                id="action_show_semester"
                model="ir.actions.act_window">
            <field name="name">Semestres</field>
            <field name="res_model">siantou.ems.core.year.semester</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer un nouveau semestre.
                </p>
            </field>
        </record>

        <!-- Menu pour les semestres -->
        <menuitem
                id="menu_siantou_ems_core_config_semester"
                name="Semestres"
                parent="menu_siantou_ems_core_config"
                action="action_show_semester"
                
                sequence="3"/>
	</data>
</odoo>