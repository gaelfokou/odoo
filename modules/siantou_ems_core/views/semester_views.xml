<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		<!-- Affichage en vue liste -->
		<record
                id="semester_tree_view"
                model="ir.ui.view">
            <field name="name">semester.tree.view</field>
			<field name="model">siantou.ems.core.year.semester</field>
			<field name="arch" type="xml">
				<tree string="Semestres">
                    <field name="name"/>
                    <field name="year_id"/>
					<field name="level_ids" widget="many2many_tags"/>
					<field name="start_time"/>
					<field name="end_time"/>
					<field name="number_of_week"/>
				</tree>
			</field>
		</record>

        <!-- Affichage en vue formulaire -->
		<record
                id="semester_form_view"
                model="ir.ui.view">
			<field name="name">semester.form.view</field>
			<field name="model">siantou.ems.core.year.semester</field>
			<field name="arch" type="xml">
				<form >
					<sheet>
                        <group col="4" string="Informations sur le semestre">
                            <group col="2" >
                                <field name="semester_name"/>
                                <field name="start_time"/>
                                <field name="year_id" options="{'no_create': True}"/>
                            </group>
                            <group colspan="2">
                                <field name="end_time"/>
                                <field name="number_of_week"/>
            					<field name="level_ids" widget="many2many_tags"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="ue" string="Unité d'enseignement">
                                <field name="ue_ids">
                                    <tree>
                                        <field name="code"/>
                                        <field name="name"/>
                                        <field name="type_ue"/>
                                        <field name="class_ids"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
					</sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
				</form>
			</field>
		</record>

        <!-- Action pour le menu s'affichage des semestre -->
        <record
                id="action_show_semester"
                model="ir.actions.act_window">
            <field name="name">Semestres</field>
            <field name="res_model">siantou.ems.core.year.semester</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('year_id.active_user_ids', '=', uid)]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer un nouveau semestre.
                </p>
            </field>
        </record>

        <record
                id="action_show_semester_2"
                model="ir.actions.act_window">
            <field name="name">Semestres</field>
            <field name="res_model">siantou.ems.core.year.semester</field>
            <field name="view_mode">tree</field>
            <field name="domain">[('year_id.active_user_ids', '=', uid)]</field>
            <field name="context">{'create': False, 'edit': False}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer un nouveau semestre.
                </p>
            </field>
        </record>

        <!-- Menu pour les semestres -->
        <menuitem
                id="menu_siantou_ems_core_config_semester"
                name="Semestres"
                parent="menu_siantou_ems_core_config_pe"
                action="action_show_semester"
                groups="siantou_ems_core.group_semester_admin,base.group_system"
            sequence="1"/>
        <menuitem
                id="menu_siantou_ems_core_config_semester_2"
                name="Semestres"
                parent="menu_siantou_ems_core_program"
                action="action_show_semester_2"
                groups="siantou_ems_core.group_semester_admin,base.group_system"
            sequence="1"/>
	</data>
</odoo>