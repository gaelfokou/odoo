<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
	<data>
		<!-- Affichage en vue liste -->
		<record
                id="semester_tree_view"
                model="ir.ui.view">
            <field name="name">semester.tree.view</field>
			<field name="model">siantou.ems.core.year.semester</field>
			<field name="arch" type="xml">
				<tree string="Semestres">
                    <field name="name"/>
                    <field name="year_id"/>
					<field name="start_time"/>
					<field name="end_time"/>
					<field name="number_of_week"/>
				</tree>
			</field>
		</record>

        <!-- Affichage en vue formulaire -->
		<record
                id="semester_form_view"
                model="ir.ui.view">
			<field name="name">semester.form.view</field>
			<field name="model">siantou.ems.core.year.semester</field>
			<field name="arch" type="xml">
				<form >
					<sheet>
                        <group col="4" string="Informations sur le semestre">
                            <group col="2" >
                                <field name="name"/>
                                <field name="start_time"/>
                                <field name="year_id"/>
                            </group>
                            <group colspan="2">
                                <field name="class_id"/>
                                <field name="end_time"/>
                                <field name="number_of_week"/>
                            </group>
                        </group>
						<!-- <group string="Cours du semestre">
							<field name="subject_ids"/>
						</group> -->
                        <notebook>
                            <page name="unite_enseigenement" string="Unité d'enseignement">
                                <field name="unite_enseignement_ids">
                                    <tree 
                                    editable='bottom'
                                    >
                                    <field name="code" />
                                    <field name="name" />
                                    <field name="total_credit" sum="Total credit" />
                                    </tree>
                                </field>
                            </page>
                        </notebook>
					</sheet>
				</form>
			</field>
		</record>

        <!-- Action pour le menu s'affichage des semestre -->
        <record
                id="action_show_semester"
                model="ir.actions.act_window">
            <field name="name">Semestres</field>
            <field name="res_model">siantou.ems.core.year.semester</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer un nouveau semestre.
                </p>
            </field>
        </record>

        <!-- Menu pour les semestres -->
        <menuitem
                id="menu_siantou_ems_core_config_semester"
                name="Semestres"
                parent="menu_production_pe_conf"
                action="action_show_semester"
                groups="siantou_ems_core.group_semester_user,siantou_ems_core.group_semester_admin,base.group_system"
                sequence="1"/>
	</data>
</odoo>