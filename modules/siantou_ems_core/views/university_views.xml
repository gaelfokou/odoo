<odoo>
	<data>
        <record id="view_company_form_inherit" model="ir.ui.view">
            <field name="name">view.company.form.inherit</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[1]/group[1]" position="inside">
                    <field name="is_university"/>
                </xpath>
                <xpath expr="//field[@name='vat']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='company_registry']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='currency_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='parent_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='alias_domain_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='bounce_formatted']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='catchall_formatted']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='default_from_email']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>

        <record id="view_company_search_form" model="ir.ui.view">
            <field name="name">company.search.form</field>
            <field name="model">res.company</field>
            <field name="arch" type="xml">
                <search string="Universités">
                    <field name="name" string="Université"/>
                    <filter string="Universités" name="university" domain="[('is_university', '=', True)]"/>
                </search>
            </field>
        </record>

        <record id="action_school_setup" model="ir.actions.act_window">
            <field name="name">Université</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.company</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="search_view_id" ref="view_company_search_form"/>
            <field name="context">{'search_default_institutes': 1, 'default_is_university':1}</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Créer une nouvelle université.
              </p>
            </field>
        </record>

        <menuitem
                id="menu_siantou_ems_core_config_university"
                name="Universités"
                parent="menu_siantou_ems_core_configuration"
                action="action_school_setup"
                groups="siantou_ems_core.group_university_user,siantou_ems_core.group_university_admin,base.group_system"
            sequence="1"/>
	</data>
</odoo>