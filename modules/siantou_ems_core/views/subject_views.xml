<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <!-- Affichage en vue liste -->
        <record
                id="subject_tree_view"
                model="ir.ui.view">
            <field name="name">subject.tree.view</field>
            <field name="model">siantou.ems.core.subject</field>
            <field name="arch" type="xml">
                <tree string="Cours">
                    <field name="code"/>
                    <field name="shared_subject"/>
                    <field name="subject_id" invisible="shared_subject == True"/>
                    <field name="subject_ids" invisible="shared_subject == False"/>
                    <field name="name"/>
                    <field name="ue_ids"/>
                    <field name="hours_credit"/>
                </tree>
            </field>
        </record>

        <!-- Affichage en vue formulaire -->
        <record
                id="subject_form_view"
                model="ir.ui.view">
            <field name="name">subject.form.view</field>
            <field name="model">siantou.ems.core.subject</field>
            <field name="arch" type="xml">
                <form string="Cours">
                    <sheet>
                        <group string="Informations sur le cours" col="4">
                            <group colspan="2">
                                <field name="code"/>
                                <field name="ue_ids" widget="many2many_tags" options="{'no_open': True, 'no_create': True}"/>
                                <field name="hours_credit"/>
                            </group>
                            <group colspan="2">
                                <field name="name"/>
                                <field name="shared_subject" 
                                    invisible="eps_subject == True"/>
                                <field name="eps_subject"
                                    invisible="shared_subject == True"/>
                                <field name="subject_id" invisible="shared_subject == True"/>
                                <field name="subject_ids" widget="one2many_list" invisible="shared_subject == False"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="name" string="Enseignants du cours">
                                <field name="teacher_ids"/>
                            </page>
                            <page name="name" string="Priorités des enseignants">
                                <field name="teacher_priority_ids" widget="one2many_list">
                                    <tree editable="bottom">
                                        <field name="employee_id" options="{'no_open': True}"/>
                                        <field name="priority"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action pour le menu d'affichage des cours -->
        <record
            id="action_show_subject"
            model="ir.actions.act_window">
            <field name="name">Cours</field>
            <field name="res_model">siantou.ems.core.subject</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer un nouveau cours.
                </p>
            </field>
        </record>

        <!-- Menu pour les cours -->
        <menuitem
                id="menu_siantou_ems_core_program_subject"
                name="Cours"
                parent="menu_production_pe_conf"
                action="action_show_subject"
                groups="siantou_ems_core.group_subject_user,siantou_ems_core.group_subject_admin,base.group_system"
                sequence="3"/>
    </data>
</odoo>
