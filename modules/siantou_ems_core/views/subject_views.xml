<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <!-- Affichage en vue liste -->
        <record
                id="subject_tree_view"
                model="ir.ui.view">
            <field name="name">subject.tree.view</field>
            <field name="model">siantou.ems.core.subject</field>
            <field name="arch" type="xml">
                <tree string="Cours">
                    <field name="code"/>
                    <field name="shared_subject"/>
                    <field name="name"/>
                    <field name="semester_id"/>
                    <field name="field_of_study_id"/>
                    <field name="level_id"/>
                    <field name="hours_credit"/>
                    <field name="weekly_hours_credit"/>
                </tree>
            </field>
        </record>

        <!-- Affichage en vue formulaire -->
        <record
                id="subject_form_view"
                model="ir.ui.view">
            <field name="name">subject.form.view</field>
            <field name="model">siantou.ems.core.subject</field>
            <field name="arch" type="xml">
                <form string="Cours">
                    <sheet>
                        <group string="Informations sur le cours">
                            <field name="code"/>
                            <field name="shared_subject"/>
                            <field name="name"/>
                            <field name="semester_id"/>
                            <field name="field_of_study_id"/>
                            <field name="level_id"/>
                            <field name="hours_credit"/>
                            <field name="weekly_hours_credit"/>
                        </group>
                        <group string="Enseignants du cours">
                            <field name="teacher_ids"/>
                        </group>
                        <group string="Priorités des enseignants">
                            <field name="teacher_priority_ids" widget="one2many_list">
                                <tree editable="bottom">
                                    <field name="employee_id" options="{'no_open': True}"/>
                                    <field name="priority"/>
                                </tree>
                            </field>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action pour le menu d'affichage des cours -->
        <record
            id="action_show_subject"
            model="ir.actions.act_window">
            <field name="name">Cours</field>
            <field name="res_model">siantou.ems.core.subject</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer un nouveau cours.
                </p>
            </field>
        </record>

        <!-- Menu pour les cours -->
        <menuitem
                id="menu_siantou_ems_core_program_subject"
                name="Cours"
                parent="menu_siantou_ems_core_program"
                action="action_show_subject"
                groups="group_school_manager"
                sequence="3"/>
    </data>
</odoo>
