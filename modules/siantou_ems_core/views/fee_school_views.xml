<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
        <record id="action_show_fee_school" model="ir.actions.act_window">
            <field name="name">Frais de scolarité</field>
            <field name="res_model">siantou.ems.core.fee.school</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p>Cliquez sur nouveau pour créer</p>
            </field>
        </record>

        <record id="fee_school_form" model="ir.ui.view">
            <field name="name">siantou.ems.core.fee.school.form</field>
            <field name="model">siantou.ems.core.fee.school</field>
            <field name="arch" type="xml">
                <form string="Frais de scolarité">
                    <header>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Nom"/>
                            <h1><field name="name" placeholder="Ex : frais"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                            </group>
                            <group>
                                <field name="journal_id" options="{'no_create': True}"/>
                            </group>
                            <group>
                                <field name="year_id" options="{'no_create': True}"/>
                            </group>
                            <group>
                                <field name="nbre_tranche"/>
                            </group>
                            <group>
                                <field name="montant_paie"/>
                            </group>
                            <notebook>
                                <page name="line_ids" string="Lignes">
                                    <field name="line_ids">
                                        <tree editable="bottom" edit="1">
                                            <field name="name"/>
                                            <field name="fee_school_id"/>
                                            <field name="montant_paie"/>
                                            <field name="date_debut"/>
                                            <field name="date_fin"/>
                                        </tree>
                                    </field>
                                </page>
                                <page name="field_of_study_ids" string="Filières">
                                    <field name="field_of_study_ids">
                                        <tree>
                                            <field name="code"/>
                                            <field name="name"/>
                                        </tree>
                                    </field>
                                </page>
                                <page name="notes" string="Notes">
                                    <field name="note"/>
                                </page>
                            </notebook>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="fee_school_tree" model="ir.ui.view">
            <field name="name">siantou.ems.core.fee.school.tree</field>
            <field name="model">siantou.ems.core.fee.school</field>
            <field name="arch" type="xml">
                <tree string="Frais de scolarité">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="nbre_tranche"/>
                    <field name="montant_paie"/>
                </tree>
            </field>
        </record>

        <!-- Menu pour les schoolure des frais d'inscription -->
        <menuitem
                id="menu_siantou_ems_core_config_fee_school"
                name="Frais de scolarité"
                parent="menu_siantou_ems_core_configuration"
                action="action_show_fee_school"
            sequence="14"/>
	</data>
</odoo>