<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_teacher_availability_tree" model="ir.ui.view">
            <field name="name">teacher.availability.tree</field>
            <field name="model">siantou.ems.core.teacher.availability</field>
            <field name="arch" type="xml">
                <tree string="Disponibilités des Enseignants">
                    <field name="employee_id"/>
                    <field name="day_of_week"/>
                    <field name="start_time"/>
                    <field name="end_time"/>
                </tree>
            </field>
        </record>

        <record id="view_teacher_availability_form" model="ir.ui.view">
            <field name="name">teacher.availability.form</field>
            <field name="model">siantou.ems.core.teacher.availability</field>
            <field name="arch" type="xml">
                <form string="Disponibilité des Enseignants">
                    <sheet>
                        <group>
                            <field name="employee_id"/>
                            <field name="day_of_week"/>
                            <field name="start_time"/>
                            <field name="end_time"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_teacher_availability" model="ir.actions.act_window">
            <field name="name">Disponibilités Enseignants</field>
            <field name="res_model">siantou.ems.core.teacher.availability</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="siantou_menu_teacher_availability"
                name="Disponibilités"
                parent="menu_siantou_ems_core_employee"
                action="action_teacher_availability"
                sequence="20"/>


    </data>
</odoo>
