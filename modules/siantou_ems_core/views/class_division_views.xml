<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		<!-- Affichage en vue liste -->
		<record
                id="class_tree_view"
                model="ir.ui.view">
            <field name="name">siantou_ems_core_class.tree.view</field>
			<field name="model">siantou.ems.core.class</field>
			<field name="arch" type="xml">
				<tree string="Classe standard">
                    <header>
                        <button name="action_reset_filter" 
                            type="object" 
                            string="Réinitialiser" 
                            class="oe_highlight" 
                            display="always"/>
                        <button name="action_open_filter" 
                            type="object" 
                            string="Filtrer" 
                            class="oe_highlight" 
                            display="always"/>
                        <button name="action_print_pdf" 
                            type="object" 
                            string="Imprimer PDF" 
                            class="oe_highlight" 
                            display="always"/>
                    </header>
					<field name="name"/>
                    <field name="year_id"/>
                    <field name="school_id"/>
                    <field name="level_id"/>
                	<field name="field_of_study_id"/>
                	<field name="specialty_id"/>
                	<field name="option_id"/>
                	<field name="cycle_id"/>
                	<field name="supervision_id"/>
                    <field name="type_cour"/>
                    <field name="group_ids" widget="many2many_tags"/>
                    <field name="number_of_student"/>
                    <field name="delegate_student_ids" widget="many2many_tags"/>
				</tree>
			</field>
		</record>

        <!-- Affichage en vue formulaire -->
		<record
                id="siantou_ems_core_class_form_view"
                model="ir.ui.view">
			<field name="name">siantou_ems_core_class.form.view</field>
			<field name="model">siantou.ems.core.class</field>
			<field name="arch" type="xml">
				<form string="Classe">
					<sheet>
                        <group>
                            <group>
                                <field name="name" readonly="1"/>
                                <field name="year_id"/>
                                <field name="school_id"/>
                                <field name="level_id"/>
                                <field name="number_of_student"/>
                                <field name="delegate_student_ids" domain="[('class_id', '=', id)]" widget="many2many_tags"/>
                            </group>
                            <group>
                                <field name="field_of_study_id" options="{'no_create': True}" domain="[('school_id', '=', school_id)]"/>
                                <field name="specialty_id" options="{'no_create': True}" domain="[('field_of_study_id', '=', field_of_study_id)]"/>
                                <field name="option_id" options="{'no_create': True}" domain="[('specialty_id', '=', specialty_id)]"/>
                                <field name="cycle_id"/>
                                <field name="supervision_id" options="{'no_create': True}" domain="[('cycle_ids', '=', cycle_id)]"/>
                                <field name="type_cour" widget="radio"/>
                                <field name="group_ids" widget="many2many_tags"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="unite_enseignement" string="Unité d'enseignements">
                                <field name="ue_ids">
                                    <tree editable="bottom">
                                        <field name="code"/>
                                        <field name="name"/>
                                        <field name="type_ue"/>
                                        <field name="semestre_id"/>
                                    </tree>
                                </field>
                            </page>
                            <page name="student_ids" string="Étudiants">
                                <field name="student_ids" options="{'create': false, 'create_edit': false}"/>
                            </page>
                            <page name="timetable_ids" string="Emplois du temps">
                                <field name="timetable_ids" domain="[('group_id.is_active', '=', True), ('group_id.is_submit', '=', False)]" options="{'create': false, 'create_edit': false}"/>
                            </page>
                        </notebook>
					</sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="message_ids"/>
                    </div>
				</form>
			</field>
		</record>

        <!-- Action pour le menu s'affichage des classes standards -->
        <record
                id="action_show_class"
                model="ir.actions.act_window">
            <field name="name">Classe</field>
            <field name="res_model">siantou.ems.core.class</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('year_id.is_active', '=', True)]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer une nouvelle classe.
                </p>
            </field>
        </record>

        <!-- Menu pour la gestion des classes -->
        <menuitem
                id="menu_siantou_ems_core_class"
                name="Classes"
                parent="menu_siantou_ems_core_config_fa"
                action="action_show_class"
            sequence="4"/>
        <menuitem
                id="menu_siantou_ems_core_class_2"
                name="Classes"
                parent="menu_siantou_ems_core_program"
                action="action_show_class"
            sequence="4"/>
	</data>
</odoo>