<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		<!-- Affichage en vue liste -->
		<record
                id="class_tree_view"
                model="ir.ui.view">
            <field name="name">siantou_ems_core_class.tree.view</field>
			<field name="model">siantou.ems.core.class</field>
			<field name="arch" type="xml">
				<tree string="Classes">
                    <header>
                        <button name="action_reset_filter" 
                            type="object" 
                            string="Réinitialiser" 
                            class="oe_highlight" 
                            display="always"/>
                        <button name="action_open_filter" 
                            type="object" 
                            string="Filtrer" 
                            class="oe_highlight" 
                            display="always"/>
                        <button name="action_print_pdf" 
                            type="object" 
                            string="Imprimer PDF" 
                            class="oe_highlight" 
                            display="always"
                            groups="siantou_ems_core.group_class_print_pdf"/>
                        <!-- <button name="action_update_all_student_class" 
                            type="object" 
                            string="Mettre à jour les étudiants et classes" 
                            class="oe_highlight"/> -->
                        <!-- <button name="action_update_all_group_class" 
                            type="object" 
                            string="Mettre à jour les groupes de classe" 
                            class="oe_highlight"/> -->
                        <!-- <button name="action_update_dashboard_class" 
                            type="object" 
                            string="Mettre à jour le tableau de bord des classes" 
                            class="oe_highlight"/> -->
                        <button name="action_open_copy" 
                            type="object" 
                            string="Copier UE" 
                            class="oe_highlight" 
                            display="always"
                            groups="siantou_ems_core.group_ue_open_copy"/>
                        <button name="action_print_class_subject_pdf" 
                            type="object" 
                            string="Imprimer Cours" 
                            class="btn-secondary" 
                            display="always"/>
                    </header>
					<field name="name"/>
                    <field name="year_id"/>
                    <field name="school_id"/>
                    <field name="level_id"/>
                	<field name="field_of_study_id"/>
                	<field name="specialty_id"/>
                	<field name="option_id"/>
                	<field name="cycle_id"/>
                	<field name="department_id"/>
                	<field name="supervision_id"/>
                    <field name="type_cour"/>
                    <field name="class_group_ids" widget="many2many_tags"/>
                    <field name="number_of_student"
                        decoration-warning="number_of_student &gt;= 5 and number_of_student &lt; 10"
                        decoration-danger="number_of_student &lt; 5"/>
                    <field name="delegate_student_ids" widget="many2many_tags"/>
				</tree>
			</field>
		</record>

		<!-- Affichage en vue kanban -->
        <record id="class_kanban_view" model="ir.ui.view">
            <field name="name">siantou_ems_core_class.kanban.view</field>
			<field name="model">siantou.ems.core.class</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" sample="1">
                    <header>
                        <button name="action_reset_filter" 
                            type="object" 
                            string="Réinitialiser" 
                            class="oe_highlight" 
                            display="always"/>
                        <button name="action_open_filter" 
                            type="object" 
                            string="Filtrer" 
                            class="oe_highlight" 
                            display="always"/>
                        <button name="action_print_kanban_pdf" 
                            type="object" 
                            string="Imprimer PDF" 
                            class="oe_highlight" 
                            display="always"
                            groups="siantou_ems_core.group_class_print_pdf"/>
                    </header>
                    <field name="name"/>
                    <field name="cycle_id"/>
                    <field name="department_id"/>
                    <field name="number_of_student"/>
                    <field name="is_timetable_active"/>
                    <field name="number_of_subjects"/>
                    <field name="number_of_subjects_validated"/>
                    <field name="number_of_subjects_not_validated"/>
                    <field name="number_of_subjects_hour"/>
                    <field name="number_of_hours"/>
                    <field name="number_of_worked_hours"/>
                    <field name="number_of_subjects_submitted"/>
                    <field name="number_of_subjects_not_submitted"/>
                    <field name="min_hours_credit"/>
                    <field name="max_hours_credit"/>
                    <field name="semester_id"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_global_click">
                                <ul class="list-group">
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <strong>
                                            <field name="name"/>
                                        </strong>
                                    </li>
                                    <t t-if="record.cycle_id.raw_value">
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <span>
                                                <field name="cycle_id"/>
                                            </span>
                                        </li>
                                    </t>
                                    <t t-if="record.department_id.raw_value">
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <span>
                                                <field name="department_id"/>
                                            </span>
                                        </li>
                                    </t>
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        Nombre d'étudiants
                                        <span t-attf-class="badge rounded-pill #{record.number_of_student.raw_value &lt; 5 ? 'bg-danger' : record.number_of_student.raw_value &gt;= 5 and record.number_of_student.raw_value &lt; 10 ? 'bg-warning' : 'bg-primary'}" style="display: inline-block !important;">
                                            <field name="number_of_student"/>
                                        </span>
                                    </li>
                                    <t t-if="record.is_timetable_active.raw_value">
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            Emplois du temps actifs ?
                                            <span class="badge rounded-pill text-bg-primary" style="display: inline-block !important;" t-esc="'Oui'"/>
                                        </li>
                                    </t>
                                    <t t-else="">
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            Emplois du temps actifs ?
                                            <span class="badge rounded-pill text-bg-secondary" style="display: inline-block !important;" t-esc="'Non'"/>
                                        </li>
                                    </t>
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        Cours
                                        <button name="get_subjects" type="object" class="badge rounded-pill text-bg-primary" style="display: inline-block !important;">
                                            <field name="number_of_subjects"/>
                                        </button>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        Cours soumis
                                        <button name="get_subjects_submitted" type="object" class="badge rounded-pill text-bg-primary" style="display: inline-block !important;">
                                            <field name="number_of_subjects_submitted"/>
                                        </button>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        Cours non soumis
                                        <button name="get_subjects_not_submitted" type="object" t-attf-class="badge rounded-pill #{record.number_of_subjects_not_submitted.raw_value &gt; 0 ? 'text-bg-danger' : 'text-bg-success'}"
                                            style="display: inline-block !important;">
                                            <field name="number_of_subjects_not_submitted"/>
                                        </button>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        Cours validés
                                        <button name="get_subjects_validated" type="object" class="badge rounded-pill text-bg-primary" style="display: inline-block !important;">
                                            <field name="number_of_subjects_validated"/>
                                        </button>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        Cours non validés
                                        <button name="get_subjects_not_validated" type="object" t-attf-class="badge rounded-pill #{record.number_of_subjects_not_validated.raw_value &gt; 0 ? 'text-bg-danger' : 'text-bg-success'}"
                                            style="display: inline-block !important;">
                                            <field name="number_of_subjects_not_validated"/>
                                        </button>
                                    </li>
                                    <t t-if="record.semester_id.raw_value">
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <span>
                                                <field name="semester_id"/>
                                            </span>
                                        </li>
                                    </t>
                                    <t t-if="record.start_date.raw_value">
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            Date de début
                                            <span>
                                                <field name="start_date"/>
                                            </span>
                                        </li>
                                    </t>
                                    <t t-if="record.end_date.raw_value">
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            Date de fin
                                            <span>
                                                <field name="end_date"/>
                                            </span>
                                        </li>
                                    </t>
                                </ul>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Affichage en vue formulaire -->
		<record
                id="class_form_view"
                model="ir.ui.view">
			<field name="name">siantou_ems_core_class.form.view</field>
			<field name="model">siantou.ems.core.class</field>
			<field name="arch" type="xml">
				<form string="Classes">
					<sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="year_id" options="{'no_create': True}"/>
                                <field name="school_id" options="{'no_create': True}"/>
                                <field name="level_id" options="{'no_create': True}"/>
                                <field name="number_of_student"/>
                                <field name="is_timetable_active"/>
                                <field name="timetable_inactive_date" invisible="is_timetable_active"/>
                                <field name="delegate_student_ids" domain="[('class_id', '=', id)]" widget="many2many_tags"/>
                            </group>
                            <group>
                                <field name="field_of_study_id" options="{'no_create': True}" domain="[('school_id', '=', school_id)]"/>
                                <field name="specialty_id" options="{'no_create': True}" domain="[('field_of_study_id', '=', field_of_study_id)]"/>
                                <field name="option_id" options="{'no_create': True}" domain="[('specialty_id', '=', specialty_id)]"/>
                                <field name="cycle_id" options="{'no_create': True}"/>
                            	<field name="department_id" options="{'no_create': True}"/>
                                <field name="supervision_id" options="{'no_create': True}" domain="[('cycle_ids', '=', cycle_id)]"/>
                                <field name="type_cour" widget="radio"/>
                                <field name="class_group_ids" domain="[('class_id', '=', id)]" widget="many2many_tags"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="unite_enseignement" string="Unité d'enseignements">
                                <field name="ue_ids">
                                    <tree>
                                        <field name="code"/>
                                        <field name="name"/>
                                        <field name="type_ue"/>
                                        <field name="semester_ids"/>
                                    </tree>
                                </field>
                            </page>
                            <page name="subject_ids" string="Cours">
                                <field name="subject_ids" options="{'create': false, 'create_edit': false}"/>
                            </page>
                            <page name="student_ids" string="Étudiants">
                                <field name="student_ids" options="{'create': false, 'create_edit': false}"/>
                            </page>
                            <page name="timetable_ids" string="Emplois du temps">
                                <field name="timetable_ids" options="{'create': false, 'create_edit': false}"/>
                            </page>
                        </notebook>
					</sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
				</form>
			</field>
		</record>

        <!-- Action pour le menu s'affichage des classes standards -->
        <record
                id="action_show_class"
                model="ir.actions.act_window">
            <field name="name">Classes</field>
            <field name="res_model">siantou.ems.core.class</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="domain">[('year_id.is_active', '=', True)]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer une nouvelle classe.
                </p>
            </field>
        </record>

        <record
                id="action_show_class_2"
                model="ir.actions.act_window">
            <field name="name">Classes</field>
            <field name="res_model">siantou.ems.core.class</field>
            <field name="view_mode">tree</field>
            <field name="domain">[('year_id.is_active', '=', True)]</field>
            <field name="context">{'create': False, 'edit': False}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer une nouvelle classe.
                </p>
            </field>
        </record>

        <!-- Menu pour la gestion des classes -->
        <menuitem
                id="menu_siantou_ems_core_class"
                name="Classes"
                parent="menu_siantou_ems_core_config_fa"
                action="action_show_class"
            sequence="4"/>
        <menuitem
                id="menu_siantou_ems_core_class_2"
                name="Classes"
                parent="menu_siantou_ems_core_program"
                action="action_show_class_2"
            sequence="4"/>
	</data>
</odoo>