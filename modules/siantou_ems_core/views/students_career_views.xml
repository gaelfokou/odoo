<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		<!-- Affichage en vue liste -->
		<record
                id="student_career_tree_view"
                model="ir.ui.view">
            <field name="name">student.career.tree.view</field>
			<field name="model">oe.school.student.career</field>
			<field name="arch" type="xml">
				<tree string="Parcours académique" default_order="id desc" default_group_by="student_id">
                    <field name="name"/>
                    <field name="student_id"/>
                    <field name="year_id"/>
                    <field name="level_id"/>
                    <field name="field_of_study_id"/>
                    <field name="cycle_id"/>
                    <field name="observations"/>
				</tree>
			</field>
		</record>

        <!-- Affichage en vue formulaire -->
		<record
                id="student_career_form_view"
                model="ir.ui.view">
			<field name="name">student.career.form.view</field>
			<field name="model">oe.school.student.career</field>
			<field name="arch" type="xml">
				<form string="Parcours académique">
					<sheet>
                        <group>
                            <group>
                                <field name="student_id"/>
                                <field name="level_id"/>
                            </group>
                            <group>
                                <field name="name"/>
                                <field name="field_of_study_id"/>
                            </group>
                            <group>
                                <field name="year_id"/>
                                <field name="cycle_id"/>
                            </group>
                            <group>
                                <field name="observations"/>
                            </group>
                        </group>
					</sheet>
				</form>
			</field>
		</record>

        <!-- Action pour le menu d'affichage des programmes -->
        <record
                id="action_show_student_career"
                model="ir.actions.act_window">
            <field name="name">Parcours académique</field>
            <field name="res_model">oe.school.student.career</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer un nouveau parcours.
                </p>
            </field>
        </record>

        <!-- Menu pour la gestion des filières -->
        <menuitem
                id="menu_siantou_ems_core_campus"
                name="Parcours académique"
                parent="menu_siantou_ems_core_students"
                action="action_show_student_career"
                groups="siantou_ems_core.group_student_career_admin,base.group_system"
            sequence="4"/>
	</data>
</odoo>