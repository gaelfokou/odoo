<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		<record id="view_siantou_ems_core_syllabus_tree" model="ir.ui.view">
        <field name="name">siantou.ems.core.syllabus.tree</field>
        <field name="model">siantou.ems.core.syllabus</field>
        <field name="arch" type="xml">
            <tree string="Syllabus">
                <field name="name"/>
                <field name="class_id"/>
                <field name="subject_id"/>
                <field name="description"/>
            </tree>
        </field>
    </record>

    <record id="view_siantou_ems_core_syllabus_form" model="ir.ui.view">
        <field name="name">siantou.ems.core.syllabus.form</field>
        <field name="model">siantou.ems.core.syllabus</field>
        <field name="arch" type="xml">
            <form string="Syllabus">
                <sheet>
                    <group col="4">
                        <group colspan="2">
                            <field name="name"/>
                            <field name="class_id" required="1"/>
                            <field name="ue_id" options="{'no_create': True}" domain="[('class_ids', '=', class_id)]"/>
                            <field name="note_sn" widget="radio"/>
                        </group>
                        <group colspan="2">
                            <field name="subject_id" options="{'no_create': True}" domain="[('ue_ids', 'in', [ue_id])]" required="1"/>
                            <field name="pourcentage_cc" placeholder="Pourcentage lors du controle continu"/>
                            <field name="pourcentage_exam" invisible="[('note_sn','=','not_sn')]" placeholder="Pourcentage lors de l'examen"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_siantou_ems_core_syllabus" model="ir.actions.act_window">
        <field name="name">Syllabus</field>
        <field name="res_model">siantou.ems.core.syllabus</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Create the your first syllabus here.
            </p>
        </field>
    </record>

        <!-- Menu pour les syllabus -->
        <!-- <menuitem
                id="menu_siantou_ems_core_config_syllabus"
                name="Syllabus"
                parent="menu_siantou_ems_core_configuration"
                action="action_show_syllabus"
            sequence="2"/> -->
	</data>
</odoo>