<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_timetable_print_wizard" model="ir.ui.view">
            <field name="name">timetable.print.wizard.form</field>
            <field name="model">timetable.print.wizard</field>
            <field name="arch" type="xml">
                <form string="Impression Emploi du temps">
                    <group>
                        <field name="semester_id"/>
                        <field name="level_id"/>
                        <field name="department_id"/>
                        <field name="field_of_study_id"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="group_id" options="{'no_create': True}" domain="[('semester_id', '=', semester_id)]"/>
                    </group>
                    <footer>
                        <button string="Imprimer" type="object" name="action_print_pdf" class="btn-primary"/>
                        <button string="Annuler" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Define an action to open the form view -->
        <record id="action_print_timetable_wizard" model="ir.actions.act_window">
            <field name="name">Impression de l'emploi du temps</field>
            <field name="res_model">timetable.print.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="view_timetable_print_wizard"/>
        </record>
    </data>
</odoo>