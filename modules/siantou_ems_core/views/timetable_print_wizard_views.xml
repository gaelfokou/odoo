<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_timetable_print_wizard" model="ir.ui.view">
            <field name="name">siantou.ems.timetable.timetable_print_wizard.form</field>
            <field name="model">siantou.ems.timetable.timetable_print_wizard</field>
            <field name="arch" type="xml">
                <form string="Impression Emploi du Temps">
                    <group>
                        <field name="semester_id"/>
                        <field name="level_id"/>
                        <field name="department_id"/>
                        <field name="field_of_study_id"/>
                        <field name="period_from"/>
                        <field name="period_to"/>
                        <field name="group_id" domain="[('semester_id', '=', semester_id)]"/>
                    </group>
                    <footer>
                        <button string="Imprimer" type="object" name="print_timetable" class="btn-primary"/>
                        <button string="Annuler" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Define an action to open the form view -->
        <record id="action_print_timetable_wizard" model="ir.actions.act_window">
            <field name="name">Impression de l'emploi du temps</field>
            <field name="res_model">siantou.ems.timetable.timetable_print_wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="view_timetable_print_wizard"/>
        </record>

