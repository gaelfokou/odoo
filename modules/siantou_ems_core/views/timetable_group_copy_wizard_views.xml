<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="timetable_group_copy_wizard_form" model="ir.ui.view">
            <field name="name">timetable.group.copy.wizard.form</field>
            <field name="model">timetable.group.copy.wizard</field>
            <field name="arch" type="xml">
                <form string="Copie des versions d'emploi du temps">
                    <group>
                        <field name="is_submit" readonly="1"/>
                        <field name="source_year_id" options="{'no_create': True}"/>
                        <field name="group_id" options="{'no_create': True}" domain="['|', '&amp;', ('is_submit', '=', is_submit), ('create_uid', '=', uid), '&amp;', ('is_submit', '=', is_submit), ('write_user_ids', '=', uid), ('semester_id.year_id', '=', source_year_id)]"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="destination_year_id" options="{'no_create': True}"/>
                    </group>
                    <footer>
                        <button string="Copier" type="object" name="action_copy" class="btn-primary" confirm="Êtes-vous sûr de vouloir confirmer la copie ?"/>
                        <button string="Annuler" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Define an action to open the form view -->
        <record id="action_timetable_group_copy_wizard" model="ir.actions.act_window">
            <field name="name">Copie des versions d'emploi du temps</field>
            <field name="res_model">timetable.group.copy.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="timetable_group_copy_wizard_form"/>
        </record>
    
        <menuitem
                id="menu_timetable_group_copy_wizard"
                name="Copie des versions d'emploi du temps"
                parent="menu_siantou_ems_core_config_copy"
                action="action_timetable_group_copy_wizard"
                groups="siantou_ems_core.group_timetable_open_copy"
                sequence="3"/>
    </data>
</odoo>
