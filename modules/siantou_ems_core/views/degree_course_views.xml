<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
	<data>
		<!-- Affichage en vue liste -->
		<record
                id="degree_course_tree_view"
                model="ir.ui.view">
            <field name="name">course.degree.tree.view</field>
			<field name="model">oe.school.course.degree</field>
			<field name="arch" type="xml">
				<tree string="Diplôme réquis" editable="bottom" edit="1">
                    <field name="name"/>
					<field name="cycle_ids" widget="many2many_tags"/>
				</tree>
			</field>
		</record>

        <!-- Action pour le menu d'affichage des Diplôme réquis -->
        <record
                id="action_show_course_degree"
                model="ir.actions.act_window">
            <field name="name">Diplôme requis</field>
            <field name="res_model">oe.school.course.degree</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer une nouveau diplôme académie.
                </p>
            </field>
        </record>

        <!-- Menu pour les Diplôme réquis -->
        <menuitem
                id="menu_siantou_ems_core_config_course_degree"
                name="Diplôme réquis"
                parent="menu_siantou_ems_core_configuration"
                action="action_show_course_degree"
                groups="siantou_ems_core.group_degree_required_user,siantou_ems_core.group_degree_required_admin,base.group_system"
                sequence="7"/>
	</data>
</odoo>