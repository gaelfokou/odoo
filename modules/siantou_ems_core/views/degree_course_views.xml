<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
        <!-- Action pour le menu d'affichage des Diplômes requis -->
        <record
                id="action_show_course_degree"
                model="ir.actions.act_window">
            <field name="name">Diplômes requis</field>
            <field name="res_model">oe.school.course.degree</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer une nouveau diplôme requis.
                </p>
            </field>
        </record>

        <!-- Action pour le menu d'affichage des Diplômes disponibles -->
        <record
                id="action_show_course_degree_availability"
                model="ir.actions.act_window">
            <field name="name">Diplômes disponibles</field>
            <field name="res_model">hr.education.diplome.availability</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer une nouveau diplôme disponible.
                </p>
            </field>
        </record>

        <!-- Menu pour les Diplômes requis -->
        <menuitem
                id="menu_siantou_ems_core_config_course_degree"
                name="Diplômes requis"
                parent="menu_siantou_ems_core_configuration"
                action="action_show_course_degree"
                groups="siantou_ems_core.group_degree_required_user,siantou_ems_core.group_degree_required_admin,base.group_system"
            sequence="7"/>
        <menuitem
                id="menu_siantou_ems_core_config_course_degree_availability"
                name="Diplômes disponibles"
                parent="menu_siantou_ems_core_configuration"
                action="action_show_course_degree_availability"
                groups="siantou_ems_core.group_degree_required_user,siantou_ems_core.group_degree_required_admin,base.group_system"
            sequence="7"/>
	</data>
</odoo>