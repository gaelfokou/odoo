<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="enrollment_history_tree_view" model="ir.ui.view">
        <field name="name">enrollment.history.tree.view</field>
        <field name="model">oe.school.student.enrollment</field>
        <field name="arch" type="xml">
            <tree string="Etudiants" default_order="id desc" default_group_by="year_id" expand="context.get('expand', False)">
                <field name="date_preins" widget="datetime"/>
                <field name="matricule"/>
                <field name="code_enrol"/>
                <field name="name"/>
                <field name="cycle_id"/>
                <field name="field_of_study_id"/>
                <field name="specialty_id"/>
                <field name="level_id"/>
                <field name="type_cour"/>
                <field 
                    name="status_univ" 
                    widget="badge"
                    decoration-success="status_univ == 'new'"
                    decoration-warning="status_univ == 'red'"
                />
                <field 
                    name="status" 
                    widget="badge" 
                    decoration-primary="status == 'broui'"
                    decoration-success="status == 'transfer'"
                    decoration-info="status == 'inscrip'"
                    decoration-danger="status == 'rej'"
                />
            </tree>
        </field>
    </record>

    <record id="enrollment_history_form_view" model="ir.ui.view">
		<field name="name">oe.school.student.enrollment.form.view</field>
		<field name="model">oe.school.student.enrollment</field>
		<field name="arch" type="xml">
			<form string="Etudiant">
                <header>
                    <!-- <button 
                        invisible="status in ['inscrip','transfer','rej']" 
                        name="action_preinscrip_wizard"
                        class="btn btn-primary" 
                        type="object" 
                        string="Encaisser les frais d'inscription"
                    /> -->
                    <button 
                        invisible="status in ['transfer','rej']" 
                        name="action_admission_enrollment_wizard" 
                        class="btn btn-success"
                        type="object" 
                        string="Accepter cette candidature"
                    />
                    <button 
                        invisible="status in ['transfer', 'rej']"
                        name="compute_rejected" 
                        class="btn btn-danager" 
                        type="object" 
                        string="Rejeter cette candidature"
                    />
                    <!-- <button 
                        class="btn btn-warning" 
                        name="print_payement_student" 
                        invisible="status in ['broui']" 
                        type="object" 
                        icon="fa-print"
                        string="Imprimer le reçu" 
                        data-hotkey="F"
                    /> -->
                    <field name="status" widget="statusbar" statusbar_visible="broui,inscrip,transfer"/>
                </header>
                <sheet>
                    <widget 
                        name="web_ribbon" 
                        title="Admis" 
                        invisible="status in ['broui', 'inscrip', 'rej']"
                    />
                    <widget 
                        name="web_ribbon" 
                        bg_color="bg-danger" 
                        title="Refusé" 
                        invisible="status in ['broui', 'inscrip', 'transfer']"
                    />
                    <div class="oe_title">
                        <label for="name" string="Nom(s) et prénom(s)"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <div class="oe_title">
                        <label for="date_preins" string="Date de préinscription"/>
                        <h1><field name="date_preins" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field 
                                name="status" 
                                widget="badge" 
                                decoration-primary="status == 'broui'"
                                decoration-success="status == 'transfer'"
                                decoration-info="status == 'inscrip'"
                            />
                            <!-- <field 
                                name="status"
                            /> -->
                        </group>
                        <group>
                            <field name="code_enrol" readonly="1"/>
                        </group>
                        <group>
                            <field name="registre_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="info_ge" string="Informations générales">
                            <group name="perso">
                                <group>
                                    <field name="date_naissance"/>
                                </group>
                                <group>
                                    <field name="lieu_naissance"/>
                                </group>
                                <group>
                                    <field name="sexe"  widget="radio"/>
                                </group>
                                <group>
                                    <field name="situat_matri"  widget="radio"/>
                                </group>
                                <group>
                                    <field name="nationalite" invisible="is_autre_pays==True"/>
                                    <field name="country_id_pk" invisible="1"/>
                                    <field name="autre"/>
                                    <field name="is_autre_pays" invisible="1"/>
                                </group>
                                <group>
                                    <field name="region_id" domain="[('country_id','=',country_id_pk)]"/>
                                    <field name="region_id_pk" invisible="1"/>
                                </group>
                                <group>
                                    <field name="city_id" domain="[('region_id','=',region_id_pk)]"/>
                                    <field name="city_id_pk" invisible="1"/>
                                </group>
                                <group>
                                    <field name="quarter_id" domain="[('city_id','=',city_id_pk)]"/>
                                </group>
                                <group>
                                    <field name="lieu_residence"/>
                                </group>
                                <group>
                                    <field name="email" widget="email"/>
                                </group>
                                <group>
                                    <field name="num_tel" widget="phone"/>
                                </group>
                            </group>
                        </page>
                    
                        <page name="info_ac" string="Informations académiques">
                            <group  name="academique">
                                <group invisible="status_univ=='new'">
                                    <field name="matricule"/>
                                </group>
                                <group>
                                    <field name="status_univ"/>
                                </group>
                                <group>
                                    <field name="cycle_id"/>
                                    <field name="cycle_id_pk" invisible="1"/>
                                </group>
                                <group>
                                    <field name="field_of_study_id" domain="[('cursus_id','=',cycle_id_pk)]"/>
                                    <field name="field_of_study_id_pk" invisible="1"/>
                                </group>
                                <group>
                                    <field name="specialty_id" domain="[('field_of_study_id','=',field_of_study_id_pk)]"/>
                                </group>
                                <group>
                                    <field name="type_cour" widget="radio"/>
                                </group>
                                
                                <group invisible="status_univ=='new'">
                                    <field name="nbre_matiere"/>
                                </group>
                                
                                <group>
                                    <field name="dipl_req_ids" widget="many2many_tags"/>
                                </group>
                                <group>
                                    <field name="session_lieu_obt"/>
                                </group>
                                <group>
                                    <field name="dern_etab_freq"/>
                                </group>
                                <group>
                                    <field name="annee_acad"/>
                                </group>
                                <group>
                                    <field name="level_id"/>
                                </group>
                            </group>
                        </page>
                    
                        <page name="info_tu" string="Informations sur la personne à joindre en cas d'urgence">
                            <group name="tuteur">
                                <group>
                                    <field name="full_name_tutor"/>
                                </group>
                                <group>
                                    <field name="num_tel_tutor" widget="phone"/>
                                </group>
                            </group>
                        </page>

                        <page name="info_raison" string="Raisons d'acceptation ou de rejet de la candidature">
                            <field name="observations"/>
                        </page>

                        <page name="info_file" string="Pièces jointes">
                             <field name="file_ids" widget="many2many_binary">
                                <tree string="Attachments">
                                    <field name="name"/>
                                    <field name="type"/>
                                    <field name="file_size"/>
                                </tree>
                             </field>
                        </page>

                    </notebook>
                    
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                    <field name="activity_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="student_enrollment_search" model="ir.ui.view">
        <field name="name">student_enrollment.search</field>
        <field name="model">oe.school.student.enrollment</field>
        <field name="arch" type="xml">
            <search string="Recherche d'un candidat">
                <field name="matricule"/>
                <field name="code_enrol"/>
                <field name="name"/>
                <field name="type_cour"/>
                <field name="status_univ"/>
                <field name="status"/>
            </search>
        </field>
    </record>
    
    <record model="ir.actions.act_window" id="action_enrollment_history">
        <field name="name">Candidatures</field>
        <field name="res_model">oe.school.student.enrollment</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer une nouvelle candidature.
            </p>
        </field>
    </record>

    <!-- <menuitem name="Préinscription" id="menu_siantou_ems_core_students_preinscription" 
            sequence="1"
            parent="menu_siantou_ems_core_students" 
            action="action_enrollment_history"/> -->

    <menuitem
        id="menu_siantou_ems_core_students_preinscription"
        name="Candidatures"
        parent="menu_siantou_ems_core_adminssions"
        action="action_enrollment_history"
        groups="siantou_ems_core.group_candidature_user,siantou_ems_core.group_candidature_admin,base.group_system"
        sequence="1"
    />
    
</odoo>