<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="enrollment_history_tree_view" model="ir.ui.view">
        <field name="name">enrollment.history.tree.view</field>
        <field name="model">oe.school.student.enrollment</field>
        <field name="arch" type="xml">
            <tree string="Étudiants" default_order="id desc" default_group_by="year_id" expand="context.get('expand', False)">
                <header>
                    <!-- <button name="action_update_all_enrollment" 
                        type="object" 
                        string="Mettre à jour les candidatures et étudiants" 
                        class="oe_highlight"/> -->
                </header>
                <field name="date_preins" widget="datetime"/>
                <field name="code_enrol"/>
                <field name="name"/>
                <field name="cycle_id"/>
                <field name="field_of_study_id"/>
                <field name="specialty_id"/>
                <field name="option_id"/>
                <field name="level_id"/>
                <field name="class_id"/>
                <field name="type_cour"/>
                <field 
                    name="status_univ" 
                    widget="badge"
                    decoration-success="status_univ == 'new'"
                    decoration-warning="status_univ == 'old'"
                />
                <field 
                    name="status" 
                    widget="badge" 
                    decoration-primary="status == 'broui'"
                    decoration-success="status == 'transfer'"
                    decoration-info="status == 'inscrip'"
                    decoration-danger="status == 'rej'"
                />
                <field name="student_id"/>
            </tree>
        </field>
    </record>

    <record id="enrollment_history_form_view" model="ir.ui.view">
		<field name="name">oe.school.student.enrollment.form.view</field>
		<field name="model">oe.school.student.enrollment</field>
		<field name="arch" type="xml">
			<form string="Étudiant">
                <header>
                    <!-- <button 
                        invisible="status in ['inscrip','transfer','rej']" 
                        name="action_preinscrip_wizard"
                        class="btn btn-primary" 
                        type="object" 
                        string="Encaisser les frais d'inscription"
                    /> -->
                    <button 
                        invisible="status in ['transfer','rej']" 
                        name="action_admission_enrollment_wizard" 
                        class="btn btn-success"
                        type="object" 
                        string="Accepter cette candidature"
                    />
                    <button 
                        invisible="status in ['transfer', 'rej']"
                        name="rejected_enrollment" 
                        class="btn btn-danger" 
                        type="object" 
                        string="Rejeter cette candidature"
                    />
                    <!-- <button 
                        class="btn btn-warning" 
                        name="print_payement_student" 
                        invisible="status in ['broui']" 
                        type="object" 
                        icon="fa-print"
                        string="Imprimer le reçu" 
                        data-hotkey="F"
                    /> -->
                    <field name="status" widget="statusbar" statusbar_visible="broui,inscrip,transfer"/>
                </header>
                <sheet>
                    <widget 
                        name="web_ribbon" 
                        title="Admis" 
                        invisible="status in ['broui', 'inscrip', 'rej']"
                    />
                    <widget 
                        name="web_ribbon" 
                        bg_color="bg-danger" 
                        title="Refusé" 
                        invisible="status in ['broui', 'inscrip', 'transfer']"
                    />
                    <div class="oe_title">
                        <label for="name" string="Nom(s) et prénom(s)"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <div class="oe_title">
                        <label for="date_preins" string="Date de préinscription"/>
                        <h1><field name="date_preins" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field 
                                name="status" 
                                widget="badge" 
                                decoration-primary="status == 'broui'"
                                decoration-success="status == 'transfer'"
                                decoration-info="status == 'inscrip'"
                            />
                            <field name="priority"/>
                        </group>
                        <group>
                            <field name="code_enrol" readonly="1"/>
                        </group>
                        <group>
                            <field name="registre_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Informations générales">
                            <group col="4" name="perso" string="Informations générales">
                                <group colspan="2">
                                    <field name="student_id"/>
                                </group>
                            </group>
                        </page>

                        <page string="Informations académiques">
                            <group col="4" name="academique" string="Informations académiques">
                                <group colspan="2">
                                    <field name="status_univ" invisible="status_univ == 'new'"/>
                                    <field name="year_id" options="{'no_create': True}"/>
                                    <field name="school_id" options="{'no_create': True}"/>
                                    <field name="cycle_id" options="{'no_create': True}"/>
                                    <field name="batch_id" options="{'no_create': True}"/>
                                    <field name="field_of_study_id" options="{'no_create': True}"/>
                                    <field name="specialty_id_domain" invisible="1"/>
                                    <field name="specialty_id" options="{'no_create': True}" domain="specialty_id_domain"/>
                                    <field name="option_id" options="{'no_create': True}" domain="[('specialty_id','=',specialty_id)]"/>
                                </group>
                                <group colspan="2">
                                    <field name="level_id_domain" invisible="1"/>
                                    <field name="level_id" options="{'no_create': True}" domain="level_id_domain"/>
                                    <field name="type_cour" widget="radio"/>
                                    <field name="class_id" options="{'no_create': True}" domain="[('field_of_study_id', '=', field_of_study_id), ('specialty_id', '=', specialty_id), ('option_id', '=', option_id), ('level_id', '=', level_id), ('year_id', '=', year_id), ('type_cour', '=', type_cour)]"/>
                                    <field name="nbre_matiere" invisible="status_univ == 'new'"/>
                                    <field name="diplo_requis_ids" widget="many2many_tags"/>
                                    <field name="session_lieu_obt"/>
                                    <field name="dern_etab_freq"/>
                                </group>
                            </group>
                        </page>

                        <page name="info_raison" string="Raisons d'acceptation ou de rejet de la candidature">
                            <field name="observations"/>
                        </page>

                        <page name="info_file" string="Pièces jointes">
                             <field name="file_ids" widget="many2many_binary">
                                <tree string="Attachments">
                                    <field name="name"/>
                                    <field name="type"/>
                                    <field name="file_size"/>
                                </tree>
                             </field>
                        </page>

                    </notebook>

                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="student_enrollment_search" model="ir.ui.view">
        <field name="name">student_enrollment.search</field>
        <field name="model">oe.school.student.enrollment</field>
        <field name="arch" type="xml">
            <search string="Recherche d'un candidat">
                <field name="code_enrol"/>
                <field name="name"/>
                <field name="type_cour"/>
                <field name="status_univ"/>
                <field name="status"/>
            </search>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_enrollment_history">
        <field name="name">Candidatures</field>
        <field name="res_model">oe.school.student.enrollment</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('priority', '=', '1')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer une nouvelle candidature.
            </p>
        </field>
    </record>

    <!-- <menuitem name="Préinscription" id="menu_siantou_ems_core_students_preinscription" 
            sequence="1"
            parent="menu_siantou_ems_core_students" 
            action="action_enrollment_history"/> -->

    <menuitem
        id="menu_siantou_ems_core_students_preinscription"
        name="Candidatures"
        parent="menu_siantou_ems_core_adminssions"
        action="action_enrollment_history"
        groups="siantou_ems_core.group_candidature_admin,base.group_system"
        sequence="1"
    />

</odoo>