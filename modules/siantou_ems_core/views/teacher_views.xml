<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_employee_form_inherit_teacher" model="ir.ui.view">
            <field name="name">view.employee.form.inherit.teacher</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <button name="action_create_employee_user" type="object" string="Créer un compte utilisateur" class="oe_highlight" invisible="user_id.id != False"/>
                </xpath>

                <xpath expr="//field[@name = 'category_ids']" position="after">
                    <group string="Informations personnelles">
                        <field name="last_name"/>
                        <field name="first_name"/>
                        <field name="birthday"/>
                        <field name="other_phone"/>
                        <field name="other_email"/>
                    </group>

                    <group string="Informations académiques pour les enseignants">
                        <field name="is_teacher"/>
                        <field name="is_permanent"/>
                        <field name="identifier"/>
                        <field name="weekly_hours_limit"/>
                    </group>
                </xpath>

                <xpath expr="//notebook[1]" position="inside">
                    <page string="Cours dispensables" name="subjects"
                        invisible="is_teacher == False">
                        <field name="subject_ids"/>
                    </page>
                    <page string="Disponibilité" name="teacher_availability"
                        invisible="is_teacher == False">
                        <field name="teacher_availability_ids">
                            <tree editable="bottom">
                                <field name="employee_id" column_invisible="1"/>
                                <field name="day_of_week"/>
                                <field name="start_time"/>
                                <field name="end_time"/>
                            </tree>
                        </field>
                    </page>
                    <page string="Priorités des cours" name="course_priorities"
                        invisible="is_teacher == False">
                        <field name="subject_priority_ids" domain="[('subject_id', 'in', subject_ids)]" widget="one2many_list">
                            <tree editable="bottom">
                                <field name="subject_id" options="{'no_open': True}"/>
                                <field name="priority"/>
                            </tree>
                        </field>
                    </page>
                    <page string="Emplois de temps" name="emplois_de_temps"
                        invisible="is_teacher == False">
                        <field name="timetable_ids" widget="one2many_list">
                            <tree string="Horaires" delete="false">
                                <field name="subject_id" string="Cours"/>
                                <field name="classroom_id" string="Salle de classe"/>
                                <field name="field_of_study_id" string="Filière"/>
                                <field name="level_id" string="Niveau"/>
                                <field name="semester_id" string="Semestre"/>
                                <field name="day_of_week" string="Jour de la semaine"/>
                                <field name="date" string="Date"/>
                                <field name="start_time" string="Heure de début"/>
                                <field name="end_time" string="Heure de fin"/>
                                <field name="status" string="Statut"/>
                            </tree>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>

        <!-- <record id="view_employee_kanban_inherit_teacher" model="ir.ui.view">
            <field name="name">view.employee.kanban.inherit.teacher</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.hr_kanban_view_employees"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='category_ids']" position="before">
                    <button name="action_create_all_employee_user" type="object" string="Créer les comptes utilisateurs" class="oe_highlight"/>
                </xpath>
            </field>
        </record> -->

        <record id="view_employee_tree_inherit_teacher" model="ir.ui.view">
            <field name="name">view.employee.tree.inherit.teacher</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="action_create_all_employee_user" type="object" string="Créer les comptes utilisateurs" class="oe_highlight"/>
                </xpath>
            </field>
        </record>

        <record id="action_hr_employees_teachers"
            model="ir.actions.act_window">
            <field name="name">Enseignant</field>
            <field name="res_model">hr.employee</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="context">{'default_is_teacher':'True'}</field>
            <field name="domain">[('is_teacher','=','True')]</field>
            <field name="view_ids"
                eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'kanban', 'view_id': ref('hr.hr_kanban_view_employees')}),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('hr.view_employee_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('hr.view_employee_form')})]"/>
        </record>

        <menuitem
                id="menu_siantou_ems_core_employee_teacher"
                name="Enseignants"
                parent="menu_siantou_ems_core_employee"
                action="action_hr_employees_teachers"
                groups="siantou_ems_core.group_teacher_user,siantou_ems_core.group_teacher_admin,base.group_system"
                sequence="10"
            />
    </data>
</odoo>
