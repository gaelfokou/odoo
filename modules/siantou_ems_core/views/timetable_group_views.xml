<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>

        <!-- Vue en mode Liste (Tree) pour TimetableGroup -->
        <record id="view_timetable_group_tree" model="ir.ui.view">
            <field name="name">siantou.ems.timetable.group.tree</field>
            <field name="model">siantou.ems.timetable.group</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="semester_id"/>
                    <field name="is_submit"/>
                    <field name="is_active"/>
					<field name="status" widget="badge"
                        decoration-muted="status == 'pending'"
                        decoration-success="status == 'valid'"
                        decoration-danger="status == 'invalid'"
                        decoration-warning="status == 'draft'"/>
                </tree>
            </field>
        </record>

        <!-- Vue en mode Liste (Tree) pour TimetableGroup -->
        <record id="view_timetable_group_form" model="ir.ui.view">
            <field name="name">siantou.ems.timetable.group.form</field>
            <field name="model">siantou.ems.timetable.group</field>
            <field name="arch" type="xml">
                <form>
                    <header invisible="is_submit == False">
                        <button name="state_pending_timetable_group" class="oe_highlight" invisible="state in ['pending']" string="En attente" type="object"/>
                        <button name="state_valid_timetable_group" class="oe_highlight" invisible="state in ['valid']" string="Valide" type="object"/>
                        <button name="state_invalid_timetable_group" class="oe_highlight" invisible="state in ['invalid']" string="Invalide" type="object"/>
                        <button name="state_draft_timetable_group" class="oe_highlight" invisible="state in ['draft']" string="Brouillon" type="object"/>
                        <field name="state" widget="statusbar" statusbar_visible="pending,valid,invalid,draft"/>
                    </header>
					<sheet>
                        <group>
                            <field name="name" readonly="0"/>
                            <field name="semester_id"/>
                            <field name="is_submit" invisible="1"/>
                            <!-- <field name="group_parent_ids" invisible="is_submit == False" widget="many2many_tags"/> -->
                            <field name="group_parent_ids" invisible="1" widget="many2many_tags"/>
                            <field name="group_child_ids" invisible="is_submit == True" widget="many2many_tags"/>
                            <field name="is_active" invisible="is_submit == True"/>
                            <field name="timetable_ids"/>
                            <!-- <field name="status" invisible="is_submit == False"/> -->
                            <field name="status" invisible="1"/>
                        </group>
					</sheet>
                </form>
            </field>
        </record>

        <!-- Action pour le menu d'affichage des versions -->
        <record
                id="action_timetable_group"
                model="ir.actions.act_window">
            <field name="name">Liste des versions publiées</field>
            <field name="res_model">siantou.ems.timetable.group</field>
            <field name="view_mode">tree,form</field>
            <field name="view_ids"
                eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('view_timetable_group_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_timetable_group_form')})]"/>
            <field name="domain">[('is_submit', '=', False)]</field>
            <field name="context">{'default_is_submit': False, 'default_status': 'valid'}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Liste des versions d'emploi du temps. Vous pouvez uniquement supprimer des versions.
                </p>
            </field>
        </record>

        <menuitem
            id="menu_siantou_ems_timetable_group" 
            name="Versions d'emploi du temps publiées"
            parent="menu_siantou_ems_timetable_planning" 
            action="action_timetable_group" 
            groups="siantou_ems_core.group_timetable_user,siantou_ems_core.group_timetable_admin,base.group_system"
            sequence="2"/>

        <!-- Action pour le menu d'affichage des versions -->
        <record
                id="action_timetable_group_submit"
                model="ir.actions.act_window">
            <field name="name">Liste des versions soumises</field>
            <field name="res_model">siantou.ems.timetable.group</field>
            <field name="view_mode">tree,form</field>
            <field name="view_ids"
                eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('view_timetable_group_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_timetable_group_form')})]"/>
            <field name="domain">[('is_submit', '=', True), ('create_uid', '=', uid)]</field>
            <field name="context">{'default_is_submit': True}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Liste des versions d'emploi du temps soumis. Vous pouvez uniquement supprimer des versions.
                </p>
            </field>
        </record>

        <menuitem
            id="menu_siantou_ems_timetable_group_submit" 
            name="Versions d'emploi du temps soumises"
            parent="menu_siantou_ems_timetable_planning" 
            action="action_timetable_group_submit" 
            groups="siantou_ems_core.group_timetable_user,siantou_ems_core.group_timetable_admin,base.group_system"
            sequence="2"/>
	</data>
</odoo>
