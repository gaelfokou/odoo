<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>

        <!-- Vue en mode Liste (Tree) pour TimetableGroup -->
        <record id="view_timetable_group_tree" model="ir.ui.view">
            <field name="name">siantou.ems.timetable.group.tree</field>
            <field name="model">siantou.ems.timetable.group</field>
            <field name="arch" type="xml">
                <tree editable="bottom">
                    <field name="name"/>
                    <field name="timetables"/>
                    <field name="semester_id"/>
                    <field name="is_active"/>
                </tree>
            </field>
        </record>

        <!-- Action pour le menu d'affichage des versions -->
        <record
                id="action_timetable_group"
                model="ir.actions.act_window">
            <field name="name">Liste des versions</field>
            <field name="res_model">siantou.ems.timetable.group</field>
            <field name="view_mode">tree</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Liste des versions d'emploi du temps. Vous pouvez uniquement supprimer des versions.
                </p>
            </field>
        </record>

        <menuitem
            id="menu_siantou_ems_timetable_group" 
            name="Versions d'emploi du temps"
            parent="menu_siantou_ems_timetable_planning" 
            action="action_timetable_group" 
            groups="siantou_ems_core.group_timetable_user,siantou_ems_core.group_timetable_admin,base.group_system"
            sequence="2"/>

	</data>
</odoo>