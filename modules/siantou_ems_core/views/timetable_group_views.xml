<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>

        <!-- Vue en mode Liste (Tree) pour TimetableGroup -->
        <record id="view_timetable_group_tree" model="ir.ui.view">
            <field name="name">siantou.ems.timetable.group.tree</field>
            <field name="model">siantou.ems.timetable.group</field>
            <field name="arch" type="xml">
                <tree>
                    <header>
                        <button name="action_open_copier" 
                            type="object" 
                            string="Copier" 
                            class="oe_highlight" 
                            display="always"/>
                    </header>
                    <field name="name"/>
                    <field name="semester_id"/>
                    <field name="expiry_date"/>
                    <field name="is_submit"/>
                    <field name="is_active"/>
					<field name="status" widget="badge"
                        decoration-muted="status == 'pending'"
                        decoration-success="status == 'valid'"
                        decoration-danger="status == 'invalid'"
                        decoration-warning="status == 'draft'"/>
                </tree>
            </field>
        </record>

        <!-- Vue en mode Liste (Tree) pour TimetableGroup -->
        <record id="view_timetable_group_tree_submit" model="ir.ui.view">
            <field name="name">siantou.ems.timetable.group.tree</field>
            <field name="model">siantou.ems.timetable.group</field>
            <field name="arch" type="xml">
                <tree>
                    <header>
                        <button name="action_open_copier_submit" 
                            type="object" 
                            string="Copier" 
                            class="oe_highlight" 
                            display="always"/>
                    </header>
                    <field name="name"/>
                    <field name="semester_id"/>
                    <field name="expiry_date"/>
                    <field name="is_submit"/>
                    <field name="is_active"/>
					<field name="status" widget="badge"
                        decoration-muted="status == 'pending'"
                        decoration-success="status == 'valid'"
                        decoration-danger="status == 'invalid'"
                        decoration-warning="status == 'draft'"/>
                </tree>
            </field>
        </record>

        <!-- Vue en mode Liste (Tree) pour TimetableGroup -->
        <record id="view_timetable_group_form" model="ir.ui.view">
            <field name="name">siantou.ems.timetable.group.form</field>
            <field name="model">siantou.ems.timetable.group</field>
            <field name="arch" type="xml">
                <form string="Versions d'emploi du temps publiées">
                    <header invisible="is_submit == False">
                        <button name="state_pending_timetable_group" class="oe_highlight" invisible="state in ['pending'] or is_readonly == True" string="En attente" type="object"/>
                        <button name="state_valid_timetable_group" class="oe_highlight" invisible="state in ['valid'] or is_readonly == True" string="Valide" type="object"/>
                        <button name="state_invalid_timetable_group" class="oe_highlight" invisible="state in ['invalid'] or is_readonly == True" string="Invalide" type="object"/>
                        <button name="state_draft_timetable_group" class="oe_highlight" invisible="state in ['draft'] or is_readonly == True" string="Brouillon" type="object"/>
                        <field name="state" widget="statusbar" statusbar_visible="pending,valid,invalid,draft"/>
                    </header>
					<sheet>
                        <group>
                            <field name="is_readonly" invisible="1"/>
                            <field name="name"/>
                            <field name="description" readonly="is_readonly == True"/>
                            <field name="semester_id" readonly="is_readonly == True"/>
                            <field name="is_submit" invisible="1"/>
                            <field name="group_parent_id" invisible="1"/>
                            <field name="group_child_ids" readonly="is_readonly == True" invisible="is_submit == True" widget="many2many_tags"/>
                            <field name="is_active" readonly="is_readonly == True" invisible="is_submit == True"/>
                            <field name="read_user_ids" widget="many2many_tags" readonly="is_readonly == True"/>
                            <field name="write_user_ids" widget="many2many_tags" readonly="is_readonly == True"/>
                            <field name="school_ids" widget="many2many_tags" readonly="is_readonly == True"/>
                            <field name="create_uid"/>
                            <field name="expiry_date" readonly="is_readonly == True"/>
                            <field name="timetable_ids" readonly="is_readonly == True" domain="['|', '&amp;', ('group_id.is_active', '=', True), ('group_id.is_submit', '=', False), '&amp;', ('group_parent_id.is_active', '=', True), ('group_parent_id.is_submit', '=', False)]" widget="one2many_list">
                                <tree edit="1" create="1">
                                    <field name="group_id"/>
                                    <field name="semester_id"/>
                                    <field name="year_id"/>
                                    <field name="school_id"/>
                                    <field name="field_of_study_id"/>
                                    <field name="level_id"/>
                                    <field name="specialty_id"/>
                                    <field name="option_id"/>
                                    <field name="class_id"/>
                                    <field name="class_group_id"/>
                                    <!-- <field name="ue_id"/> -->
                                    <field name="subject_id"/>
                                    <field name="building_id"/>
                                    <field name="classroom_id"/>
                                    <field name="employee_id"/>
                                    <field name="date"/>
                                    <field name="day_of_week"/>
                                    <field name="start_time"/>
                                    <field name="end_time"/>
                                    <field name="status" widget="badge"
                                        decoration-muted="status == 'pending'"
                                        decoration-primary="status == 'progress'"
                                        decoration-success="status == 'present'"
                                        decoration-danger="status == 'absent'"
                                        decoration-info="status in ['permission', 'delay']"
                                        decoration-warning="status == 'exception'"/>
                                </tree>
                            </field>
                            <!-- <field name="status" invisible="is_submit == False"/> -->
                            <field name="status" invisible="1"/>
                        </group>
					</sheet>
                </form>
            </field>
        </record>

        <!-- Vue en mode Liste (Tree) pour TimetableGroup -->
        <record id="view_timetable_group_form_submit" model="ir.ui.view">
            <field name="name">siantou.ems.timetable.group.form</field>
            <field name="model">siantou.ems.timetable.group</field>
            <field name="arch" type="xml">
                <form string="Versions d'emploi du temps soumises">
                    <header invisible="is_submit == False">
                        <button name="state_pending_timetable_group" class="oe_highlight" invisible="state in ['pending'] or is_readonly == True" string="En attente" type="object"/>
                        <button name="state_valid_timetable_group" class="oe_highlight" invisible="state in ['valid'] or is_readonly == True" string="Valide" type="object"/>
                        <button name="state_invalid_timetable_group" class="oe_highlight" invisible="state in ['invalid'] or is_readonly == True" string="Invalide" type="object"/>
                        <button name="state_draft_timetable_group" class="oe_highlight" invisible="state in ['draft'] or is_readonly == True" string="Brouillon" type="object"/>
                        <field name="state" widget="statusbar" statusbar_visible="pending,valid,invalid,draft"/>
                    </header>
					<sheet>
                        <group>
                            <field name="is_readonly" invisible="1"/>
                            <field name="name"/>
                            <field name="description" readonly="is_readonly == True"/>
                            <field name="semester_id" readonly="is_readonly == True"/>
                            <field name="is_submit" invisible="1"/>
                            <field name="group_parent_id" invisible="1"/>
                            <field name="group_child_ids" readonly="is_readonly == True" invisible="is_submit == True" widget="many2many_tags"/>
                            <field name="is_active" readonly="is_readonly == True" invisible="is_submit == True"/>
                            <field name="read_user_ids" widget="many2many_tags" readonly="is_readonly == True"/>
                            <field name="write_user_ids" widget="many2many_tags" readonly="is_readonly == True"/>
                            <field name="school_ids" widget="many2many_tags" readonly="is_readonly == True"/>
                            <field name="create_uid"/>
                            <field name="expiry_date" readonly="is_readonly == True"/>
                            <field name="timetable_ids" readonly="is_readonly == True" domain="['|', '&amp;', ('group_id.is_active', '=', True), ('group_id.is_submit', '=', False), '&amp;', ('group_parent_id.is_active', '=', True), ('group_parent_id.is_submit', '=', False)]" widget="one2many_list">
                                <tree edit="1" create="1">
                                    <field name="group_id"/>
                                    <field name="semester_id"/>
                                    <field name="year_id"/>
                                    <field name="school_id"/>
                                    <field name="field_of_study_id"/>
                                    <field name="level_id"/>
                                    <field name="specialty_id"/>
                                    <field name="option_id"/>
                                    <field name="class_id"/>
                                    <field name="class_group_id"/>
                                    <!-- <field name="ue_id"/> -->
                                    <field name="subject_id"/>
                                    <field name="building_id"/>
                                    <field name="classroom_id"/>
                                    <field name="employee_id"/>
                                    <field name="date"/>
                                    <field name="day_of_week"/>
                                    <field name="start_time"/>
                                    <field name="end_time"/>
                                    <field name="status" widget="badge"
                                        decoration-muted="status == 'pending'"
                                        decoration-primary="status == 'progress'"
                                        decoration-success="status == 'present'"
                                        decoration-danger="status == 'absent'"
                                        decoration-info="status in ['permission', 'delay']"
                                        decoration-warning="status == 'exception'"/>
                                </tree>
                            </field>
                            <!-- <field name="status" invisible="is_submit == False"/> -->
                            <field name="status" invisible="1"/>
                        </group>
					</sheet>
                </form>
            </field>
        </record>

        <!-- Action pour le menu d'affichage des versions -->
        <record
                id="action_timetable_group"
                model="ir.actions.act_window">
            <field name="name">Liste des versions publiées</field>
            <field name="res_model">siantou.ems.timetable.group</field>
            <field name="view_mode">tree,form</field>
            <field name="view_ids"
                eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('view_timetable_group_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_timetable_group_form')})]"/>
            <field name="domain">['|', '&amp;', ('is_submit', '=', False), ('create_uid', '=', uid), '&amp;', '&amp;', ('is_submit', '=', False), ('expiry_date', '&gt;', datetime.date.today()), ('write_user_ids', '=', uid)]</field>
            <field name="context">{'default_is_submit': False, 'default_status': 'valid'}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Liste des versions d'emploi du temps. Vous pouvez uniquement supprimer des versions.
                </p>
            </field>
        </record>

        <menuitem
            id="menu_siantou_ems_timetable_group" 
            name="Versions d'emploi du temps publiées"
            parent="menu_siantou_ems_timetable_planning" 
            action="action_timetable_group" 
            groups="siantou_ems_core.group_timetable_admin,base.group_system"
            sequence="2"/>

        <!-- Action pour le menu d'affichage des versions -->
        <record
                id="action_timetable_group_submit"
                model="ir.actions.act_window">
            <field name="name">Liste des versions soumises</field>
            <field name="res_model">siantou.ems.timetable.group</field>
            <field name="view_mode">tree,form</field>
            <field name="view_ids"
                eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('view_timetable_group_tree_submit')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_timetable_group_form_submit')})]"/>
            <field name="domain">['|', '&amp;', ('is_submit', '=', True), ('create_uid', '=', uid), '&amp;', '&amp;', ('is_submit', '=', True), ('expiry_date', '&gt;', datetime.date.today()), ('write_user_ids', '=', uid)]</field>
            <field name="context">{'default_is_submit': True}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Liste des versions d'emploi du temps soumis. Vous pouvez uniquement supprimer des versions.
                </p>
            </field>
        </record>

        <menuitem
            id="menu_siantou_ems_timetable_group_submit" 
            name="Versions d'emploi du temps soumises"
            parent="menu_siantou_ems_timetable_planning" 
            action="action_timetable_group_submit" 
            groups="siantou_ems_core.group_timetable_admin,base.group_system"
            sequence="2"/>
	</data>
</odoo>
