<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="timetable_filter_wizard" model="ir.ui.view">
            <field name="name">timetable.filter.wizard.form</field>
            <field name="model">timetable.filter.wizard</field>
            <field name="arch" type="xml">
                <form string="Filtre des emplois du temps">
                    <group>
                        <field name="year_id" options="{'no_create': True}"/>
                        <field name="semester_id"/>
                        <field name="group_id" options="{'no_create': True}" domain="['|', '|', ('create_uid', '=', uid), ('read_user_ids', '=', uid), ('write_user_ids', '=', uid)]"/>
                        <field name="school_id_domain" invisible="1"/>
                        <field name="school_id" options="{'no_create': True}" domain="school_id_domain"/>
                        <field name="cycle_id"/>
                        <field name="department_id" options="{'no_create': True}" domain="[('school_id', '=', school_id)]"/>
                        <field name="field_of_study_id" options="{'no_create': True}" domain="[('school_id', '=', school_id), ('cycle_id', '=', cycle_id)]"/>
                        <field name="level_id" options="{'no_create': True}" domain="[('semester_ids', '=', semester_id)]"/>
                        <field name="specialty_id_domain" invisible="1"/>
                        <field name="specialty_id" options="{'no_create': True}" domain="specialty_id_domain"/>
                        <field name="has_option" invisible="1"/>
                        <field name="option_id" invisible="not has_option" options="{'no_create': True}" domain="[('specialty_id', '=', specialty_id)]"/>
                        <field name="type_cour" widget="radio"/>
                        <field name="class_id_domain" invisible="1"/>
                        <field name="class_id" options="{'no_create': True}" domain="class_id_domain"/>
                        <field name="has_group" invisible="1"/>
                        <field name="class_group_id" invisible="not has_group" options="{'no_create': True}" domain="[('class_id', '=', class_id)]"/>
                        <field name="subject_id_domain" invisible="1"/>
                        <field name="subject_id" options="{'no_create': True}" domain="subject_id_domain"/>
                        <field name="building_id" options="{'no_create': True}"/>
                        <field name="classroom_id" options="{'no_create': True}" domain="[('building_id', '=', building_id)]"/>
                        <field name="is_permanent"/>
                        <field name="is_temporary"/>
                        <field name="employee_id_domain" invisible="1"/>
                        <field name="employee_id" options="{'no_create': True}" domain="employee_id_domain"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="start_time"/>
                        <field name="end_time"/>
                        <field name="status"/>
                        <field name="number_of_minute" invisible="not status or status not in ['delay_more_than_or_equal', 'delay_less_than']"/>
                    </group>
                    <footer>
                        <button string="Filtrer" type="object" name="action_filter" class="btn-primary"/>
                        <button string="Pourcentage école" type="object" name="action_print_school_percentage_pdf" class="btn-primary" invisible="school_id or not status" groups="siantou_ems_core.group_timetable_percentage_print_pdf"/>
                        <button string="Pourcentage" type="object" name="action_print_percentage_pdf" class="btn-primary" invisible="not school_id or not status" groups="siantou_ems_core.group_timetable_percentage_print_pdf"/>
                        <button string="Pourcentage comparaison" type="object" name="action_print_compare_percentage_pdf" class="btn-primary" invisible="not school_id or not status" groups="siantou_ems_core.group_timetable_percentage_print_pdf"/>
                        <button string="Pourcentage top 10" type="object" name="action_print_top_percentage_pdf" class="btn-primary" invisible="not school_id or not status" groups="siantou_ems_core.group_timetable_percentage_print_pdf"/>
                        <button string="Pourcentage last 10" type="object" name="action_print_last_percentage_pdf" class="btn-primary" invisible="not school_id or not status" groups="siantou_ems_core.group_timetable_percentage_print_pdf"/>
                        <button string="Pourcentage d'heures permanents" type="object" name="action_print_hours_percentage_pdf" class="btn-primary" invisible="status" groups="siantou_ems_core.group_timetable_percentage_print_pdf"/>
                        <button string="Nombre d'heures et coût" type="object" name="action_print_hours_and_cost_pdf" class="btn-primary" invisible="status" groups="siantou_ems_core.group_timetable_percentage_print_pdf"/>
                        <button string="Annuler" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Define an action to open the form view -->
        <record id="action_filter_timetable_wizard" model="ir.actions.act_window">
            <field name="name">Filtre des emplois du temps</field>
            <field name="res_model">timetable.filter.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="timetable_filter_wizard"/>
        </record>
    </data>
</odoo>