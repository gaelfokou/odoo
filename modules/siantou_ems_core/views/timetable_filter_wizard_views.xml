<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="timetable_filter_wizard" model="ir.ui.view">
            <field name="name">timetable.filter.wizard.form</field>
            <field name="model">timetable.filter.wizard</field>
            <field name="arch" type="xml">
                <form string="Filtre des emplois du temps">
                    <group>
                        <field name="group_id" options="{'no_create': True}" domain="['|', ('is_submit', '=', False), ('is_submit', '=', True)]"/>
                        <field name="semester_id" readonly="1" options="{'no_create': True}"/>
                        <field name="year_id" readonly="1" options="{'no_create': True}"/>
                        <field name="school_id" options="{'no_create': True}"/>
                        <field name="field_of_study_id" options="{'no_create': True}" domain="[('school_id', '=', school_id)]"/>
                        <field name="level_id" options="{'no_create': True}" domain="[('semester_ids', '=', semester_id)]"/>
                        <field name="specialty_id_domain" invisible="1"/>
                        <field name="specialty_id" options="{'no_create': True}" domain="specialty_id_domain"/>
                        <field name="option_id" options="{'no_create': True}" domain="[('specialty_id', '=', specialty_id)]"/>
                        <field name="type_cour" widget="radio"/>
                        <field name="class_id_domain" invisible="1"/>
                        <field name="class_id" options="{'no_create': True}" domain="class_id_domain"/>
                        <field name="subject_id_domain" invisible="1"/>
                        <field name="subject_id" options="{'no_create': True}" domain="subject_id_domain"/>
                        <field name="building_id" options="{'no_create': True}"/>
                        <field name="classroom_id" options="{'no_create': True}" domain="[('building_id', '=', building_id)]"/>
                        <field name="employee_id" options="{'no_create': True}"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="start_time"/>
                        <field name="end_time"/>
                        <field name="status"/>
                    </group>
                    <footer>
                        <button string="Filtrer" type="object" name="action_filter" class="btn-primary"/>
                        <button string="Annuler" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Define an action to open the form view -->
        <record id="action_filter_timetable_wizard" model="ir.actions.act_window">
            <field name="name">Filtre des emplois du temps</field>
            <field name="res_model">timetable.filter.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="timetable_filter_wizard"/>
        </record>
    </data>
</odoo>