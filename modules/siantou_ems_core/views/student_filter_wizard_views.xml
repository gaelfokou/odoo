<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="student_filter_wizard" model="ir.ui.view">
            <field name="name">student.filter.wizard.form</field>
            <field name="model">student.filter.wizard</field>
            <field name="arch" type="xml">
                <form string="Filtre des étudiants">
                    <group>
                        <field name="year_id" options="{'no_create': True}"/>
                        <field name="school_id" options="{'no_create': True}"/>
                        <field name="cycle_id_domain" invisible="1"/>
                        <field name="cycle_id" options="{'no_create': True}" domain="cycle_id_domain"/>
                        <field name="level_id_domain" invisible="1"/>
                        <field name="level_id" options="{'no_create': True}" domain="level_id_domain"/>
                        <field name="type_cour" widget="radio"/>
                        <field name="class_id_domain" invisible="1"/>
                        <field name="class_id" options="{'no_create': True}" domain="class_id_domain"/>
                    </group>
                    <footer>
                        <button string="Filtrer" type="object" name="action_filter" class="btn-primary"/>
                        <button string="Annuler" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Define an action to open the form view -->
        <record id="action_filter_student_wizard" model="ir.actions.act_window">
            <field name="name">Filtre des étudiants</field>
            <field name="res_model">student.filter.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="student_filter_wizard"/>
        </record>
    </data>
</odoo>