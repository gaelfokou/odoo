<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="progress_report_filter_wizard" model="ir.ui.view">
            <field name="name">progress.report.filter.wizard.form</field>
            <field name="model">progress.report.filter.wizard</field>
            <field name="arch" type="xml">
                <form string="Filtre des fiches de progression">
                    <group>
                        <field name="year_id" options="{'no_create': True}"/>
                        <field name="school_id" options="{'no_create': True}"/>
                        <field name="field_of_study_id" options="{'no_create': True}" domain="[('school_id', '=', school_id)]"/>
                        <field name="level_id" options="{'no_create': True}"/>
                        <field name="specialty_id_domain" invisible="1"/>
                        <field name="specialty_id" options="{'no_create': True}" domain="specialty_id_domain"/>
                        <field name="option_id" options="{'no_create': True}" domain="[('specialty_id', '=', specialty_id)]"/>
                        <field name="type_cour" widget="radio"/>
                        <field name="class_id_domain" invisible="1"/>
                        <field name="class_id" options="{'no_create': True}" domain="class_id_domain"/>
                        <field name="subject_id_domain" invisible="1"/>
                        <field name="subject_id" options="{'no_create': True}" domain="subject_id_domain"/>
                        <field name="status"/>
                    </group>
                    <footer>
                        <button string="Filtrer" type="object" name="action_filter" class="btn-primary"/>
                        <button string="Pourcentage" type="object" name="action_print_percentage_pdf" class="btn-primary" invisible="status" groups="siantou_ems_core.group_progress_report_print_pdf"/>
                        <button string="Pourcentage top 10" type="object" name="action_print_top_percentage_pdf" class="btn-primary" invisible="status" groups="siantou_ems_core.group_progress_report_print_pdf"/>
                        <button string="Pourcentage last 10" type="object" name="action_print_last_percentage_pdf" class="btn-primary" invisible="status" groups="siantou_ems_core.group_progress_report_print_pdf"/>
                        <button string="Enseignants" type="object" name="action_print_progress_pdf" class="btn-primary" invisible="not status" groups="siantou_ems_core.group_progress_report_print_pdf"/>
                        <button string="Annuler" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Define an action to open the form view -->
        <record id="action_filter_progress_report_wizard" model="ir.actions.act_window">
            <field name="name">Filtre des classes</field>
            <field name="res_model">progress.report.filter.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="progress_report_filter_wizard"/>
        </record>
    </data>
</odoo>