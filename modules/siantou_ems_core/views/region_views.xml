<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		<!-- Affichage en vue liste -->
		<record
                id="region_tree_view"
                model="ir.ui.view">
            <field name="name">region.tree.view</field>
			<field name="model">siantou.ems.core.region</field>
			<field name="arch" type="xml">
				<tree string="Régions" editable="bottom" edit="1">
                    <field name="name"/>
                    <field name="country_id"/>
				</tree>
			</field>
		</record>

        <!-- Affichage en vue formulaire -->
		<record
                id="region_form_view"
                model="ir.ui.view">
			<field name="name">region.form.view</field>
			<field name="model">siantou.ems.core.region</field>
			<field name="arch" type="xml">
				<form string="Régions">
					<sheet>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="country_id"/>
                        </group>
					</sheet>
				</form>
			</field>
		</record>

        <!-- Affichage en vue recherche -->
         <record
                 id="region_search_view"
                 model="ir.ui.view">
            <field name="name">region.search.view</field>
            <field name="model">siantou.ems.core.region</field>
            <field name="arch" type="xml">
                <search string="Régions">
                    <field name="name" string="Nom du Régions"/>
                    <field name="country_id" string="Nom du pays"/>
                    <separator/>
                </search>
             </field>
        </record>

        <!-- Action pour le menu d'affichage des Régions -->
        <record
                id="action_show_region"
                model="ir.actions.act_window">
            <field name="name">Régions</field>
            <field name="res_model">siantou.ems.core.region</field>
            <field name="search_view_id" ref="region_search_view"/>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer une nouvelle Régions.
                </p>
            </field>
        </record>

        <!-- Menu pour les Régions -->
        <menuitem
            id="menu_siantou_ems_core_config_region"
            name="Régions"
            parent="menu_siantou_ems_core_configuration"
            action="action_show_region"
            groups="siantou_ems_core.group_region_user,siantou_ems_core.group_region_admin,base.group_system"
            sequence="10"
        />
	</data>
</odoo>