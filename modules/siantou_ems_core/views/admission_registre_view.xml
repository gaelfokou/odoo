<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        
        <record id="view_siantou_admission_registre_tree_view" model="ir.ui.view">
            <field name="name">siantou.session.registre.tree.view</field>
            <field name="model">siantou.session.registre</field>
            <field name="arch" type="xml">
                <tree string="Registre d'admission">
                    <field name="name"/>
                    <field name="cycle_id"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="session_id"/>
                    <field name="year_id"/>
                    <!-- <field name="campus" string="Campus"/> -->
                    <!-- <field name="state"/> -->
                </tree>
            </field>
        </record>


		<record
            id="session_registre_form_view"
            model="ir.ui.view">
			<field name="name">siantou.form.view</field>
			<field name="model">siantou.session.registre</field>
			<field name="arch" type="xml">
				<form string="Registre d'admission">
					<sheet>
                        <group>
                            <group>
                                <field name="name"/>
                            </group>
                            <group>
                                <field name="cycle_id"/>
                            </group>
                            <group>
                                <field name="session_id"/>
                            </group>
                            <group>
                                <field name="year_id"/>
                            </group>
                            <!-- <group>
                                <field name="campus"/>
                            </group> -->
                            <group>
                                <field name="start_date"/>
                            </group>
                            <group>
                                <field name="end_date"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Candidatures">
                                <!-- <button name="approve_all" type="object" string="Approuver Tout" class="oe_highlight"/> -->
                                <field name="admission_ids">
                                    <tree string="Candidats">
                                        <field name="code_enrol"/>
                                        <field name="name"/>
                                        <field name="cycle_id"/>
                                        <field name="field_of_study_id"/>
                                        <field name="type_cour"/>
                                        <field name="sexe"/>
                                        <field name="status_univ"/>
                                        <field 
                                            name="status" 
                                            widget="badge" 
                                            decoration-primary="status == 'broui'"
                                            decoration-success="status == 'transfer'"
                                            decoration-info="status == 'inscrip'"
                                        />
                                        <button invisible="status in ['inscrip','transfer','rej']" 
                                            name="action_preinscrip_wizard"
                                            class="btn btn-primary" 
                                            type="object" 
                                            string="Inscrire"/>

                                        <button invisible="status in ['broui','transfer','rej']" 
                                            name="action_admission_enrollment_wizard" 
                                            class="btn btn-success"
                                            type="object" 
                                            string="Accepter cette candidature"/>
                                        
                                        <button  invisible="status in ['broui', 'transfer', 'rej']"
                                            name="compute_rejected" 
                                            class="btn btn-danager" 
                                            type="object" 
                                            string="Rejeter cette candidature"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
					</sheet>
				</form>
			</field>
		</record>

 


        <record model="ir.actions.act_window" id="action_siantou_admission_registre">
            <field name="name">Régistre d'admission</field>
            <field name="res_model">siantou.session.registre</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer une nouveau registre.
                </p>
            </field>
        </record>

        <menuitem
            id="menu_siantou_ems_core_registre_admission"
            name="Registre d'admission"
            parent="menu_siantou_ems_core_adminssions"
            action="action_siantou_admission_registre"
            groups="siantou_ems_core.group_session_registre_user,siantou_ems_core.group_session_registre_admin,base.group_system"
            sequence="3"/>

    </data>
</odoo>
