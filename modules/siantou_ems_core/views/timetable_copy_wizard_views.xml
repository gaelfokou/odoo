<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="timetable_copy_wizard" model="ir.ui.view">
            <field name="name">timetable.copy.wizard.form</field>
            <field name="model">timetable.copy.wizard</field>
            <field name="arch" type="xml">
                <form string="Copie des emplois du temps">
                    <group>
                        <field name="semester_id" options="{'no_create': True}"/>
                        <field name="group_id" options="{'no_create': True}" domain="['|', '|', ('create_uid', '=', uid), ('read_user_ids', '=', uid), ('write_user_ids', '=', uid)]"/>
                        <field name="school_id_domain" invisible="1"/>
                        <field name="school_id" options="{'no_create': True}" domain="school_id_domain"/>
                        <field name="field_of_study_id" options="{'no_create': True}" domain="[('school_id', '=', school_id)]"/>
                        <field name="level_id_domain" invisible="1"/>
                        <field name="level_id" options="{'no_create': True}" domain="level_id_domain"/>
                        <field name="specialty_id_domain" invisible="1"/>
                        <field name="specialty_id" options="{'no_create': True}" domain="specialty_id_domain"/>
                        <field name="option_id" options="{'no_create': True}" domain="[('specialty_id', '=', specialty_id)]"/>
                        <field name="type_cour" widget="radio"/>
                        <field name="source_year_id" options="{'no_create': True}"/>
                        <field name="source_class_id_domain" invisible="1"/>
                        <field name="source_class_id" options="{'no_create': True}" domain="source_class_id_domain"/>
                        <field name="subject_id_domain" invisible="1"/>
                        <field name="subject_id" options="{'no_create': True}" domain="subject_id_domain"/>
                        <field name="source_timetable_ids">
                            <tree>
                                <field name="group_id"/>
                                <field name="semester_id"/>
                                <field name="class_id"/>
                                <field name="class_group_id"/>
                                <field name="subject_id"/>
                                <field name="building_id"/>
                                <field name="classroom_id"/>
                                <field name="employee_id"/>
                                <field name="date"/>
                                <field name="day_of_week"/>
                                <field name="start_time"/>
                                <field name="end_time"/>
                                <field name="status" widget="badge"
                                    decoration-muted="status == 'pending'"
                                    decoration-primary="status == 'progress'"
                                    decoration-success="status == 'present'"
                                    decoration-danger="status == 'absent'"
                                    decoration-info="status in ['permission', 'delay']"
                                    decoration-warning="status == 'exception'"/>
                            </tree>
                        </field>
                        <field name="destination_year_id" options="{'no_create': True}"/>
                        <field name="destination_class_id_domain" invisible="1"/>
                        <field name="destination_class_id" options="{'no_create': True}" domain="destination_class_id_domain"/>
                        <field name="destination_timetable_ids">
                            <tree>
                                <field name="group_id"/>
                                <field name="semester_id"/>
                                <field name="class_id"/>
                                <field name="class_group_id"/>
                                <field name="subject_id"/>
                                <field name="building_id"/>
                                <field name="classroom_id"/>
                                <field name="employee_id"/>
                                <field name="date"/>
                                <field name="day_of_week"/>
                                <field name="start_time"/>
                                <field name="end_time"/>
                                <field name="status" widget="badge"
                                    decoration-muted="status == 'pending'"
                                    decoration-primary="status == 'progress'"
                                    decoration-success="status == 'present'"
                                    decoration-danger="status == 'absent'"
                                    decoration-info="status in ['permission', 'delay']"
                                    decoration-warning="status == 'exception'"/>
                            </tree>
                        </field>
                    </group>
                    <footer>
                        <button string="Copier" type="object" name="action_copy" class="btn-primary" confirm="Êtes-vous sûr de vouloir confirmer la copie ?"/>
                        <button string="Annuler" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Define an action to open the form view -->
        <record id="action_copy_ue_wizard" model="ir.actions.act_window">
            <field name="name">Copie des emplois du temps</field>
            <field name="res_model">timetable.copy.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="timetable_copy_wizard"/>
        </record>
    </data>
</odoo>