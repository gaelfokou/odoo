<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="timetable_group_move_wizard" model="ir.ui.view">
            <field name="name">timetable.group.move.wizard.form</field>
            <field name="model">timetable.group.move.wizard</field>
            <field name="arch" type="xml">
                <form string="Déplacement des versions d'emploi du temps">
                    <group>
                        <field name="is_submit" readonly="1"/>
                        <field name="year_id" options="{'no_create': True}"/>
                        <field name="source_group_id" options="{'no_create': True}" domain="[('is_submit', '=', is_submit), ('semester_id.year_id', '=', year_id)]"/>
                        <field name="school_id_domain" invisible="1"/>
                        <field name="school_id" options="{'no_create': True}" domain="school_id_domain"/>
                        <field name="department_id_domain" invisible="1"/>
                        <field name="department_id" options="{'no_create': True}" domain="department_id_domain"/>
                        <field name="class_id_domain" invisible="1"/>
                        <field name="class_id" options="{'no_create': True}" domain="class_id_domain"/>
                        <field name="destination_group_id_domain" invisible="1"/>
                        <field name="destination_group_id" options="{'no_create': True}" domain="destination_group_id_domain"/>
                    </group>
                    <footer>
                        <button string="Déplacer" type="object" name="action_move" class="btn-primary"/>
                        <button string="Annuler" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Define an action to open the form view -->
        <record id="action_move_timetable_wizard" model="ir.actions.act_window">
            <field name="name">Déplacement des versions d'emploi du temps</field>
            <field name="res_model">timetable.group.move.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="timetable_group_move_wizard"/>
        </record>
    </data>
</odoo>