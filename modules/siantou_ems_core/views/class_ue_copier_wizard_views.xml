<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="class_ue_copier_wizard" model="ir.ui.view">
            <field name="name">class.ue.copier.wizard.form</field>
            <field name="model">class.ue.copier.wizard</field>
            <field name="arch" type="xml">
                <form string="Copieur des unités d'enseignement">
                    <group>
                        <field name="school_id" options="{'no_create': True}"/>
                        <field name="field_of_study_id" options="{'no_create': True}" domain="[('school_id', '=', school_id)]"/>
                        <field name="level_id" options="{'no_create': True}"/>
                        <field name="specialty_id_domain" invisible="1"/>
                        <field name="specialty_id" options="{'no_create': True}" domain="specialty_id_domain"/>
                        <field name="option_id" options="{'no_create': True}" domain="[('specialty_id', '=', specialty_id)]"/>
                        <field name="type_cour" widget="radio"/>
                        <field name="source_year_id" options="{'no_create': True}"/>
                        <field name="source_class_id_domain" invisible="1"/>
                        <field name="source_class_id" options="{'no_create': True}" domain="source_class_id_domain"/>
                        <field name="source_ue_ids"/>
                        <field name="destination_year_id" options="{'no_create': True}"/>
                        <field name="destination_class_id_domain" invisible="1"/>
                        <field name="destination_class_id" options="{'no_create': True}" domain="destination_class_id_domain"/>
                        <field name="destination_ue_ids"/>
                    </group>
                    <footer>
                        <button string="Copier" type="object" name="action_copier" class="btn-primary"/>
                        <button string="Annuler" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Define an action to open the form view -->
        <record id="action_copier_timetable_wizard" model="ir.actions.act_window">
            <field name="name">Copieur des unités d'enseignement</field>
            <field name="res_model">class.ue.copier.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="class_ue_copier_wizard"/>
        </record>
    </data>
</odoo>