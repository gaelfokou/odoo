<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		<!-- Affichage en vue liste -->
		<record
                id="field_of_study_tree_view"
                model="ir.ui.view">
            <field name="name">field_of_study.tree.view</field>
			<field name="model">siantou.ems.core.field_of_study</field>
			<field name="arch" type="xml">
				<tree string="Filières">
                    <field name="code"/>
					<field name="name"/>
                	<field name="school_id"/>
                    <field name="cycle_id"/>
                    <!-- <field name="department_id"/> -->
				</tree>
			</field>
		</record>

        <!-- Affichage en vue formulaire -->
		<record
                id="fieldofstudy_form_view"
                model="ir.ui.view">
			<field name="name">field_of_study.form.view</field>
			<field name="model">siantou.ems.core.field_of_study</field>
			<field name="arch" type="xml">
				<form string="Filières">
					<sheet>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="name"/>
                            </group>
                            <group>
                                <field name="school_id" options="{'no_create': True}"/>
                                <field name="cycle_id" options="{'no_create': True}"/>
                                <!-- <field name="department_id" options="{'no_create': True}" domain="[('school_id', '=', school_id)]"/> -->
                            </group>
                        </group>
                        <notebook>
                            <page name="specialty_ids" string="Spécialités">
                                <field name="specialty_ids">
                                    <tree string="">
                                        <field name="code"/>
                                        <field name="name"/>
                                        <field name="field_of_study_id"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
					</sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
				</form>
			</field>
		</record>

        <!-- Action pour le menu s'affichage des programmes -->
        <record
                id="action_show_field_of_study"
                model="ir.actions.act_window">
            <field name="name">Filières</field>
            <field name="res_model">siantou.ems.core.field_of_study</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer une nouvelle filière.
                </p>
            </field>
        </record>

        <record
                id="action_show_field_of_study_2"
                model="ir.actions.act_window">
            <field name="name">Filières</field>
            <field name="res_model">siantou.ems.core.field_of_study</field>
            <field name="view_mode">tree</field>
            <field name="context">{'create': False, 'edit': False}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer une nouvelle filière.
                </p>
            </field>
        </record>

        <!-- Menu pour la gestion des filières -->
        <menuitem
                id="menu_siantou_ems_core_program_field_of_study"
                name="Filières"
                parent="menu_siantou_ems_core_config_fa"
                action="action_show_field_of_study"
                groups="siantou_ems_core.group_field_of_study_admin,base.group_system"
            sequence="1"/>
        <menuitem
                id="menu_siantou_ems_core_program_field_of_study_2"
                name="Filières"
                parent="menu_siantou_ems_core_program"
                action="action_show_field_of_study_2"
                groups="siantou_ems_core.group_field_of_study_admin,base.group_system"
            sequence="1"/>
	</data>
</odoo>