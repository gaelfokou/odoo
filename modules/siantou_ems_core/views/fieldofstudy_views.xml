<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
	<data>
		<!-- Affichage en vue liste -->
		<record
                id="field_of_study_tree_view"
                model="ir.ui.view">
            <field name="name">field_of_study.tree.view</field>
			<field name="model">siantou.ems.core.field_of_study</field>
			<field name="arch" type="xml">
				<tree string="Filières" editable="bottom" edit="1">
                    <field name="code"/>
					<field name="name"/>
                	<field name="school_id"/>
                    <field name="cursus_id"/>
                    <field name="department_id"/>
				</tree>
			</field>
		</record>

        <!-- Affichage en vue formulaire -->
		<record
                id="fieldofstudy_form_view"
                model="ir.ui.view">
			<field name="name">field_of_study.form.view</field>
			<field name="model">siantou.ems.core.field_of_study</field>
			<field name="arch" type="xml">
				<form string="Filière">
					<sheet>
                        <group string="Informations sur la filière">
                            <field name="code"/>
                            <field name="name"/>
                			<field name="school_id"/>
                            <field name="cursus_id"/>
                            <field name="department_id"/>
                        </group>
						<group string="Cours de la filière">
							<field name="subject_ids"/>
						</group>
					</sheet>
				</form>
			</field>
		</record>

        <!-- Action pour le menu s'affichage des programmes -->
        <record
                id="action_show_field_of_study"
                model="ir.actions.act_window">
            <field name="name">Filière</field>
            <field name="res_model">siantou.ems.core.field_of_study</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer une nouvelle filière.
                </p>
            </field>
        </record>

        <!-- Menu pour la gestion des filières -->
        <menuitem
                id="menu_siantou_ems_core_program_field_of_study"
                name="Filères"
                parent="menu_siantou_ems_core_program"
                action="action_show_field_of_study"
                groups="group_school_manager"
                sequence="1"/>
	</data>
</odoo>