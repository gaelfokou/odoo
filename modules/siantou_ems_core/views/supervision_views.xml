<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
        <!-- Course -->
        <record id="school_course_supervision_tree_view" model="ir.ui.view">
			<field name="name">school.course.supervision.tree.view</field>
			<field name="model">oe.school.course.supervision</field>
			<field name="arch" type="xml">
				<tree string='Tutelles académiques'>
                    <field name="code"/>
					<field name="name"/>
                    <!-- <field name="cycle_ids" widget="many2many_tags"/> -->
				</tree>
			</field>
		</record>
		<record id="school_course_supervision_form_view" model="ir.ui.view">
			<field name="name">school.course.supervision.form.view</field>
			<field name="model">oe.school.course.supervision</field>
			<field name="arch" type="xml">
				<form string='Tutelles académiques'>
					<sheet>
                        <group >
                            <group>
                                <field name="code"/>
                                <field name="name"/>
                                <!-- <field name="cycle_ids" widget="many2many_tags"/> -->
                            </group>
                        </group>
					</sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
				</form>
			</field>
		</record>

        <record id="view_course_supervision_filter" model="ir.ui.view">
            <field name="name">school.course.supervision.search</field>
            <field name="model">oe.school.course.supervision</field>
            <field name="arch" type="xml">
                <search string='Tutelles académiques'>
                    <field name="name" string="Tutelle académique"/>
                </search>
             </field>
        </record>

        <record id="action_show_oe_school_course_supervision" model="ir.actions.act_window">
            <field name="name">Tutelles académiques</field>
            <field name="res_model">oe.school.course.supervision</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_course_supervision_filter"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer une nouvelle filière
                </p><p>
                    Les cours sont utilisés pour inscrire les étudiants.
                </p>
            </field>
        </record>

        <record id="action_show_oe_school_course_supervision_2" model="ir.actions.act_window">
            <field name="name">Tutelles académiques</field>
            <field name="res_model">oe.school.course.supervision</field>
            <field name="view_mode">tree</field>
            <field name="context">{'create': False, 'edit': False}</field>
            <field name="search_view_id" ref="view_course_supervision_filter"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer une nouvelle filière
                </p><p>
                    Les cours sont utilisés pour inscrire les étudiants.
                </p>
            </field>
        </record>

        <menuitem
            id="menu_siantou_ems_core_supervision"
            name="Tutelles académiques"
            parent="menu_siantou_ems_core_config_fa"
            action="action_show_oe_school_course_supervision"
            groups="siantou_ems_core.group_courses_admin,base.group_system"
            sequence="7"/>
        <menuitem
            id="menu_siantou_ems_core_supervision_2"
            name="Tutelles académiques"
            parent="menu_siantou_ems_core_program"
            action="action_show_oe_school_course_supervision_2"
            groups="siantou_ems_core.group_courses_admin,base.group_system"
            sequence="7"/>
    </data>
</odoo>