<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_tree" model="ir.ui.view">
        <field name="name">school.view.tree</field>
        <field name="model">siantou.ems.core.school</field>
        <field name="arch" type="xml">
            <tree string="Écoles">
                <field name="code"/>
                <field name="name"/>
                <field name="description"/>
                <field name="max_students_per_batch"/>
                <field name="building_ids" widget="many2many_tags"/>
                <field name="cycle_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>
    <record id="view_school_form" model="ir.ui.view">
        <field name="name">school.view.form</field>
        <field name="model">siantou.ems.core.school</field>
        <field name="arch" type="xml">
            <form string="Écoles">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h3><field name="name"/></h3>
                    </div>
                    <group>
                        <field name="code"/>
                        <field name="description"/>
                        <field name="max_students_per_batch"/>
                        <field name="building_ids" widget="many2many_tags"/>
                        <field name="cycle_ids" widget="many2many_tags"/>                            
                    </group>
                    <notebook>
                        <page name="department_ids" string="Départements">
                            <field name="department_ids"/>
                        </page>
                        <page name="field_of_study_ids" string="Filières">
                            <field name="field_of_study_ids"/>
                        </page>
                        <page name="student_ids" string="Étudiants">
                            <field name="student_ids"/>
                        </page>
                        <page name="batch_ids" string="Lots">
                            <field name="batch_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_show_school" model="ir.actions.act_window">
        <field name="name">Écoles</field>
        <field name="res_model">siantou.ems.core.school</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
            id="menu_siantou_ems_core_config_school"
            name="Écoles"
            parent="menu_siantou_ems_core_configuration"
            action="action_show_school"
            groups="siantou_ems_core.group_school_admin,base.group_system"
            sequence="2"/>
</odoo>