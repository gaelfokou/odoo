<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="classroom_filter_wizard" model="ir.ui.view">
            <field name="name">classroom.filter.wizard.form</field>
            <field name="model">classroom.filter.wizard</field>
            <field name="arch" type="xml">
                <form string="Filtre des salles de classe">
                    <group>
                        <field name="date"/>
                        <field name="start_time" widget="float_time"/>
                        <field name="end_time" widget="float_time"/>
                        <field name="status"/>
                    </group>
                    <footer>
                        <button string="Filtrer" type="object" name="action_filter" class="btn-primary"/>
                        <button string="Annuler" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Define an action to open the form view -->
        <record id="action_filter_classroom_wizard" model="ir.actions.act_window">
            <field name="name">Filtre des salles de classe</field>
            <field name="res_model">classroom.filter.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="classroom_filter_wizard"/>
        </record>
    </data>
</odoo>