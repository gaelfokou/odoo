<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_exam_score_tree" model="ir.ui.view">
            <field name="name">exam.score.tree</field>
            <field name="model">siantou.ems.core.exam.score</field>
            <field name="arch" type="xml">
                <tree string="Fiches d'examen">
                    <!-- <field name="name"/> -->
                    <field name="year_id"/>
                    <field name="semester_id"/>
                    <field name="class_id"/>
                    <field name="subject_id"/>
                    <field name="exam_type"/>
					<field name="status" widget="badge"
                        decoration-muted="status == 'start'"
                        decoration-primary="status == 'start_write'"
                        decoration-warning="status == 'end_write'"
                        decoration-success="status == 'end'"/>
                    <field name="score_ids"/>
                </tree>
            </field>
        </record>

        <record id="view_exam_score_form" model="ir.ui.view">
            <field name="name">exam.score.form</field>
            <field name="model">siantou.ems.core.exam.score</field>
            <field name="arch" type="xml">
                <form string="Fiche d'examen">
                    <header>
                        <button name="state_start_exam" class="oe_highlight" invisible="state in ['start']" string="Début" type="object"/>
                        <button name="state_start_write_exam" class="oe_highlight" invisible="state in ['start_write']" string="Début saisie" type="object"/>
                        <button name="state_end_write_exam" class="oe_highlight" invisible="state in ['end_write']" string="Fin saisie" type="object"/>
                        <button name="state_end_exam" class="oe_highlight" invisible="state in ['end']" string="Fin" type="object"/>
                        <field name="state" widget="statusbar" statusbar_visible="start,start_write,end_write,end"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="year_id" options="{'no_create': True}"/>
                            <field name="semester_id" options="{'no_create': True}" domain="[('year_id', '=', year_id)]"/>
                            <field name="class_id" options="{'no_create': True}" domain="[('year_id', '=', year_id)]"/>
                            <field name="subject_id_domain" invisible="1"/>
                            <field name="subject_id" options="{'no_create': True}" domain="subject_id_domain"/>
                            <field name="exam_type" widget="radio"/>
                            <field name="status" invisible="1"/>
                            <field name="score_ids" widget="one2many_list">
                                <tree create="0" editable="bottom">
                                    <field name="student_id" invisible="exam_type in ['sn', 'rsn'] and status in ['start_write', 'end_write']"/>
                                    <field name="anonymous" invisible="exam_type not in ['sn', 'rsn']"/>
                                    <field name="score"/>
                                    <field name="note"/>
                                    <field name="exam_type" invisible="1"/>
                                    <field name="status" invisible="1"/>
                                </tree>
                            </field>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="action_exam_score" model="ir.actions.act_window">
            <field name="name">Fiches d'examen</field>
            <field name="res_model">siantou.ems.core.exam.score</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="siantou_menu_exam_score"
                name="Fiches d'examen"
                parent="menu_siantou_ems_core_employee"
                action="action_exam_score"
            sequence="20"/>
    </data>
</odoo>
