<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Affichage en vue liste -->
        <record
                id="progress_report_tree_view"
                model="ir.ui.view">
            <field name="name">progress.report.tree.view</field>
            <field name="model">siantou.ems.core.progress.report</field>
            <field name="arch" type="xml">
                <tree string="Fiches de progression">
                    <field name="class_id"/>
                    <field name="subject_id"/>
                    <field name="session_ids"/>
                </tree>
            </field>
        </record>

        <!-- Affichage en vue formulaire -->
        <record
                id="progress_report_form_view"
                model="ir.ui.view">
            <field name="name">progress.report.form.view</field>
            <field name="model">siantou.ems.core.progress.report</field>
            <field name="arch" type="xml">
                <form string="Fiches de progression">
                    <sheet>
                        <group string="Informations sur la fiche de progression" col="4">
                            <group colspan="2">
                                <field name="class_id"/>
                                <field name="subject_id_domain" invisible="1"/>
                                <field name="subject_id" options="{'no_create': True}" domain="subject_id_domain"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="name" string="Sessions de cours">
                                <field name="session_ids" widget="one2many_list">
                                    <tree create="0" editable="bottom">
                                        <field name="name"/>
                                        <field name="description"/>
                                        <field name="timetable_id"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action pour le menu d'affichage des cours -->
        <record
            id="action_show_progress_report"
            model="ir.actions.act_window">
            <field name="name">Fiches de progression</field>
            <field name="res_model">siantou.ems.core.progress.report</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'group_by': 'class_id'}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer une nouvelle fiche de progression.
                </p>
            </field>
        </record>

        <!-- Menu pour les cours -->
        <menuitem
                id="menu_siantou_ems_core_program_progress_report"
                name="Fiches de progression"
                parent="menu_siantou_ems_core_config_pe"
                action="action_show_progress_report"
                groups="siantou_ems_core.group_subject_user,siantou_ems_core.group_subject_admin,base.group_system"
            sequence="3"/>
        <menuitem
                id="menu_siantou_ems_core_program_progress_report_2"
                name="Fiches de progression"
                parent="menu_siantou_ems_core_program"
                action="action_show_progress_report"
                groups="siantou_ems_core.group_subject_user,siantou_ems_core.group_subject_admin,base.group_system"
            sequence="3"/>
    </data>
</odoo>
