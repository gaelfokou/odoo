<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Affichage en vue liste -->
        <record
                id="subject_session_tree_view"
                model="ir.ui.view">
            <field name="name">subject.session.tree.view</field>
            <field name="model">siantou.ems.core.subject.session</field>
            <field name="arch" type="xml">
                <tree string="Séances de cours">
                    <field name="name"/>
                    <field name="description"/>
                    <field name="timetable_id"/>
                    <field name="report_id"/>
                </tree>
            </field>
        </record>

        <!-- Affichage en vue formulaire -->
        <record
                id="subject_session_form_view"
                model="ir.ui.view">
            <field name="name">subject.session.form.view</field>
            <field name="model">siantou.ems.core.subject.session</field>
            <field name="arch" type="xml">
                <form string="Séances de cours">
                    <sheet>
                        <group string="Informations sur la session de cours" col="4">
                            <group colspan="2">
                                <field name="name"/>
                                <field name="description"/>
                            </group>
                            <group colspan="2">
                                <field name="report_id"/>
                                <field name="timetable_id_domain" invisible="1"/>
                                <field name="timetable_id" options="{'no_create': True}" domain="timetable_id_domain"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action pour le menu d'affichage des cours -->
        <record
            id="action_show_subject_session"
            model="ir.actions.act_window">
            <field name="name">Séances de cours</field>
            <field name="res_model">siantou.ems.core.subject.session</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'group_by': 'report_id'}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer une nouvelle session de cours.
                </p>
            </field>
        </record>

        <record
            id="action_show_subject_session_2"
            model="ir.actions.act_window">
            <field name="name">Séances de cours</field>
            <field name="res_model">siantou.ems.core.subject.session</field>
            <field name="view_mode">tree</field>
            <field name="context">{'group_by': 'report_id', 'create': False, 'edit': False}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer une nouvelle session de cours.
                </p>
            </field>
        </record>

        <!-- Menu pour les cours -->
        <menuitem
                id="menu_siantou_ems_core_program_subject_session"
                name="Séances de cours"
                parent="menu_siantou_ems_core_config_pe"
                action="action_show_subject_session"
                groups="siantou_ems_core.group_subject_user,siantou_ems_core.group_subject_admin,base.group_system"
            sequence="3"/>
        <menuitem
                id="menu_siantou_ems_core_program_subject_session_2"
                name="Séances de cours"
                parent="menu_siantou_ems_core_program"
                action="action_show_subject_session_2"
                groups="siantou_ems_core.group_subject_user,siantou_ems_core.group_subject_admin,base.group_system"
            sequence="3"/>
    </data>
</odoo>
