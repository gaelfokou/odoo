<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
	<data>
		<!-- Affichage en vue liste -->
		<record
                id="classroom_tree_view"
                model="ir.ui.view">
            <field name="name">classroom.tree.view</field>
			<field name="model">siantou.ems.core.building.classroom</field>
			<field name="arch" type="xml">
				<tree string="Salles de classe" editable="bottom" edit="1">
                    <field name="code"/>
					<field name="name"/>
                    <field name="building_id"/>
                    <field name="capacity"/>
				</tree>
			</field>
		</record>

        <!-- Affichage en vue formulaire -->
		<record
                id="classroom_form_view"
                model="ir.ui.view">
			<field name="name">classroom.form.view</field>
			<field name="model">siantou.ems.core.building.classroom</field>
			<field name="arch" type="xml">
				<form string="Salle de classe">
					<sheet>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="building_id"/>
                            <field name="capacity"/>
                        </group>
					</sheet>
				</form>
			</field>
		</record>

        <!-- Action pour le menu d'affichage des programmes -->
        <record
                id="action_show_classroom"
                model="ir.actions.act_window">
            <field name="name">Salle de classe</field>
            <field name="res_model">siantou.ems.core.building.classroom</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer une nouvelle salle de classe.
                </p>
            </field>
        </record>

        <!-- Menu pour la gestion des filières -->
        <menuitem
                id="menu_siantou_ems_core_classroom"
                name="Salles de classe"
                parent="menu_siantou_ems_core_config"
                action="action_show_classroom"
                sequence="6"/>
	</data>
</odoo>