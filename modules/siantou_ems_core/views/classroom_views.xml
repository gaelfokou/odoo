<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Vue liste -->
        <record id="classroom_tree_view" model="ir.ui.view">
            <field name="name">classroom.tree.view</field>
            <field name="model">siantou.ems.core.building.classroom</field>
            <field name="arch" type="xml">
                <tree string="Salles de classe">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="building_id"/>
                    <field name="capacity"/>
                    <field name="is_cours_active"/>
                    <field name="is_examen_active"/>
                </tree>
            </field>
        </record>

        <!-- Vue formulaire détaillée -->
        <record id="classroom_form_view_detailed" model="ir.ui.view">
            <field name="name">classroom.form.view.detailed</field>
            <field name="model">siantou.ems.core.building.classroom</field>
            <field name="arch" type="xml">
                <form string="Salle de classe">
                    <sheet>
                        <!-- Onglets pour organiser les informations -->
                        <notebook>
                            <page string="Informations générales">
                                <group>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="building_id"/>
                                    <field name="capacity"/>
                                    <field name="is_cours_active"/>
                                    <field name="is_examen_active"/>
                                </group>
                            </page>
                            <page string="Horaires associés">
                                <field name="timetable_ids" widget="one2many_list">
                                    <tree string="Horaires" delete="false">
                                        <field name="subject_id" string="Cours"/>
                                        <field name="employee_id" string="Enseignant"/>
                                        <field name="field_of_study_id" string="Filière"/>
                                        <field name="level_id" string="Niveau"/>
                                        <field name="semester_id" string="Semestre"/>
                                        <field name="day_of_week" string="Jour de la semaine"/>
                                        <field name="date" string="Date"/>
                                        <field name="start_time" string="Heure de début"/>
                                        <field name="end_time" string="Heure de fin"/>
                                        <field name="status" string="Statut"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action pour afficher la liste et le formulaire -->
        <record id="action_show_classroom" model="ir.actions.act_window">
            <field name="name">Salle de classe</field>
            <field name="res_model">siantou.ems.core.building.classroom</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="classroom_tree_view"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer une nouvelle salle de classe.
                </p>
            </field>
        </record>

        <!-- Menu pour accéder aux salles de classe -->
        <menuitem
            id="menu_siantou_ems_core_classroom"
            name="Salles de classe"
            parent="menu_siantou_ems_core_configuration"
            action="action_show_classroom"
            groups="siantou_ems_core.group_classroom_user,siantou_ems_core.group_classroom_admin,base.group_system"
            sequence="6"/>
    </data>
</odoo>
