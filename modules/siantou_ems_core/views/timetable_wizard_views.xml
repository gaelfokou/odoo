<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="timetable_wizard_form_view" model="ir.ui.view">
            <field name="name">timetable_wizard.form.view</field>
            <field name="model">siantou.ems.timetable.timetable_wizard</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="semester_id"/>
                            <field name="level_id"/>
                            <field name="field_of_study_id"/>
                            <field name="class_id" domain="[('niveau_id', '=', level_id), ('filiere_id', '=', field_of_study_id)]"/>
                            <field name="period_from"/>
                            <field name="period_to"/>
                            <field name="group"/>
                            <field name="is_merge"/>
                        </group>
                        <footer>
                            <button name="generate_timetable" string="Générer l'emploi du temps" type="object" class="btn-primary"/>
                            <button string="Annuler" class="btn-secondary" special="cancel"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Define an action to open the form view -->
        <record id="action_generatetimetable_wizard" model="ir.actions.act_window">
            <field name="name">Génération automatique de l'emploi du temps</field>
            <field name="res_model">siantou.ems.timetable.timetable_wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="timetable_wizard_form_view"/>
        </record>

    </data>
</odoo>