<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="admis_history_tree_view" model="ir.ui.view">
        <field name="name">studnt.tree.view</field>
        <field name="model">oe.school.student</field>
        <field name="arch" type="xml">
            <tree string="Etudiants" default_order="id desc">
                <button name="action_create_all_student_user" 
                        type="object" 
                        string="Créer un compte utilisateur" 
                        class="oe_highlight"/>
                <field name="matricule"/>
                <field name="name"/>
                <field name="cycle_id"/>
                <field name="field_of_study_id"/>
                <field name="specialty_id"/>
                <field name="type_cour"/>
                <field 
                    name="status_univ" 
                    widget="badge"
                    decoration-success="status_univ == 'new'"
                    decoration-warning="status_univ == 'red'"
                />
            </tree>
        </field>
    </record>

     <record id="admis_history_form_view" model="ir.ui.view">
        <field name="name">oe.school.student.form.view</field>
        <field name="model">oe.school.student</field>
        <field name="arch" type="xml">
            <form string="Etudiant">
                <header>
                    <button name="action_create_student_user" 
                            type="object" 
                            string="Créer un compte utilisateur" 
                            class="oe_highlight" 
                            invisible="user_id.id"/>
                </header>
                <sheet>
                    <field name="user_id" invisible="1"/>
                    <div class="oe_title">
                        <label for="name" string="Nom(s) et prénom(s)" />
                        <h1><field name="name"/></h1>
                    </div>
                    
                    <!-- Informations générales en vue page -->
                    <notebook>
                        <page string="Informations générales">
                            <group name="perso" string="Informations générales">
                                <group>
                                    <field name="status_univ"/>
                                </group>
                                <group>
                                    <field name="annee_acad_current"/>
                                </group>
                                <group>
                                    <field name="date_naissance"/>
                                </group>
                                <group>
                                    <field name="lieu_naissance"/>
                                </group>
                                <group>
                                    <field name="sexe"  widget="radio"/>
                                </group>
                                <group>
                                    <field name="situat_matri"  widget="radio"/>
                                </group>
                                <group>
                                    <field name="nationalite" invisible="is_autre_pays==True"/>
                                    <field name="autre"/>
                                    <field name="is_autre_pays" invisible="1"/>
                                </group>
                                <group>
                                    <field name="region_id"/>
                                </group>
                                <group>
                                    <field name="city_id"/>
                                </group>
                                <group>
                                    <field name="quarter_id"/>
                                </group>
                                <group>
                                    <field name="lieu_residence"/>
                                </group>
                                <group>
                                    <field name="email" widget="email"/>
                                </group>
                                <group>
                                    <field name="num_tel" widget="phone"/>
                                </group>
                            </group>
                        </page>

                        <!-- Informations académiques en vue page -->
                        <page string="Informations académiques">
                            <group col="4" name="academique" string="Informations académiques">
                                <group colspan="2">
                                    <field name="matricule"/>
                                    <field name="student_enroll_id"/>
                                    <field name="class_id"/>
                                    <field name="cycle_id"/>
                                    <field name="batch_id"/>
                                </group>
                                <group colspan="2">
                                    <field name="field_of_study_id"/>
                                    <field name="specialty_id"/>
                                    <field name="type_cour" widget="radio"/>
                                    <field name="level_id"/>
                                </group>
                            </group>
                        </page>

                        <!-- Informations sur l'emplois de temps en vue page -->
                        <page string="Emplois de temps">
                        
                            <field name="timetable_ids">
                                <tree string="Emplois du temps">
                                    <field name="subject_id" string="Cours"/>
                                    <field name="classroom_id" string="Salle de classe"/>
                                    <field name="employee_id" string="Enseignant"/>
                                    <field name="field_of_study_id" string="Filière"/>
                                    <field name="level_id" string="Niveau"/>
                                    <field name="semester_id" string="Semestre"/>
                                    <field name="day_of_week" string="Jour de la semaine"/>
                                    <field name="date" string="Date"/>
                                    <field name="start_time" string="Heure de début"/>
                                    <field name="end_time" string="Heure de fin"/>
                                    <field name="status" string="Statut"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                    <field name="activity_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="student_search" model="ir.ui.view">
        <field name="name">student.search</field>
        <field name="model">oe.school.student</field>
        <field name="arch" type="xml">
            <search string="Recherche d'un etudiant">
                <field name="matricule"/>
                <field name="name"/>
                <field name="type_cour"/>
                <field name="status_univ"/>
            </search>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_admis_history">
        <field name="name">Etudiants</field>
        <field name="res_model">oe.school.student</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer un nouveau étudiant.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_siantou_ems_core_students_student"
        name="Etudiants"
        parent="menu_siantou_ems_core_students"
        action="action_admis_history"
        groups="siantou_ems_core.group_student_user,siantou_ems_core.group_student_admin,base.group_system"
        sequence="2"
    />

</odoo>