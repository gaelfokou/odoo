<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--Biometric device configuration tree view-->
        <record id="biometric_device_details_view_tree_inherit" model="ir.ui.view">
            <field name="name">biometric.device.details.view.tree</field>
            <field name="model">biometric.device.details</field>
            <field name="inherit_id" ref="hr_zk_attendance.biometric_device_details_view_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='port_number']" position="after">
                    <field name="is_next_execution"/>
                    <field name="is_active"/>
                </xpath>
            </field>
        </record>
        <!--Biometric device configuration tree view-->
        <record id="biometric_device_details_view_form_inherit" model="ir.ui.view">
            <field name="name">biometric.device.details.view.form</field>
            <field name="model">biometric.device.details</field>
            <field name="inherit_id" ref="hr_zk_attendance.biometric_device_details_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[1]/field[@name='port_number']" position="after">
                    <field name="is_next_execution"/>
                    <field name="is_active"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
