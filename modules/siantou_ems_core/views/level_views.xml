<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		<!-- Affichage en vue liste -->
		<record
                id="level_tree_view"
                model="ir.ui.view">
            <field name="name">level.tree.view</field>
			<field name="model">siantou.ems.core.level</field>
			<field name="arch" type="xml">
				<tree string="Niveaux" editable="bottom" edit="1">
                    <field name="name"/>
                    <field name="cycle_ids" widget="many2many_tags"/>
					<field name="description"/>
					<field name="semester_ids" widget="many2many_tags"/>
				</tree>
			</field>
		</record>

        <!-- Affichage en vue formulaire -->
		<record
                id="level_form_view"
                model="ir.ui.view">
			<field name="name">level.form.view</field>
			<field name="model">siantou.ems.core.level</field>
			<field name="arch" type="xml">
				<form string="Niveaux">
					<sheet>
                        <group string="Informations sur le niveau">
                            <field name="name"/>
                            <field name="cycle_ids" widget="many2many_tags"/>
                            <field name="description"/>
                            <field name="semester_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="start_time"/>
                                    <field name="end_time"/>
                                    <field name="year_id"/>
                                </tree>
                            </field>
                        </group>
					</sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
				</form>
			</field>
		</record>

        <!-- Action pour le menu s'affichage des programmes -->
        <record
                id="action_show_level"
                model="ir.actions.act_window">
            <field name="name">Niveau</field>
            <field name="res_model">siantou.ems.core.level</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer un nouveau niveau.
                </p>
            </field>
        </record>

        <record
                id="action_show_level_2"
                model="ir.actions.act_window">
            <field name="name">Niveau</field>
            <field name="res_model">siantou.ems.core.level</field>
            <field name="view_mode">tree</field>
            <field name="context">{'create': False, 'edit': False}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer un nouveau niveau.
                </p>
            </field>
        </record>

        <!-- Menu pour la gestion des filières -->
        <menuitem
                id="menu_siantou_ems_core_program_level"
                name="Niveaux"
                parent="menu_siantou_ems_core_config_fa"
                action="action_show_level"
                groups="siantou_ems_core.group_level_admin,base.group_system"
            sequence="2"/>
        <menuitem
                id="menu_siantou_ems_core_program_level_2"
                name="Niveaux"
                parent="menu_siantou_ems_core_program"
                action="action_show_level_2"
                groups="siantou_ems_core.group_level_admin,base.group_system"
            sequence="2"/>
	</data>
</odoo>