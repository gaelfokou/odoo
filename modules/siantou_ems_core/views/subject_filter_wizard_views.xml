<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="subject_filter_wizard" model="ir.ui.view">
            <field name="name">subject.filter.wizard.form</field>
            <field name="model">subject.filter.wizard</field>
            <field name="arch" type="xml">
                <form string="Filtre des cours">
                    <group>
                        <field name="year_id" options="{'no_create': True}"/>
                        <field name="school_id" options="{'no_create': True}"/>
                        <field name="field_of_study_id" options="{'no_create': True}" domain="[('school_id', '=', school_id)]"/>
                        <field name="level_id" options="{'no_create': True}"/>
                        <field name="specialty_id_domain" invisible="1"/>
                        <field name="specialty_id" options="{'no_create': True}" domain="specialty_id_domain"/>
                        <field name="option_id" options="{'no_create': True}" domain="[('specialty_id', '=', specialty_id)]"/>
                        <field name="type_cour" widget="radio"/>
                        <field name="class_id" options="{'no_create': True}" domain="[('field_of_study_id', '=', field_of_study_id), ('specialty_id', '=', specialty_id), ('option_id', '=', option_id), ('level_id', '=', level_id), ('year_id', '=', year_id), ('type_cour', '=', type_cour)]"/>
                    </group>
                    <footer>
                        <button string="Filtrer" type="object" name="action_filter" class="btn-primary"/>
                        <button string="Annuler" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Define an action to open the form view -->
        <record id="action_filter_subject_wizard" model="ir.actions.act_window">
            <field name="name">Filtre des cours</field>
            <field name="res_model">subject.filter.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="subject_filter_wizard"/>
        </record>

