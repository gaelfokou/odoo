<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
        <!-- Affichage en vue liste -->
		<record
                id="timetable_exception_tree_view"
                model="ir.ui.view">
            <field name="name">timetable.exception.tree.view</field>
			<field name="model">siantou.ems.timetable.timetable</field>
			<field name="arch" type="xml">
				<tree create="0" string="Exceptions d'emploi du temps">
                    <header>
                        <button name="action_present_timetable" 
                                type="object" 
                                string="Présent" 
                                class="oe_highlight"/>
                        <button name="action_absent_timetable" 
                                type="object" 
                                string="Absent" 
                                class="oe_highlight"/>
                        <button name="action_delay_timetable" 
                                type="object" 
                                string="Retardataire" 
                                class="oe_highlight"/>
                    </header>
                    <field name="group_id"/>
                    <field name="semester_id"/>
                    <field name="year_id"/>
                    <field name="school_id"/>
                    <field name="cycle_id"/>
                    <field name="department_id"/>
                    <field name="field_of_study_id"/>
                    <field name="level_id"/>
                    <field name="specialty_id"/>
                    <field name="option_id"/>
                    <field name="class_id"/>
                    <field name="class_group_id"/>
                    <!-- <field name="ue_id"/> -->
					<field name="subject_id"/>
					<field name="building_id"/>
					<field name="classroom_id"/>
					<field name="employee_id"/>
                    <field name="date"/>
					<field name="day_of_week"/>
					<field name="start_time"/>
					<field name="end_time"/>
					<field name="status" widget="badge"
                        decoration-muted="status == 'pending'"
                        decoration-primary="status == 'progress'"
                        decoration-success="status == 'present'"
                        decoration-danger="status == 'absent'"
                        decoration-info="status in ['permission', 'delay']"
                        decoration-warning="status == 'exception'"/>
				</tree>
			</field>
		</record>

        <record id="timetable_exception_search_view" model="ir.ui.view">
            <field name="name">timetable.exception.search.view</field>
            <field name="model">siantou.ems.timetable.timetable</field>
            <field name="arch" type="xml">
                <search>
                    <field name="group_id"/>
                    <field name="semester_id"/>
                    <field name="year_id"/>
                    <field name="school_id"/>
                    <field name="cycle_id"/>
                    <field name="department_id"/>
                    <field name="field_of_study_id"/>
                    <field name="level_id"/>
                    <field name="specialty_id"/>
                    <field name="option_id"/>
                    <field name="class_id"/>
                    <field name="class_group_id"/>
                    <!-- <field name="ue_id"/> -->
					<field name="subject_id"/>
					<field name="building_id"/>
					<field name="classroom_id"/>
					<field name="employee_id"/>
                    <field name="date"/>
					<field name="day_of_week"/>
					<field name="start_time"/>
					<field name="end_time"/>
					<field name="status"/>
                    <filter string="Mon emploi du temps" name="myexceptiontimetable" domain="[('employee_id.user_id', '=', uid)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Filière" name="field_of_study" context="{'group_by': 'field_of_study_id'}"/>
                        <filter string="Niveau" name="level" context="{'group_by': 'level_id'}"/>
                        <filter string="Classe" name="class" context="{'group_by': 'class_id'}"/>
                        <filter string="Spécialité" name="specialty" context="{'group_by': 'specialty_id'}"/>
                        <filter string="Option" name="option" context="{'group_by': 'option_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action pour le menu d'affichage des années académiques -->
        <record
                id="action_show_timetable_exception"
                model="ir.actions.act_window">
            <field name="name">Exceptions d'emploi du temps</field>
            <field name="res_model">siantou.ems.timetable.timetable</field>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="timetable_exception_tree_view"/>
            <field name="domain">['|', '&amp;', '&amp;', ('group_id.is_active', '=', True), ('group_id.is_submit', '=', False), ('group_id.status', '=', 'valid'), '&amp;', '&amp;', '&amp;', ('group_parent_id.is_active', '=', True), ('group_parent_id.is_submit', '=', False), ('group_parent_id.status', '=', 'valid'), ('group_id.status', '=', 'valid'), ('status', '=', 'exception')]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Exceptions.
                </p>
            </field>
            <field name="search_view_id" ref="timetable_exception_search_view"/>
        </record>

        <menuitem
            id="menu_timetable_exception"
            name="Exceptions d'emploi du temps"
            parent="menu_siantou_ems_timetable_planning"
            action="action_show_timetable_exception"
            groups="siantou_ems_core.group_timetable_admin,base.group_system"
            sequence="3"/>
	</data>
</odoo>