<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
	<data>
        <!-- Affichage en vue liste -->
		<record
                id="timetable_exception_tree_view"
                model="ir.ui.view">
            <field name="name">timetable.exception.tree.view</field>
			<field name="model">siantou.ems.timetable.timetable</field>
			<field name="arch" type="xml">
				<tree create="False" string="Exceptions d'emploi du temps">
                    <header>
                        <button name="action_cancel_all_timetable_exception" 
                                type="object" 
                                string="Annuler les exceptions" 
                                class="oe_highlight"/>
                    </header>
                    <field name="group_id"/>
                    <field name="date"/>
                    <field name="semester_id"/>
                    <field name="year_id"/>
                    <field name="school_id"/>
                    <field name="field_of_study_id"/>
                    <field name="level_id"/>
                    <field name="specialty_id"/>
                    <field name="option_id"/>
                    <field name="class_id"/>
                    <field name="class_group_id"/>
                    <field name="ue_id"/>
					<field name="subject_id"/>
					<field name="building_id"/>
					<field name="classroom_id"/>
					<field name="employee_id"/>
					<field name="day_of_week"/>
					<field name="start_time"/>
					<field name="end_time"/>
					<field name="status" widget="badge"
                        decoration-muted="status == '0'"
                        decoration-success="status == '1'"
                        decoration-danger="status == '2'"
                        decoration-info="status == '3'"
                        decoration-warning="status == '4'"/>
				</tree>
			</field>
		</record>

        <record id="timetable_exception_search_view" model="ir.ui.view">
            <field name="name">timetable.exception.search.view</field>
            <field name="model">siantou.ems.timetable.timetable</field>
            <field name="arch" type="xml">
                <search>
                    <field name="group_id"/>
                    <field name="date"/>
                    <field name="semester_id"/>
                    <field name="year_id"/>
                    <field name="school_id"/>
                    <field name="field_of_study_id"/>
                    <field name="level_id"/>
                    <field name="specialty_id"/>
                    <field name="option_id"/>
                    <field name="class_id"/>
                    <field name="class_group_id"/>
                    <field name="ue_id"/>
					<field name="subject_id"/>
					<field name="building_id"/>
					<field name="classroom_id"/>
					<field name="employee_id"/>
					<field name="day_of_week"/>
					<field name="start_time"/>
					<field name="end_time"/>
					<field name="status"/>
                    <filter string="Mon emploi du temps" name="myexceptiontimetable" domain="[('employee_id.user_id', '=', uid)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Filière" name="field_of_study" context="{'group_by': 'field_of_study_id'}"/>
                        <filter string="Niveau" name="level" context="{'group_by': 'level_id'}"/>
                        <filter string="Classe" name="class" context="{'group_by': 'class_id'}"/>
                        <filter string="Spécialité" name="specialty" context="{'group_by': 'specialty_id'}"/>
                        <filter string="Option" name="option" context="{'group_by': 'option_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action pour le menu d'affichage des années académiques -->
        <record
                id="action_show_timetable_exception"
                model="ir.actions.act_window">
            <field name="name">Exceptions d'emploi du temps</field>
            <field name="res_model">siantou.ems.timetable.timetable</field>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="timetable_exception_tree_view"/>
            <field name="domain">[('status', '=', '4')]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Liste des exceptions.
                </p>
            </field>
            <field name="search_view_id" ref="timetable_exception_search_view"/>
        </record>

        
        <menuitem
            id="menu_timetable_exception"
            name="Exceptions d'emploi du temps"
            parent="menu_siantou_ems_timetable_planning"
            action="action_show_timetable_exception"
            groups="siantou_ems_core.group_timetable_user,siantou_ems_core.group_timetable_admin,base.group_system"
            sequence="3"/>
        
	</data>
</odoo>