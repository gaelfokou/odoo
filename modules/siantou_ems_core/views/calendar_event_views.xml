<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_calendar_event_tree" model="ir.ui.view">
        <field name="name">calendar.event.view.tree</field>
        <field name="model">siantou.ems.core.calendar.event</field>
        <field name="arch" type="xml">
            <tree string="Événements">
                <header>
                    <button name="action_create_all_calendar_event" 
                        type="object" 
                        string="Générer les jours fériers" 
                        class="oe_highlight" 
                        display="always"/>
                </header>
                <field name="name"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="formatted_date"/>
                <field name="semester_id"/>
                <field name="is_public_holiday"/>
                <field name="is_active"/>
                <button name="action_deactivate_all_calendar_event" 
                    type="object" 
                    string="Activé" 
                    class="btn-success" 
                    display="always"
                    invisible="not is_active"/>
                <button name="action_deactivate_all_calendar_event" 
                    type="object" 
                    string="Désactivé" 
                    class="btn-danger" 
                    display="always"
                    invisible="is_active"/>
            </tree>
        </field>
    </record>
    <record id="view_calendar_event_form" model="ir.ui.view">
        <field name="name">calendar.event.view.form</field>
        <field name="model">siantou.ems.core.calendar.event</field>
        <field name="arch" type="xml">
            <form string="Événements">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="formatted_date"/>
                        <field name="semester_id"/>
                        <field name="is_public_holiday"/>
                        <field name="is_active"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_show_calendar_event" model="ir.actions.act_window">
        <field name="name">Événements</field>
        <field name="res_model">siantou.ems.core.calendar.event</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
            id="menu_siantou_ems_core_config_calendar_event"
            name="Événements"
            parent="menu_siantou_ems_core_config_calendar"
            action="action_show_calendar_event"
            groups="siantou_ems_core.group_timetable_admin,base.group_system"
            sequence="2"/>
</odoo>