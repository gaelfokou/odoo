<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit" model="ir.ui.view">
        <field name="name">account.move.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <group>
                    <field name="cycle_id"/>
                    <field name="filiere_id"/>
                    <field name="specialty_id"/>
                    <field name="annee_academique_id"/>
                    <field name="niveau_id"/>
                </group>
            </field>
        </field>
    </record>


    <record model="ir.ui.menu" id="account.menu_finance_receivables">
        <field name="name">Encaissement</field>
    </record>

    <record model="ir.ui.menu" id="account.menu_action_move_out_invoice_type">
        <field name="name">Factures étudiantes</field>
    </record>

</odoo>