<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
    
        <!-- Course -->
        <record id="school_course_tree_view" model="ir.ui.view">
			<field name="name">school.course.tree.view</field>
			<field name="model">oe.school.course</field>
			<field name="arch" type="xml">
				<tree string="Cycles">
					<field name="name"/>
                    <field name="company_id" />
                    <field name="level_ids" widget="many2many_tags" />
				</tree>
			</field>
		</record>
		<record id="school_course_form_view" model="ir.ui.view">
			<field name="name">school.course.form.view</field>
			<field name="model">oe.school.course</field>
			<field name="arch" type="xml">
				<form string="Cycles">
					<sheet>
                        <group >
                            <group>
                                <field name="code" />
                                <field name="name" />
                                <field name="level_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                <field name="sequence_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="color" widget="color_picker"/>
                                <field name="company_id" options="{'no_create': True}" />
                            </group>
                        </group>
					</sheet>
				</form>
			</field>
		</record>
        
        <record id="view_course_filter" model="ir.ui.view">
            <field name="name">school.course.search</field>
            <field name="model">oe.school.course</field>
            <field name="arch" type="xml">
                <search string="Cycles">
                    <field name="name" string="Filière"/>
                    <separator/>
                    <filter string="Archivé" name="inactive" domain="[('active','=',False)]"/>
                </search>
             </field>
        </record>
        
        <record id="action_oe_school_course" model="ir.actions.act_window">
            <field name="name">Cycles</field>
            <field name="res_model">oe.school.course</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_course_filter"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer une nouvelle filière
                </p><p>
                    Les cours sont utilisés pour inscrire les étudiants.
                </p>
            </field>
        </record>
                
        <menuitem
            id="menu_siantou_ems_core_cycle"
            name="Cycles"
            parent="menu_siantou_ems_core_configuration"
            action="action_oe_school_course"
            groups="siantou_ems_core.group_courses_user,siantou_ems_core.group_courses_admin,base.group_system"
            sequence="7"/>
    </data>
</odoo>