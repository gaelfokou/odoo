<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
        <!-- Course -->
        <record id="school_course_tree_view" model="ir.ui.view">
			<field name="name">school.course.tree.view</field>
			<field name="model">oe.school.course</field>
			<field name="arch" type="xml">
				<tree string='Cursus ou Cycles'>
                    <header>
                        <button name="action_update_all_cycle" 
                            type="object" 
                            string="Mettre à jour les cycles" 
                            class="oe_highlight"/>
                    </header>
                    <field name="code"/>
					<field name="name"/>
                    <field name="company_id"/>
                    <field name="level_ids" widget="many2many_tags"/>
                    <field name="supervision_id"/>
				</tree>
			</field>
		</record>
		<record id="school_course_form_view" model="ir.ui.view">
			<field name="name">school.course.form.view</field>
			<field name="model">oe.school.course</field>
			<field name="arch" type="xml">
				<form string='Cursus ou Cycles'>
					<sheet>
                        <group >
                            <group>
                                <field name="name"/>
                                <field name="code"/>
                                <field name="cycle_name"/>
                                <field name="level_ids" widget="many2many_tags"/>
                                <field name="has_supervision"/>
                                <field name="supervision_id" invisible="has_supervision == False"/>
                                <field name="sequence_id" options="{'no_create': True}" readonly="1"/>
                            </group>
                            <group>
                                <field name="color" widget="color_picker"/>
                                <field name="company_id" options="{'no_create': True}"/>
                            </group>
                        </group>
					</sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
				</form>
			</field>
		</record>

        <record id="view_course_filter" model="ir.ui.view">
            <field name="name">school.course.search</field>
            <field name="model">oe.school.course</field>
            <field name="arch" type="xml">
                <search string='Cursus ou Cycles'>
                    <field name="name" string="Filière"/>
                    <separator/>
                    <filter string="Archivé" name="inactive" domain="[('is_active', '=', False)]"/>
                </search>
             </field>
        </record>

        <record id="action_show_oe_school_course" model="ir.actions.act_window">
            <field name="name">Cursus ou Cycles</field>
            <field name="res_model">oe.school.course</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_course_filter"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer une nouvelle filière
                </p><p>
                    Les cours sont utilisés pour inscrire les étudiants.
                </p>
            </field>
        </record>

        <record id="action_show_oe_school_course_2" model="ir.actions.act_window">
            <field name="name">Cursus ou Cycles</field>
            <field name="res_model">oe.school.course</field>
            <field name="view_mode">tree</field>
            <field name="context">{'create': False, 'edit': False}</field>
            <field name="search_view_id" ref="view_course_filter"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer une nouvelle filière
                </p><p>
                    Les cours sont utilisés pour inscrire les étudiants.
                </p>
            </field>
        </record>

        <!-- <menuitem name="Cursus ou Cycles" id="menu_school_courses_courses"
                    parent="menu_school_courses" action="action_show_oe_school_course"
                     sequence="1"/> -->

        <menuitem
            id="menu_siantou_ems_core_cycle"
            name="Cursus ou Cycles"
            parent="menu_siantou_ems_core_config_fa"
            action="action_show_oe_school_course"
            groups="siantou_ems_core.group_courses_admin,base.group_system"
            sequence="7"/>
        <menuitem
            id="menu_siantou_ems_core_cycle_2"
            name="Cursus ou Cycles"
            parent="menu_siantou_ems_core_program"
            action="action_show_oe_school_course_2"
            groups="siantou_ems_core.group_courses_admin,base.group_system"
            sequence="7"/>
    </data>
</odoo>