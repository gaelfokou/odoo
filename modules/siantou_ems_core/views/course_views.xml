        <record id="view_course_filter" model="ir.ui.view">
            <field name="name">school.course.search</field>
            <field name="model">oe.school.course</field>
            <field name="arch" type="xml">
                <search string='Cursus ou Cycles'>
                    <field name="name" string="Filière"/>
                    <separator/>
                    <filter string="Archivé" name="inactive" domain="[('is_active', '=', False)]"/>
                </search>
             </field>
        </record>

        <record id="action_show_oe_school_course" model="ir.actions.act_window">
            <field name="name">Cursus ou Cycles</field>
            <field name="res_model">oe.school.course</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_course_filter"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer une nouvelle filière
                </p><p>
                    Les cours sont utilisés pour inscrire les étudiants.
                </p>
            </field>
        </record>

        <record id="action_show_oe_school_course_2" model="ir.actions.act_window">
