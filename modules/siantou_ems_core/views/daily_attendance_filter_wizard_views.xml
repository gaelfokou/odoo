<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="daily_attendance_filter_wizard" model="ir.ui.view">
            <field name="name">daily.attendance.filter.wizard.form</field>
            <field name="model">daily.attendance.filter.wizard</field>
            <field name="arch" type="xml">
                <form string="Filtre des présences">
                    <group>
                        <field name="employee_id" options="{'no_create': True}"/>
                        <field name="address_id" options="{'no_create': True}"/>
                        <field name="attendance_type"/>
                        <field name="punch_type"/>
                        <field name="start_punching_day"/>
                        <field name="end_punching_day"/>
                        <field name="start_punching_time"/>
                        <field name="end_punching_time"/>
                    </group>
                    <footer>
                        <button string="Filtrer" type="object" name="action_filter" class="btn-primary"/>
                        <button string="Annuler" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Define an action to open the form view -->
        <record id="action_filter_daily_attendance_wizard" model="ir.actions.act_window">
            <field name="name">Filtre des présences</field>
            <field name="res_model">daily.attendance.filter.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="daily_attendance_filter_wizard"/>
        </record>
    </data>
</odoo>