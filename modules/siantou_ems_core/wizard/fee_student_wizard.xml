<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fee_enrollment_wizard" model="ir.ui.view">
        <field name="name">siantou.ems.core.fee.enrollment.student.form</field>
        <field name="model">siantou.ems.core.fee.enrollment.student</field>
        <field name="arch" type="xml">
            <form string="Paiement des frais d'inscription">
                <sheet>
                    <group>
                        <b><field name="student_id" options="{'no_create': True}" readonly="1"/></b>
                    </group>
                    <group>
                        <group>
                            <field name="structure_frais_name" readonly="1"/>
                        </group>
                        <group>
                            <field name="year_id" options="{'no_create': True}" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="mode_payment"/>
                            <field name="cash_register_id" domain="[('type', '=', mode_payment)]"/>
                        </group>
                        <group>
                            <field name="amount" readonly="1"/>
                        </group>
                    </group>
                    <!-- <group>
                        <group string="Informations BANK" invisible="mode_payment == 'cash'">
                            <field name="titulaire_compte" required="mode_payment == 'bank'"/>
                            <field name="name_bank" required="mode_payment == 'bank'"/>
                            <field name="code_guichet" required="mode_payment == 'bank'"/>
                            <field name="numero_compte" required="mode_payment == 'bank'"/>
                        </group>
                        <group string="Informations sur le déposant">
                            <field name="student_name"/>
                            <field name="student_phone"/>
                        </group>
                    </group>
                    <group>
                        <group string="Informations sur le paiement">
                            <field name="amount" readonly="1"/>
                            <field name="date_payment"/>
                        </group>
                        <group string="Informations sur la CNI">
                            <field name="cni"/>
                            <field name="lieu_delivr_cni"/>
                            <field name="date_delivr_cni"/>
                        </group>
                    </group> -->

                    <!-- <p>
                        Vous êtes sur le point d'ajouter une pièce comptable d'enregistrement des frais d'inscription de 
                        <b><field name="student_id" options="{'no_create': True}" readonly="1"/></b>
                    </p>
                    <b>Montant à payer</b> : <field name="amount" readonly="1"/>
                    <group>
                        <field name="fee_enroll_struct_id"/>
                    </group> -->

                </sheet>
                <footer>
                    <button string="Enregistrer" type="object" name="enroll_student" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_fee_enrollment_wizard" model="ir.actions.act_window">
        <field name="name">Paiement des frais</field>
        <field name="res_model">siantou.ems.core.fee.enrollment.student</field>
        <field name="view_mode">form</field>
        <field name="type">ir.actions.act_window</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_fee_enrollment_wizard"/>
    </record>

