<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_admission_enrollment_wizard" model="ir.ui.view">
        <field name="name">siantou.ems.core.student.enrollment.admission.wizard.form</field>
        <field name="model">siantou.ems.core.student.enrollment.admission.wizard</field>
        <field name="arch" type="xml">
            <form string="Observations">
                <sheet>
                    <group>
                        <field name="student_enroll_id" options="{'no_create': True}" readonly="1"/>
                    </group>

                    <group>
                        <field name="observations"/>
                    </group>
                </sheet>
                <footer>

                    <button 
                        string="Transférer" 
                        type="object" 
                        name="student_enroll_admission" 
                        class="btn-primary"/>

                    <button 
                        string="Annuler" 
                        class="btn-secondary" 
                        special="cancel"/>

                </footer>
            </form>
        </field>
    </record>

    <record id="action_student_admission_enrollment_wizard" model="ir.actions.act_window">
        <field name="name">Oservations</field>
        <field name="res_model">siantou.ems.core.student.enrollment.admission.wizard</field>
        <field name="view_mode">form</field>
        <field name="type">ir.actions.act_window</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_admission_enrollment_wizard"/>
        <field name="context">{'student_id': active_id}</field>
    </record>

</odoo>