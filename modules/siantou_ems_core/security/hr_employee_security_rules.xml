<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Règle de sécurité pour restreindre les accès des utilisateurs -->
        <record id="rule_hr_employee_teacher_user" model="ir.rule">
            <field name="name">Access limited to teacher user</field>
            <field name="model_id" ref="hr.hr_employee"/>
            <field name="groups" eval="[(4, ref('siantou_ems_core.group_teacher_user'))]"/>
            <field name="domain_force">[('is_teacher', '=', True)]</field>
        </record>

        <record id="rule_hr_employee_teacher_admin" model="ir.rule">
            <field name="name">Full access for teacher admin</field>
            <field name="model_id" ref="hr.hr_employee"/>
            <field name="groups" eval="[(4, ref('siantou_ems_core.group_teacher_admin'))]"/>
            <field name="domain_force">[]</field>
        </record>
    </data>
</odoo>
