<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="owl.EmsCoreDashboard" owl="1">
        <div class="vh-100 overflow-auto bg-muted">
            <div class="row m-3">
                <div class="col-lg-12">
                    <div class="row">
                        <div class="col m-0 p-0">
                            <div class="shadow-sm border m-2 p-4 bg-white">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div class="col-10">
                                        <h1 class="text-primary fw-bold">Tableau de bord</h1>
                                    </div>
                                    <div class="col-2">
                                        <select id="year" class="form-select" name="year" t-model="state.year.value" t-on-change="onChangeYear">
                                            <option t-att-value="0" t-att-selected="state.year.value == 0">Année académique</option>
                                            <t t-foreach="state.years" t-as="year" t-key="year.id">
                                                <option t-att-value="year.id" t-att-selected="state.year.value == year.id"><t t-esc="year.name"/></option>
                                            </t>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <KpiCard name="'Étudiants'" value="state.students.value" icon="'user'"/>
                        <KpiCard name="'Enseignants'" value="state.teachers.value" icon="'group'"/>
                        <KpiCard name="'Filières'" value="state.filieres.value" icon="'level-up'"/>
                        <KpiCard name="'Cycles'" value="state.cycles.value" icon="'repeat'"/>
                        <KpiCard name="'Écoles'" value="state.ecoles.value" icon="'cogs'"/>
                        <KpiCard name="'Campus'" value="state.campus.value" icon="'building'"/>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="row">

                        <div class="col-md-4 m-0 p-0">
                            <div class="shadow-sm border m-2 p-4 bg-white">
                                <div class="d-flex align-items-center justify-content-between">
                                    <h3 class="text-primary fw-bold">Enseignants</h3>
                                    <div class="px-3 py-1 bg-primary cursor-pointer">
                                        <span class="fa fa-arrow-right text-white"/>
                                    </div>
                                </div>
                                <t t-if="state.doughTearchers.length>0">
                                    <DoughnutRenderer type="'doughnut'" title="'Enseignants'" datas="state.doughTearchers"/>
                                </t>
                            </div>
                        </div>
                        <div class="col-md-4 m-0 p-0">
                            <div class="shadow-sm border m-2 p-4 bg-white">
                                <div class="d-flex align-items-center justify-content-between">
                                    <h3 class="text-primary fw-bold">Effectif par école</h3>
                                    <div class="px-3 py-1 bg-primary cursor-pointer">
                                        <span class="fa fa-arrow-right text-white"/>
                                    </div>
                                </div>
                                <t t-if="state.doughÉcoles.length>0">
                                    <DoughnutRenderer type="'doughnut'" title="'Écoles'" datas="state.doughÉcoles"/>
                                </t>
                            </div>
                        </div>
                        <div class="col-md-4 m-0 p-0">
                            <div class="shadow-sm border m-2 p-4 bg-white">
                                <div class="d-flex align-items-center justify-content-between">
                                    <h3 class="text-primary fw-bold">Effectif par filière</h3>
                                    <div class="px-3 py-1 bg-primary cursor-pointer">
                                        <span class="fa fa-arrow-right text-white"/>
                                    </div>
                                </div>
                                <t t-if="state.doughFilieres.length>0">
                                    <DoughnutRenderer type="'doughnut'" title="'Filières'" datas="state.doughFilieres"/>
                                </t>

                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="row">
                        <div class="col-md-12 m-0 p-0">
                            <div class="shadow-sm border m-2 p-4 bg-white">
                                <div class="d-flex align-items-center justify-content-between">
                                    <h3 class="text-primary fw-bold">Effectif par cyle</h3>
                                    <div class="px-3 py-1 bg-primary cursor-pointer">
                                        <span class="fa fa-arrow-right text-white"/>
                                    </div>
                                </div>
                                <ChartRenderer type="'bar'" title="'Effectif par cyles'" datas="state.datas"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>