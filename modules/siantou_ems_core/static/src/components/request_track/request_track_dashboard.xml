<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="owl.OwlRequestTrackDashboard" owl="1">
        <div class="vh-100 overflow-auto bg-muted">
            <div class="row m-3">
                <div class="col-lg-12">
                    <div class="row">
                        <div class="col m-0 p-0">
                            <div class="shadow-sm border m-2 p-4 bg-white">
                                <div class="d-flex align-items-center justify-content-between">
                                    <h1 class="text-primary fw-bold">Informations académiques</h1>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <KpiCard onClick.bind="() => this.viewAcademicInformationPending()" name="state.academic_information.data.pending.title" value="state.academic_information.data.pending.value" percentage="state.academic_information.data.pending.value"/>
                        <KpiCard onClick.bind="() => this.viewAcademicInformationProgress()" name="state.academic_information.data.progress.title" value="state.academic_information.data.progress.value" percentage="state.academic_information.data.progress.value"/>
                        <KpiCard onClick.bind="() => this.viewAcademicInformationRejected()" name="state.academic_information.data.rejected.title" value="state.academic_information.data.rejected.value" percentage="state.academic_information.data.rejected.value"/>
                        <KpiCard onClick.bind="() => this.viewAcademicInformationDone()" name="state.academic_information.data.done.title" value="state.academic_information.data.done.value" percentage="state.academic_information.data.done.value"/>
                    </div>
                    <div class="row">
                        <div class="col m-0 p-0">
                            <div class="shadow-sm border m-2 p-4 bg-white">
                                <div class="d-flex align-items-center justify-content-between">
                                    <h1 class="text-primary fw-bold">Notes d'examen</h1>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <KpiCard onClick.bind="() => this.viewExamScorePending()" name="state.exam_score.data.pending.title" value="state.exam_score.data.pending.value" percentage="state.exam_score.data.pending.value"/>
                        <KpiCard onClick.bind="() => this.viewExamScoreProgress()" name="state.exam_score.data.progress.title" value="state.exam_score.data.progress.value" percentage="state.exam_score.data.progress.value"/>
                        <KpiCard onClick.bind="() => this.viewExamScoreRejected()" name="state.exam_score.data.rejected.title" value="state.exam_score.data.rejected.value" percentage="state.exam_score.data.rejected.value"/>
                        <KpiCard onClick.bind="() => this.viewExamScoreDone()" name="state.exam_score.data.done.title" value="state.exam_score.data.done.value" percentage="state.exam_score.data.done.value"/>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
