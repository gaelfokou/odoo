<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="owl.OwlRequestTrackDashboard" owl="1">
        <div class="vh-100 overflow-auto bg-muted">
            <div class="row m-3">
                <div class="col-lg-12">
                    <div class="row">
                        <div class="col m-0 p-0">
                            <div class="shadow-sm border m-2 p-4 bg-white">
                                <div class="d-flex align-items-center justify-content-between">
                                    <h1 class="text-primary fw-bold">Informations académiques</h1>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <KpiCard onClick.bind="viewAcademicInformationPending" name="'En attente'" value="state.academic_information.pending.value" percentage="state.academic_information.pending.value"/>
                        <KpiCard onClick.bind="viewAcademicInformationProgress" name="'En cours'" value="state.academic_information.progress.value" percentage="state.academic_information.progress.value"/>
                        <KpiCard onClick.bind="viewAcademicInformationRejected" name="'Rejeté'" value="state.academic_information.rejected.value" percentage="state.academic_information.rejected.value"/>
                        <KpiCard onClick.bind="viewAcademicInformationDone" name="'Terminé'" value="state.academic_information.done.value" percentage="state.academic_information.done.value"/>
                    </div>
                    <div class="row">
                        <div class="col m-0 p-0">
                            <div class="shadow-sm border m-2 p-4 bg-white">
                                <div class="d-flex align-items-center justify-content-between">
                                    <h1 class="text-primary fw-bold">Notes d'examen</h1>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <KpiCard onClick.bind="viewExamScorePending" name="'En attente'" value="state.exam_score.pending.value" percentage="state.exam_score.pending.value"/>
                        <KpiCard onClick.bind="viewExamScoreProgress" name="'En cours'" value="state.exam_score.progress.value" percentage="state.exam_score.progress.value"/>
                        <KpiCard onClick.bind="viewExamScoreRejected" name="'Rejeté'" value="state.exam_score.rejected.value" percentage="state.exam_score.rejected.value"/>
                        <KpiCard onClick.bind="viewExamScoreDone" name="'Terminé'" value="state.exam_score.done.value" percentage="state.exam_score.done.value"/>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
