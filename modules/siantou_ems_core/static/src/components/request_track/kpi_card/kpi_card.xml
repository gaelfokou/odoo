<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="owl.KpiCard" owl="1">
        <div class="col-lg-4 m-0 p-0">
            <div class="shadow-sm border m-2 p-4 bg-white text-center">
                <div class="h1 fw-bold text-dark" style="font-size: 48px"><span t-attf-class="text-#{ props.value > 0 ? '' : '' }" t-esc="props.value"/></div>
                <div class="h3 text-muted"><span t-esc="props.name"/></div>
                <div class="h3 mt-3">
                    <div class="px-3 py-1 cursor-pointer" t-on-click="()=>props.onClick()">
                        <span>Détails </span>
                        <span class="me-1 fa fa-arrow-right text-success"/>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
