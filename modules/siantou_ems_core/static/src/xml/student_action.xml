<?xml version="1.0" encoding="utf-8"?>
<!-- Template for the Advanced Dashboard -->
<templates id="siantou_ems_core_student_action" xml:space="preserve">
    <t t-name="siantou_ems_core.student_action">
        <div class="title">
            <h1>Liste des étudiants</h1>
        </div>
        <!-- You can add the templates here -->
        <div class="body">
            <table class="table table-attendance" t-ref="student-data" t-on-click="showNotification" style="cursor: pointer;">
                <tr>
                    <th>Nom</th>
                    <th>E-mail</th>
                </tr>
                <tr t-foreach="students.data" t-as="data" t-key="data_index" t-att-data-value="data.id">
                    <td t-esc="data.name"/>
                    <td t-esc="data.email"/>
                </tr>
            </table>
        </div>
    </t>
</templates>
