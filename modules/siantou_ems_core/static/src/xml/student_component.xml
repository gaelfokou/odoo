<?xml version="1.0" encoding="utf-8"?>
<!-- Template for the Advanced Dashboard -->
<templates id="siantou_ems_core_student_component" xml:space="preserve">
    <t t-name="siantou_ems_core.student_component">
        <div class="title">
            <h1>Étudiants</h1>
        </div>
        <!-- You can add the templates here -->
        <div class="body">
            <table class="table table-attendance">
                <tr>
                    <th>Matricule</th>
                    <th>Nom(s) et prénom(s)</th>
                    <th>E-mail</th>
                </tr>
                <tr t-foreach="state.students" t-as="data" t-key="index" t-att-data-value="data.id">
                    <td t-on-click="showNotification" style="cursor: pointer;">
                        <Span text="data.matricule"/>
                    </td>
                    <td t-esc="data.name"/>
                    <td t-esc="data.email"/>
                </tr>
            </table>
        </div>
    </t>
</templates>
