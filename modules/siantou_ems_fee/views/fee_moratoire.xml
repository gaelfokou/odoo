<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="fee_special_view_form" model="ir.ui.view">
            <field name="name">siantou.ems.fee.moratoire.view.form</field>
            <field name="model">siantou.ems.fee.moratoire</field>
            <field name="arch" type="xml">
                <form string="Moratoire">
                    <sheet>
                        <group col="4" colspan="4">
                            <group col="2" colspan="2">
                                <field name="student_id"/>
                                <field name="year_id"/>
                            </group>
                            <group col="2" colspan="2">
                                <field name="amount"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="fee_special_view_tree" model="ir.ui.view">
            <field name="name">siantou.ems.fee.moratoire.view.tree</field>
            <field name="model">siantou.ems.fee.moratoire</field>
            <field name="arch" type="xml">
                <tree string="Moratoires">
                    <field name="name" />
                    <field name="year_id" />
                    <field name="amount" />
                    <field name="currency_id" invisible="1" />
                </tree>
            </field>
        </record>

        <record id="fee_moratoire_action" model="ir.actions.act_window">
            <field name="name">Moratoires</field>
            <field name="res_model">siantou.ems.fee.moratoire</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Veuillez enregistrer un moratoire
                </p>
            </field>
        </record>

        <menuitem 
            action="fee_moratoire_action"
            id="menu_fee_moratoire_action"
            parent="menu_fees_configuration"
            sequence="28" />

    </data>
</odoo>