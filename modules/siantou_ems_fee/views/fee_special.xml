<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="fee_special_view_form" model="ir.ui.view">
            <field name="name">fee_special.view.form</field>
            <field name="model">siantou.ems.fee.special</field>
            <field name="arch" type="xml">
                <form string="Formulaire de paiement">
                    <header>
                        <button 
                            name="validate_special" 
                            invisible="state in ['validate','no_create']" 
                            type="object" string="Valider"
                            class="btn btn-primary" 
                            confirm="Validez-vous ce paiement ?" />
                        <button class="btn btn-danger" 
                            name="reset_special" 
                            invisible="state in ['create','no_create']" 
                            type="object" 
                            string="Annuler" 
                            confirm="Voulez-vous annuler et supprimer les écritures comptables de ce paiement ?" /> 
                        <button 
                            class="btn btn-warning" 
                            name="print_payement_special" 
                            icon="fa-print"
                            invisible="state in ['create','no_create']" 
                                type="object" string="Imprimer le reçu" 
                                data-hotkey="F"/>
                        <field name="state" widget="statusbar" statusbar_visible="no_create,create,validate" />
                    </header>
                    <sheet>
                        <group col="4" colspan="4">
                            <group col="2" colspan="2">
                                <field name="name" invisible="1"/>
                                <field name="student_id" options="{'no_open': True, 'no_create': True}" 
                                    readonly="state in ['validate']"/>
                                <field name="fee_structure_id" domain="structure_frais_request_domain" 
                                    options="{'no_open': True, 'no_create': True}" 
                                    readonly="state in ['validate']"/>
                                <field name="structure_frais_request_domain" invisible="1"/>
                                <field name="amount" readonly="state in ['validate']"/>
                                <field name="mode_payment" readonly="state in ['validate']"/>
                                <field name="currency_id" invisible="1" />
                            </group>
                            <group col="2" colspan="2">
                                <field name="academic_year_id" options="{'no_open': True, 'no_create': True}" readonly="state in ['validate']"/>
                                <field name="date_payment" readonly="state in ['validate']"/>
                            </group>
                        </group>
                        <group>
                            <group string="Informations BANK" invisible="mode_payment=='cash'" readonly="state in ['validate']">
                                <field name="titulaire_compte" required="mode_payment=='bank'" readonly="state in ['validate']"/>
                                <field name="name_bank" required="mode_payment=='bank'" readonly="state in ['validate']"/>
                                <field name="code_guichet" required="mode_payment=='bank'" readonly="state in ['validate']"/>
                                <field name="numero_compte" required="mode_payment=='bank'" readonly="state in ['validate']"/>
                            </group>
                            <group string="Informations sur le paiement">
                                <field name="amount" readonly="state in ['validate']"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="date_payment" readonly="state in ['validate']"/>
                            </group>
                            <group string="Informations sur la CNI">
                                <field name="cni" readonly="state in ['validate']"/>
                                <field name="lieu_delivr_cni" readonly="state in ['validate']"/>
                                <field name="date_delivr_cni" readonly="state in ['validate']"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="description" string="Description détaillé">
                                <field name="description" placeholder="Une description des frais appliqué à l'étudiant" readonly="state in ['validate']"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">

                        <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>

                        <field name="message_ids" widget="mail_thread"/>

                    </div>
                </form>
            </field>
        </record>

        <record id="fee_special_view_tree" model="ir.ui.view">
            <field name="name">siantou.ems.fee.special.view.tree</field>
            <field name="model">siantou.ems.fee.special</field>
            <field name="arch" type="xml">
                <tree string="Liste des frais spéciaux" default_group_by="student_id">
                    <field name="name" />
                    <field name="academic_year_id" />
                    <field name="student_id" />
                    <field name="fee_structure_id" />
                    <!-- <field name="amount" /> -->
                    <field name="state" />
                </tree>
            </field>
        </record>

        <record id="fee_special_action" model="ir.actions.act_window">
            <field name="name">Frais spéciaux</field>
            <field name="res_model">siantou.ems.fee.special</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Veuillez enregistrer les frais spéciaux pour chaque étudiants
                </p>
            </field>
        </record>

        <menuitem 
            action="fee_special_action"
            id="menu_fee_special_action"
            parent="menu_student_fee_receipt"
            sequence="30" />

    </data>
</odoo>