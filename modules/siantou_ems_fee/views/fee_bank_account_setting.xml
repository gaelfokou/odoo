<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="fee_category_form" model="ir.ui.view">
            <field name="name">siantou.ems.fee.config.bank.form</field>
            <field name="model">siantou.ems.fee.config.bank</field>
            <field name="arch" type="xml">
                <form string="Banques pour payer les frais d'inscription">
                    <sheet>
                        <group>
                            <group string="Paiement nationaux">
                                <group>
                                    <field name="denomination" placeholder="Ex: Université siantou supérieur"/>
                                    <field name="nom_bank" placeholder="Ex: AFRILAND FIRST BANK"/>
                                    <field name="code_1" placeholder="Ex: 00001"/>
                                    <field name="code_2" placeholder="Ex: 10005"/>
                                    <field name="cle_rib" placeholder="Ex: YHOPL1252"/>
                                    <field name="numero" placeholder="Ex: 03854381006"/>
                                    <field name="name" invisible="1"/>
                                </group>
                            </group>
                            <group string="Paiement internationaux">
                                <field name="swift_code" placeholder="Ex: ICLRCMCXXXX"/>
                                <field name="iban" placeholder="Ex: CM21 10005 00001 03853481001-20"/>
                            </group>
                            <group string="Configuration activé ?">
                                <field name="active"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="fee_category_tree" model="ir.ui.view">
            <field name="name">siantou.ems.fee.config.bank.tree</field>
            <field name="model">siantou.ems.fee.config.bank</field>
            <field name="arch" type="xml">
                <tree string="Numéro de bancaire pour virer les frais d'inscription">
                    <field name="numero"/>
                    <field name="denomination"/>
                    <field name="nom_bank"/>
                    <field name="swift_code"/>
                    <field name="iban"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>


        <record id="action_fee_bank_account_config" model="ir.actions.act_window">
            <field name="name">Numéro de compte bancaire pour payer les frais d'inscription</field>
            <field name="res_model">siantou.ems.fee.config.bank</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem 
            id="menu_action_fee_bank_account_config" 
            action="action_fee_bank_account_config"
            parent="menu_fees_configuration"
            sequence="8"
        />
    </data>
</odoo>


