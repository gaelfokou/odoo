<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="fee_types_form" model="ir.ui.view">
            <field name="name">siantou.ems.fee.type.form</field>
            <field name="model">siantou.ems.fee.type</field>
            <field name="arch" type="xml">
                <form string="Fee Types">
                    <sheet>
                        <group>
                            <group>
                                <field name="name" placeholder="Eg: Inscription"/>
                                <!-- <field name="lst_price" string="Montant" required="1" widget="monetary"/> -->
                            </group>
                            <group>
                                <!-- <field name="payment_type"/> -->
                                <!-- <field name="interval" placeholder="Eg: Quarterly"/> -->
                                <field name="category_id"/>
                            </group>
                            <field name="description_sale" placeholder="Description des frais" string="Description"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="fee_types_tree" model="ir.ui.view">
            <field name="name">siantou.ems.fee.type.tree</field>
            <field name="model">siantou.ems.fee.type</field>
            <field name="arch" type="xml">
                <tree string="Fee Types">
                    <field name="name"/>
                    <!-- <field name="lst_price" widget="monetary"/> -->
                    <field name="category_id"/>
                    <!-- <field name="interval"/>/ -->
                </tree>
            </field>
        </record>

        <record id="action_fee_type" model="ir.actions.act_window">
            <field name="name">Type de frais</field>
            <field name="res_model">siantou.ems.fee.type</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem
            id="menu_student_fee_receipt" 
            name="Paiements étudiants"
            parent="menu_education_fee_root"
            sequence="2"/>

        <menuitem id="menu_action_fee_types" action="action_fee_type"
          parent="menu_fees_configuration"
          sequence="2"/>
    </data>
</odoo>