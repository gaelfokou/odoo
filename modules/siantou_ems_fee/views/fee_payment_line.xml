<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="fee_payment_line_view_form" model="ir.ui.view">
            <field name="name">fee_payment_line.view.form</field>
            <field name="model">siantou.ems.fee.payment.line</field>
            <field name="arch" type="xml">
                <form string="Formulaire de paiement">
                    <sheet>
                        <group>
                            <group string="Informations sur le paiement">
                                <field name="amount_total" />
                                <field name="mode_payment" />
                                <field name="pay_complet" />
                                <field name="mode_payment" />
                                <field name="date_payment" />
                                <field name="currency_id" invisible="1"/>
                            </group>
                            <group string="Informations BANK" invisible="mode_payment=='cash'" >
                                <field name="titulaire_compte" required="mode_payment=='bank'" />
                                <field name="name_bank" required="mode_payment=='bank'" />
                                <field name="code_guichet" required="mode_payment=='bank'" />
                                <field name="numero_compte" required="mode_payment=='bank'" />
                            </group>
                            <group string="Informations sur la CNI">
                                <field name="cni" />
                                <field name="lieu_delivr_cni" />
                                <field name="date_delivr_cni" />
                            </group>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>

                        <field name="message_ids" widget="mail_thread"/>

                    </div>
                </form>
            </field>
        </record>

        <record id="fee_payment_line_view_tree" model="ir.ui.view">
            <field name="name">siantou.ems.fee.payment.line.view.tree</field>
            <field name="model">siantou.ems.fee.payment.line</field>
            <field name="arch" type="xml">
                <tree string="Liste des paiements" default_group_by="student_id">
                    <field name="invoice_id" />
                    <field name="payment_id" />
                    <field name="structure_frais_line_id" />
                    <field name="amount_total" />
                    <field name="date_payment" />
                </tree>
            </field>
        </record>

        <record id="fee_payment_line_action" model="ir.actions.act_window">
            <field name="name">Paiement par tranche</field>
            <field name="res_model">siantou.ems.fee.payment.line</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree,form</field>
             <field name="context">{}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Veuillez enregistrer les encaissements
                </p>
            </field>
        </record>

        <!-- <menuitem
            action="fee_payment_line_action"
            id="menu_fee_payment_line_action"
            parent="menu_student_fee_receipt"
            sequence="10" /> -->

    </data>
</odoo>