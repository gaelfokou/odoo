<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="fee_payment_enrollment_view_form" model="ir.ui.view">
            <field name="name">fee_payment_enrollment.view.form</field>
            <field name="model">education.fee.payment.enrollment</field>
            <field name="arch" type="xml">
                <form string="Formulaire de paiement">
                    <sheet>
                        <group col="4" colspan="4">
                            <group col="2" colspan="2">
                                <field name="name"/>
                                <field name="student_id" />
                                <field name="amount" />
                                <field name="amount_plus" />
                                <field name="amount_moins" />
                            </group>
                            <group col="2" colspan="2">
                                <field name="year_id" />
                                <field name="structure_frais_id" />
                                <field name="reference" />
                                <field name="date_payment" />
                                <!-- <field name="campus"  string="Campus"/> -->
                                <field name="currency_id" invisible="1" />
                            </group>
                        </group>
                        <!-- <notebook>
                            <page name="invoice" string="Liste factures">
                                <field name="facture_ids">
                                    <tree editable='bottom'>
                                        <field name="fee_structure" />
                                        <field name="amount_total" sum="Total"/>
                                        <field name="amount_reste" sum="Reste à Payer"/>
                                        <field name="to_pay" widget='checkbox' />
                                        <field name='currency_id' invisible='1' />
                                    </tree>
                                </field>
                            </page>
                        </notebook> -->
                    </sheet>
                    <div class="oe_chatter">

                        <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
        
                        <field name="message_ids" widget="mail_thread"/>
        
                    </div>
                </form>
            </field>
        </record>

        <record id="fee_payment_enrollment_view_tree" model="ir.ui.view">
            <field name="name">education.fee.payment.enrollment.view.tree</field>
            <field name="model">education.fee.payment.enrollment</field>
            <field name="arch" type="xml">
                <tree string="Liste des paiements" default_group_by="year_id">
                    <field name="year_id" />
                    <field name="name" />
                    <field name="date_payment" />
                    <field name="student_id" />
                    <field name="structure_frais_id" />
                    <field name="reference" />
                    <field name="amount" />
                    <field name="amount_plus" />
                    <field name="amount_moins" />
                    <field 
                        name="status" 
                        widget="badge"
                        decoration-success="status == 'all'"
                        decoration-warning="status == 'none_all'"
                    />
                </tree>
            </field>
        </record>

        <record id="fee_payment_enrollment_action" model="ir.actions.act_window">
            <field name="name">Encaissements des frais de candidatures</field>
            <field name="res_model">education.fee.payment.enrollment</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree,form</field>
             <field name="context">{}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Veuillez enregistrer les encaissements
                </p>
            </field>
        </record>

        <menuitem 
            action="fee_payment_enrollment_action"
            id="menu_fee_payment_enrollment_action"
            parent="menu_student_fee_receipt"
            sequence="20"
        />

    </data>
</odoo>