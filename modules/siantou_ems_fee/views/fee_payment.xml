<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="fee_payment_view_form" model="ir.ui.view">
            <field name="name">fee_payment.view.form</field>
            <field name="model">education.fee.payment</field>
            <field name="arch" type="xml">
                <form string="Formulaire de paiement">
                    <header>
                        <button name="validate_payment" invisible="state == 'done'" type="object" string="Valider"
                            class="oe_highlight" confirm="Validez-vous cet encaissement ?" />
                        <button name="reset_payment" invisible="state == 'draft'" type="object" string="Réinitoaliser" />
                        <field name="state" widget="statusbar" statusbar_visible="draft,done" />
                    </header>
                    <sheet>
                        <group col="4" colspan="4">
                            <group col="2" colspan="2">
                                <field name="name" invisible="1" />
                                <field name="student_id" />
                                <field name="amount" />
                            </group>
                            <group col="2" colspan="2">
                                <field name="structure_frais_id" />
                                <field name="reference" />
                                <field name="date_payment" />
                                <!-- <field name="campus"  string="Campus"/> -->
                                <field name="currency_id" invisible="1" />
                            </group>
                        </group>
                        <!-- <notebook>
                            <page name="invoice" string="Liste factures">
                                <field name="facture_ids">
                                    <tree editable='bottom'>
                                        <field name="fee_structure" />
                                        <field name="amount_total" sum="Total"/>
                                        <field name="amount_reste" sum="Reste à Payer"/>
                                        <field name="to_pay" widget='checkbox' />
                                        <field name='currency_id' invisible='1' />
                                    </tree>
                                </field>
                            </page>
                        </notebook> -->
                    </sheet>
                    <div class="oe_chatter">

                        <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
        
                        <field name="message_ids" widget="mail_thread"/>
        
                    </div>
                </form>
            </field>
        </record>

        <record id="fee_payment_view_tree" model="ir.ui.view">
            <field name="name">education.fee.payment.view.tree</field>
            <field name="model">education.fee.payment</field>
            <field name="arch" type="xml">
                <tree string="Liste des paiements">
                    <field name="name" />
                    <field name="date_payment" />
                    <field name="student_id" />
                    <field name="amount" />
                    <field name="structure_frais_id" />
                    <field name="reference" />
                </tree>
            </field>
        </record>

        <record id="fee_payment_action" model="ir.actions.act_window">
            <field name="name">Encaissements</field>
            <field name="res_model">education.fee.payment</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree,form</field>
             <field name="context">{}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Veuillez enregistrer les encaissements
                </p>
            </field>
        </record>

        <menuitem 
            action="fee_payment_action"
            id="menu_fee_payment_action"
            parent="menu_student_fee_receipt"
            sequence="10" />

    </data>
</odoo>