<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="fee_payment_view_form" model="ir.ui.view">
            <field name="name">fee_payment.view.form</field>
            <field name="model">education.fee.payment</field>
            <field name="arch" type="xml">
                <form string="Formulaire de paiement">
                    <header>
                        <button name="validate_payment" invisible="state in ['done','creer']" type="object" string="Valider"
                            class="oe_highlight" confirm="Validez-vous cet encaissement ?" />
                        <!-- <button name="reset_payment" invisible="state in ['creer','draft']" type="object" string="Réinitialiser" /> -->
                        <button class="btn btn-primary" 
                            name="action_complete_fee_payment_wizard" 
                            invisible="status in ['none', 'all'] or state in ['creer','draft']" 
                            type="object" 
                            string="Compléter le paiement" /> 
                        <button 
                            class="btn btn-warning" 
                            name="print_payement_student" 
                            icon="fa-print"
                            invisible="state in ['creer','draft']" 
                            type="object" 
                            string="Imprimer le reçu" 
                            data-hotkey="F"/>
                        <button class="btn btn-secondary" name="action_rien" invisible="use_moratoire == False" type="object" string="Cet étudiant a un moratoire de montant ci-dessous" />
                        <field name="state" widget="statusbar" statusbar_visible="draft,done" />
                    </header>
                    <sheet>
                        <group col="4" colspan="4">
                            <group col="2" colspan="2">
                                <field name="name" invisible="1" />
                                <field name="use_moratoire" invisible="1" />
                                <field name="student_id" readonly="state in ['draft', 'done']" />
                                <field name="year_id" readonly="state in ['draft', 'done']" />
                            </group>
                            <group col="2" colspan="2">
                                <field name="structure_frais_id" readonly="state in ['draft', 'done']"  domain="structure_frais_request_domain"/>
                                <field name="structure_frais_request_domain" invisible="1"/> 
                                <field name="mode_payment" readonly="state in ['draft', 'done']"/>
                            </group>
                        </group>
                        <group readonly="state in ['draft', 'done']">
                            <group string="Informations BANK" invisible="mode_payment=='cash'" readonly="state in ['draft', 'done']">
                                <field name="titulaire_compte" required="mode_payment=='bank'" readonly="state in ['draft', 'done']"/>
                                <field name="name_bank" required="mode_payment=='bank'" readonly="state in ['draft', 'done']"/>
                                <field name="code_guichet" required="mode_payment=='bank'" readonly="state in ['draft', 'done']"/>
                                <field name="numero_compte" required="mode_payment=='bank'" readonly="state in ['draft', 'done']"/>
                            </group>
                            <group string="Informations sur le paiement">
                                <field name="amount" readonly="state in ['draft', 'done']"/>
                                <field name="status" invisible="1"/>
                                <field name="amount_rest" readonly="1"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="date_payment" readonly="state in ['draft', 'done']"/>
                            </group>
                            <group string="Informations sur la CNI">
                                <field name="cni" readonly="state in ['draft', 'done']"/>
                                <field name="lieu_delivr_cni" readonly="state in ['draft', 'done']"/>
                                <field name="date_delivr_cni" readonly="state in ['draft', 'done']"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="invoice" string="Liste factures">
                                <field name="facture_ids">
                                    <tree delete="false">
                                        <field name="invoice_id" />
                                        <field name="payment_id" string="N° paiement" />
                                        <field name="structure_frais_line_id" string="Tranche" />
                                        <field name="mode_payment"/>
                                        <field name="amount_total" sum="Total"/>
                                        <!-- <field name="amount_reste" sum="Reste à Payer"/> -->
                                        <field name="to_pay" widget='checkbox' />
                                        <field name="pay_complet" widget='checkbox' />
                                        <field name="date_payment" />
                                        <field name='currency_id' column_invisible="True"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">

                        <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>

                        <field name="message_ids" widget="mail_thread"/>

                    </div>
                </form>
            </field>
        </record>

