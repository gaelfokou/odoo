<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="fee_structure_form" model="ir.ui.view">
            <field name="name">siantou.ems.fee.structure.form</field>
            <field name="model">siantou.ems.fee.structure</field>
            <field name="arch" type="xml">
                <form string="Fee Structure" class="o_invoice_form">
                <sheet string="Fee Structure">
                    <field name="active" invisible="1"/>
                    <!-- <widget name="web_ribbon" title="Archived" bg_color="bg-danger"/> -->
                    <h1 class="mt0">
                    </h1>
                    <group>
                        <group>
                            <field name="fee_structure_name" placeholder="Eg:LKG and UKG"/>
                            <field name="type_frais_id" options="{'no_create': True}"/>
                            <field name="level_id"/>
                            <field name="academic_year"/>
                            <field name="amount_total"/>
                            <field name="type_inclusion_fee" widget="radio"/>
                            <field name="type_paiement" widget="radio"/>
                            <field name="nbre_tranche" invisible="type_paiement == 'pu'"/>
                        </group>
                        <group>
                            <field name="school_id"/>
                            <field name="field_of_study_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook invisible="type_paiement == 'pu'">
                        <page string="Frais">
                            <field name="fee_type_ids" widget="one2many_list">
                                <tree string="Tranches">
                                    <field name="name"/>
                                    <field name="fee_amount"/>
                                    <field name="fee_structure_id" placeholder="Eg: Quarterly"  options="{'no_create': True}"/>
                                    <field name="echeance"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="amount_total" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                </form>
            </field>
        </record>

        <record id="fee_structure_tree" model="ir.ui.view">
            <field name="name">siantou.ems.fee.structure.tree</field>
            <field name="model">siantou.ems.fee.structure</field>
            <field name="arch" type="xml">
                <tree string="Fee Structure" default_order="id desc" default_group_by="type_frais_id">
                    <field name="type_frais_id"/>
                    <field name="level_id"/>
                    <field name="fee_structure_name"/>
                    <field name="field_of_study_ids"/>
                    <field name="academic_year"/>
                    <field name="amount_total"  widget="monetary"/>
                </tree>
            </field>
        </record>

        <record id="action_fee_structure" model="ir.actions.act_window">
            <field name="name">Structure des frais</field>
            <field name="res_model">siantou.ems.fee.structure</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem
          id="menu_fees_configuration"
          parent="menu_education_fee_root" name="Configurations"
          sequence="12"/>
        
        <menuitem action="action_fee_structure"
          id="menu_action_fee_structure"
          parent="menu_fees_configuration"
          sequence="1"/>

    </data>
</odoo>