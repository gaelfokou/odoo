                                                <td style="border: 1px solid black;padding: 4px">
                                                    06</td>
                                                <td style="border: 1px solid black;padding: 4px">
                                                    ICLRCMCXXXX</td>
                                                <td style="border: 1px solid black;padding:
                                                4px" >CM21 10005 00001 02853381001-06</td>
                                            </tr>
                                            <tr>
                                                <td style="border: 1px solid black;padding: 4px">
                                                    UBA</td>
                                                <td style="border: 1px solid black;padding: 4px">
                                                    10033</td>
                                                <td style="border: 1px solid black;padding: 4px">
                                                    05218</td>
                                                <td style="border: 1px solid black;padding: 4px">
                                                    18031000020</td>
                                                <td style="border: 1px solid black;padding: 4px">
                                                    12</td>
                                                <td style="border: 1px solid black;padding: 4px">
                                                    UNAFCMCX</td>
                                                <td style="border: 1px solid black;padding:
                                                4px" >CM21 10033 05218 18031000020-12</td>
                                            </tr>
                                            <tr>
                                                <td style="border: 1px solid black;padding: 4px">
                                                    BICEC</td>
                                                <td style="border: 1px solid black;padding: 4px">
                                                    10001</td>
                                                <td style="border: 1px solid black;padding: 4px">
                                                    06862</td>
                                                <td style="border: 1px solid black;padding: 4px">
                                                    51856862001</td>
                                                <td style="border: 1px solid black;padding: 4px">
                                                    42</td>
                                                <td style="border: 1px solid black;padding: 4px">
                                                    CCEICMCX</td>
                                                <td style="border: 1px solid black;padding:
                                                4px" >CM21 10001 06862 51856862001-42</td>
                                            </tr>
                                            <tr>
                                                <td style="border: 1px solid black;padding: 4px">Ecole
                                                    privée catholique des infirmiers</td>
                                                <td style="border: 1px solid black;padding: 4px">
                                                    ECOBANK</td>
                                                <td style="border: 1px solid black;padding: 4px">
                                                    26011</td>
                                                <td style="border: 1px solid black;padding: 4px">
                                                    26011</td>
                                                <td style="border: 1px solid black;padding: 4px">
                                                    30830019020</td>
                                                <td style="border: 1px solid black;padding: 4px">
                                                    90</td>
                                                <td style="border: 1px solid black;padding: 4px">
                                                    ECOCCMCX</td>
                                                <td style="border: 1px solid black;padding:
                                                4px" >10029 26011 30830019020-90</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="row mt-5">
                                <div class="col-12 text-right">
                                    <h5>LE CHEF SAF</h5>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>