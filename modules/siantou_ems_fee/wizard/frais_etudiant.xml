	<record model="ir.ui.view" id="fscolarite_form_view">
		<field name="name">assistant.etudiant.scolarite</field>
		<field name="model">wizard.etudiant.scolarite</field>
		<field name="arch" type="xml">
			<form string="Scolarité étudiant">
				<group>
					<field name ="redoublant"/>
				</group>
				<group>
					<field name="student_id" options="{'no_open': True, 'no_create': True}"/>
					<field name ="scolarite" attrs="{'invisible': [('redoublant', '=', 'oui')],'required': [('redoublant', '=', 'non')]}"/>
					<field name ="scolaritered" attrs="{'invisible': [('redoublant', '=', 'non')],'required': [('redoublant', '=', 'oui')]}"/>
				</group>
				<group>
					<group>
						<field name ="fee_structure_id" attrs="{'invisible': [('scolarite', '=', 'normal')],'required': [('scolarite', '!=', 'normal')]}"/>
						<field name ="amount" attrs="{'invisible': [('scolarite', '=', 'normal')],'required': [('scolarite', '!=', 'normal')]}"/>
					</group>
					<group>
						<field name="currency_id" invisible="1" />
						<field name ="campus" />
					</group>
				</group>
				<footer>
					<button name="print_etudiant" type="object" string="Valider" confirm="Confirmer le statut de cette scolarité" class="oe_highlight" />
					<!-- ou
					<button special="cancel" string="Annuler"/> -->
				</footer>
			</form>
		</field>
	</record>

