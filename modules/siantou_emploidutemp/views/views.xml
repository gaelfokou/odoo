<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <!-- explicit list view definition -->

    <record model="ir.ui.view" id="siantou_emploidutemp.emploidutemp_view_tree">
      <field name="name">Emploi du temps</field>
      <field name="model">siantou_emploidutemp.emploidutemp</field>
      <field name="type">tree</field>
      <field name="arch" type="xml">
        <tree string="Emploi du temps" default_group_by="filiere_id">
          <field name="filiere_id"/>
          <field name="niveau_id"/>
          <field name="semestre_id"/>
          <field name="salledecour_id"/>
          <!-- <field name="matiere_id"/>
          <field name="configuration_id"/> -->
          <field name="name"/>
          <field name="date"/>
          <field name="debut" placeholder="12:30"/>
          <field name="fin" placeholder="12:30"/>
        </tree>
      </field>
    </record>

    <record model="ir.ui.view" id="siantou_emploidutemp.niveau_view_tree">
      <field name="name">Niveaux</field>
      <field name="model">siantou_emploidutemp.niveau</field>
      <field name="type">tree</field>
      <field name="arch" type="xml">
        <tree string="Niveaux">
          <field name="name"/>
          <field name="valeur"/>
        </tree>
      </field>
    </record>

    <record model="ir.ui.view" id="siantou_emploidutemp.semestre_view_tree">
      <field name="name">Semestres</field>
      <field name="model">siantou_emploidutemp.semestre</field>
      <field name="type">tree</field>
      <field name="arch" type="xml">
        <tree string="Semestres">
          <header>
            <button name="generator_page" type="object" string="Générer un emploi du temps" class="oe_link"/>
          </header>
          <field name="name"/>
          <field name="annee" placeholder="2023-2024"/>
          <field name="valeur"/>
          <field name="debut"/>
          <field name="fin"/>
          <field name="matiere_ids"/>
        </tree>
      </field>
    </record>

    <record model="ir.ui.view" id="siantou_emploidutemp.salledecour_view_tree">
      <field name="name">Salles de cours</field>
      <field name="model">siantou_emploidutemp.salledecour</field>
      <field name="type">tree</field>
      <field name="arch" type="xml">
        <tree string="Salles de cours">
          <field name="name"/>
          <field name="code"/>
          <field name="capacite"/>
        </tree>
      </field>
    </record>

    <record model="ir.ui.view" id="siantou_emploidutemp.filiere_view_tree">
      <field name="name">Filieres</field>
      <field name="model">siantou_emploidutemp.filiere</field>
      <field name="type">tree</field>
      <field name="arch" type="xml">
        <tree string="Filieres">
          <field name="name"/>
          <field name="code"/>
          <field name="niveau_id"/>
          <field name="matiere_ids"/>
        </tree>
      </field>
    </record>

    <record model="ir.ui.view" id="siantou_emploidutemp.filiere_view_form">
      <field name="name">Filieres</field>
      <field name="model">siantou_emploidutemp.filiere</field>
      <field name="type">form</field>
      <field name="arch" type="xml">
        <form string="Filieres">
          <sheet>
            <group>
              <field name="name"/>
              <field name="code"/>
              <field name="niveau_id"/>
              <field name="matiere_ids"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <record model="ir.ui.view" id="siantou_emploidutemp.filiere_view_search">
      <field name="name">Filieres</field>
      <field name="model">siantou_emploidutemp.filiere</field>
      <field name="type">search</field>
      <field name="arch" type="xml">
        <search string="Filieres">
          <field name="name"/>
          <field name="code"/>
          <field name="niveau_id"/>
          <field name="matiere_ids"/>
          <filter string="Filiere" name="code" domain="[('code', '=', 'GI')]"/>
          <group expand="0" string="Group By">
              <filter string="Niveau" name="niveau_id" context="{'group_by': 'niveau_id'}"/>
          </group>
        </search>
      </field>
    </record>

    <record model="ir.ui.view" id="siantou_emploidutemp.matiere_view_tree">
      <field name="name">Matieres</field>
      <field name="model">siantou_emploidutemp.matiere</field>
      <field name="type">tree</field>
      <field name="arch" type="xml">
        <tree string="Matieres">
          <field name="name"/>
          <field name="code"/>
          <field name="tronccommun"/>
          <field name="jour"/>
          <field name="nuit"/>
          <field name="quotahoraire"/>
          <field name="niveau_id"/>
          <field name="filiere_ids"/>
          <field name="semestre_ids"/>
        </tree>
      </field>
    </record>

    <record model="ir.ui.view" id="siantou_emploidutemp.configuration_view_tree">
      <field name="name">Configurations</field>
      <field name="model">siantou_emploidutemp.configuration</field>
      <field name="type">tree</field>
      <field name="arch" type="xml">
        <tree string="Configurations">
          <field name="name"/>
          <field name="code"/>
          <field name="jour"/>
          <field name="date"/>
          <field name="debut" placeholder="12:30"/>
          <field name="fin" placeholder="12:30"/>
        </tree>
      </field>
    </record>


    <!-- actions opening views on models -->

    <record model="ir.actions.act_window" id="siantou_emploidutemp.emploidutemp_action_window">
      <field name="name">Emplois de temps</field>
      <field name="type">ir.actions.act_window</field>
      <field name="res_model">siantou_emploidutemp.emploidutemp</field>
      <field name="view_mode">tree,form</field>
    </record>

    <record model="ir.actions.act_window" id="siantou_emploidutemp.niveau_action_window">
      <field name="name">Niveaux</field>
      <field name="type">ir.actions.act_window</field>
      <field name="res_model">siantou_emploidutemp.niveau</field>
      <field name="view_mode">tree,form</field>
    </record>

    <record model="ir.actions.act_window" id="siantou_emploidutemp.semestre_action_window">
      <field name="name">Semestres</field>
      <field name="type">ir.actions.act_window</field>
      <field name="res_model">siantou_emploidutemp.semestre</field>
      <field name="view_mode">tree,form</field>
    </record>

    <record model="ir.actions.act_window" id="siantou_emploidutemp.salledecour_action_window">
      <field name="name">Salles de cours</field>
      <field name="type">ir.actions.act_window</field>
      <field name="res_model">siantou_emploidutemp.salledecour</field>
      <field name="view_mode">tree,form</field>
    </record>

    <record model="ir.actions.act_window" id="siantou_emploidutemp.filiere_action_window">
      <field name="name">Filieres</field>
      <field name="type">ir.actions.act_window</field>
      <field name="res_model">siantou_emploidutemp.filiere</field>
      <field name="view_mode">tree,form,search</field>
    </record>

    <record model="ir.actions.act_window" id="siantou_emploidutemp.matiere_action_window">
      <field name="name">Matieres</field>
      <field name="type">ir.actions.act_window</field>
      <field name="res_model">siantou_emploidutemp.matiere</field>
      <field name="view_mode">tree,form</field>
    </record>

    <record model="ir.actions.act_window" id="siantou_emploidutemp.configuration_action_window">
      <field name="name">Configurations</field>
      <field name="type">ir.actions.act_window</field>
      <field name="res_model">siantou_emploidutemp.configuration</field>
      <field name="view_mode">tree,form</field>
    </record>


    <!-- Top menu item -->

    <menuitem name="Emplois de temps" id="siantou_emploidutemp.root_menu_item"
              action="siantou_emploidutemp.emploidutemp_action_window"/>

    <!-- menu categories -->

    <menuitem name="Emplois de temps" id="siantou_emploidutemp.emploidutemp_menu_item" parent="siantou_emploidutemp.root_menu_item"
              action="siantou_emploidutemp.emploidutemp_action_window"/>
    <menuitem name="Niveaux" id="siantou_emploidutemp.niveau_menu_item" parent="siantou_emploidutemp.root_menu_item"
              action="siantou_emploidutemp.niveau_action_window"/>
    <menuitem name="Semestres" id="siantou_emploidutemp.semestre_menu_item" parent="siantou_emploidutemp.root_menu_item"
              action="siantou_emploidutemp.semestre_action_window"/>
    <menuitem name="Salles de cours" id="siantou_emploidutemp.salledecour_menu_item" parent="siantou_emploidutemp.root_menu_item"
              action="siantou_emploidutemp.salledecour_action_window"/>
    <menuitem name="Filieres" id="siantou_emploidutemp.filiere_menu_item" parent="siantou_emploidutemp.root_menu_item"
              action="siantou_emploidutemp.filiere_action_window"/>
    <menuitem name="Matieres" id="siantou_emploidutemp.matiere_menu_item" parent="siantou_emploidutemp.root_menu_item"
              action="siantou_emploidutemp.matiere_action_window"/>
    <menuitem name="Configurations" id="siantou_emploidutemp.configuration_menu_item" parent="siantou_emploidutemp.root_menu_item"
              action="siantou_emploidutemp.configuration_action_window"/>

  </data>
</odoo>