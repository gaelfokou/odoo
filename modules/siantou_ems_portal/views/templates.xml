                            <th class="text-left">Montant payé</th>
                            <th class="text-left">Statut</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="schoolfees" t-as="record">
                            <tr>
                                <td class='text-left'>
                                    <span t-esc="record['date_payment']"/>
                                </td>
                                <td class='text-left'>
                                    <span t-esc="record['name']"/>
                                </td>
                                <td class='text-left'>
                                    <span t-esc="record['reference']"/>
                                </td>
                                <td class='text-left'>
                                    <span t-esc="record['structure_frais_type_paiement']"/>
                                </td>
                                <td class='text-left'>
                                    <span t-esc="record['structure_frais_name']"/>
                                </td>
                                <td class='text-left'>
                                    <span t-esc="record['structure_frais_amount_total']"/>
                                </td>
                                <td class='text-left'>
                                    <span t-esc="record['amount']"/>
                                </td>
                                <td class='text-left'>
                                    <span t-esc="record['state']"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                    <tfooter>
                        <tr>
                            <th class="text-left" colspan="8" style="box-shadow: inset 0 0 0 9999px transparent; border-style: hidden;"><br/></th>
                        </tr>
                        <tr>
                            <th class="text-left" colspan="1">Total net à payer</th>
                            <th class="text-left" colspan="7"><span t-esc="total_structure_amount"/></th>
                        </tr>
                        <tr>
                            <th class="text-left" colspan="1">Total montant payé</th>
                            <th class="text-left" colspan="7"><span t-esc="total_amount"/></th>
                        </tr>
                        <tr>
                            <th class="text-left" colspan="1">Total restant à payer</th>
                            <th class="text-left" colspan="7"><span t-esc="total_rest_amount"/></th>
                        </tr>
                    </tfooter>
                </t>
            </t>
        </template>

