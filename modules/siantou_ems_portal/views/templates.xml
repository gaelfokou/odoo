        <!-- Emploi du temps -->

        <template id="siantou_ems_portal_timetable" name="siantou_ems_portal.timetable" inherit_id="portal.portal_breadcrumbs" priority="30">
            <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
                <li t-if="page_name == 'timetable'" t-attf-class="breadcrumb-item #{'active ' if timetable else ''}">
                    <a t-if="timetable" t-attf-href="/my/timetable?{{ keep_query() }}">Emploi du temps</a>
                    <t t-else="">Emploi du temps</t>
                </li>
            </xpath>
        </template>

        <template id="siantou_ems_portal_my_home_menu_timetable" name="siantou_ems_portal.timetable" inherit_id="portal.portal_my_home" priority="30">
            <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
                <t t-set="portal_client_category_enable" t-value="True"/>
            </xpath>
            <div id="portal_client_category" position="inside">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/siantou_ems_portal/static/src/img/timesheet_grid.png'"/>
                    <t t-set="title">Emploi du temps</t>
                    <t t-set="url" t-value="'/my/timetable'"/>
                    <t t-set="text">Affichez votre emploi du temps</t>
                    <t t-set="placeholder_count" t-value="'portal_timetable'"/>
                </t>
            </div>
        </template>

        <template id="siantou_ems_portal_my_home_timetable_calendar_views" name="siantou_ems_portal.print_timetable">
            <t t-call="portal.portal_layout">
                <t t-set="breadcrumbs_searchbar" t-value="True"/>
                <t t-call="portal.portal_searchbar">
                    <t t-set="title">Emploi du temps</t>
                </t>
                <t t-call="portal.portal_table">
                    <!-- <div id="siantou_ems_portal_print_timetable_container"></div> -->
                    <div>
                        <a t-attf-href="/my/timetable/download"><button class="btn btn-primary">Impression de l'emploi du temps</button></a>
                        <a t-attf-href="/my/timetable?view_type=calendar"><button class="btn btn-primary">Calendrier</button></a>
                        <a t-attf-href="/my/timetable?view_type=list"><button class="btn btn-primary">Liste</button></a><br/><br/>
                    </div>
                    <t t-set="weekdays" t-value="timetables.keys()"/>
                    <t t-set="total_timetables" t-value="[(i+1) for i in range(timetable_pages_total)]"/>
                    <t t-set="total_timetables" t-value="[total_timetables[i:i+5] for i in range(0, len(total_timetables), 5)]"/>
                    <t t-set="total_timetables" t-value="[p for p in total_timetables if (timetable_page_number in p or (timetable_page_number - 1) in p or (timetable_page_number + 1) in p)]"/>
                    <t t-set="total_timetables" t-value="[m for p in total_timetables for m in p] if len(total_timetables) > 0 else []"/>
                    <t t-foreach="weekdays" t-as="monday">
                        <t t-set="current_hours" t-value="[i for i in range(len(timetables[monday]['Heure']))]"/>
                        <thead>
                            <tr>
                                <th class="text-center" colspan="8" style="box-shadow: inset 0 0 0 9999px transparent; border-style: hidden;">
                                    <span t-esc="'Période :'"/>
                                    <span t-esc="monday"/>
                                </th>
                            </tr>
                        </thead>
                        <thead>
                            <tr>
                                <th class="text-left" colspan="8" style="box-shadow: inset 0 0 0 9999px transparent; border-style: hidden;"><br/></th>
                            </tr>
                        </thead>
                        <thead>
                            <tr class="active">
                                <th class="text-center">Heure</th>
                                <th class="text-center">Lundi</th>
                                <th class="text-center">Mardi</th>
                                <th class="text-center">Mercredi</th>
                                <th class="text-center">Jeudi</th>
                                <th class="text-center">Vendredi</th>
                                <th class="text-center">Samedi</th>
                                <th class="text-center">Dimanche</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="current_hours" t-as="hour">
                                <tr>
                                    <td class='text-center'>
                                        <span t-esc="timetables[monday]['Heure'][hour]"/>
                                    </td>
                                    <td class='text-center'>
                                        <t t-foreach="timetables[monday]['Lundi'][hour]" t-as="record">
                                            <span t-esc="record['subject_name']"/>
                                            <span t-esc="'(' + record['subject_code'] + ')'"/>
                                            <br/>
                                            <span t-esc="record['classroom_name']"/>
                                            <span t-esc="'/ ' + record['building_name']"/>
                                            <br/>
                                            <span t-esc="record['employee_name']"/>
                                            <br/>
                                            <span>-----</span>
                                            <br/>
                                        </t>
                                    </td>
                                    <td class='text-center'>
                                        <t t-foreach="timetables[monday]['Mardi'][hour]" t-as="record">
                                            <span t-esc="record['subject_name']"/>
                                            <span t-esc="' (' + record['subject_code'] + ')'"/>
                                            <br/>
                                            <span t-esc="record['classroom_name']"/>
                                            <span t-esc="'/ ' + record['building_name']"/>
                                            <br/>
                                            <span t-esc="record['employee_name']"/>
                                            <br/>
                                            <span>-----</span>
                                            <br/>
                                        </t>
                                    </td>
                                    <td class='text-center'>
                                        <t t-foreach="timetables[monday]['Mercredi'][hour]" t-as="record">
                                            <span t-esc="record['subject_name']"/>
                                            <span t-esc="' (' + record['subject_code'] + ')'"/>
                                            <br/>
                                            <span t-esc="record['classroom_name']"/>
                                            <span t-esc="'/ ' + record['building_name']"/>
                                            <br/>
                                            <span t-esc="record['employee_name']"/>
                                            <br/>
                                            <span>-----</span>
                                            <br/>
                                        </t>
                                    </td>
                                    <td class='text-center'>
                                        <t t-foreach="timetables[monday]['Jeudi'][hour]" t-as="record">
                                            <span t-esc="record['subject_name']"/>
                                            <span t-esc="' (' + record['subject_code'] + ')'"/>
                                            <br/>
                                            <span t-esc="record['classroom_name']"/>
                                            <span t-esc="'/ ' + record['building_name']"/>
                                            <br/>
                                            <span t-esc="record['employee_name']"/>
                                            <br/>
                                            <span>-----</span>
                                            <br/>
                                        </t>
                                    </td>
                                    <td class='text-center'>
                                        <t t-foreach="timetables[monday]['Vendredi'][hour]" t-as="record">
                                            <span t-esc="record['subject_name']"/>
                                            <span t-esc="' (' + record['subject_code'] + ')'"/>
                                            <br/>
                                            <span t-esc="record['classroom_name']"/>
                                            <span t-esc="'/ ' + record['building_name']"/>
                                            <br/>
                                            <span t-esc="record['employee_name']"/>
                                            <br/>
                                            <span>-----</span>
                                            <br/>
                                        </t>
                                    </td>
                                    <td class='text-center'>
                                        <t t-foreach="timetables[monday]['Samedi'][hour]" t-as="record">
                                            <span t-esc="record['subject_name']"/>
                                            <span t-esc="' (' + record['subject_code'] + ')'"/>
                                            <br/>
                                            <span t-esc="record['classroom_name']"/>
                                            <span t-esc="'/ ' + record['building_name']"/>
                                            <br/>
                                            <span t-esc="record['employee_name']"/>
                                            <br/>
                                            <span>-----</span>
                                            <br/>
                                        </t>
                                    </td>
                                    <td class='text-center'>
                                        <t t-foreach="timetables[monday]['Dimanche'][hour]" t-as="record">
                                            <span t-esc="record['subject_name']"/>
                                            <span t-esc="' (' + record['subject_code'] + ')'"/>
                                            <br/>
                                            <span t-esc="record['classroom_name']"/>
                                            <span t-esc="'/ ' + record['building_name']"/>
                                            <br/>
                                            <span t-esc="record['employee_name']"/>
                                            <br/>
                                            <span>-----</span>
                                            <br/>
                                        </t>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                        <tfooter>
                            <tr>
                                <th class="text-left" colspan="8" style="box-shadow: inset 0 0 0 9999px transparent; border-style: hidden;"><br/></th>
                            </tr>
                        </tfooter>
                        <tbody>
                            <tr>
                                <td class="text-left" colspan="8">
                                    <nav aria-label="Page navigation timetable">
                                        <ul class="pagination">
                                            <li class="page-item"><a class="page-link" t-attf-href="/my/timetable/page/1?view_type={{ timetable_view_type }}">Précédent</a></li>
                                            <t t-foreach="total_timetables" t-as="p">
                                                <t t-if="p == timetable_page_number">
                                                    <li class="page-item active"><a class="page-link" t-attf-href="/my/timetable/page/{{ p }}?view_type={{ timetable_view_type }}" t-esc="p"/></li>
                                                </t>
                                                <t t-else="">
                                                    <li class="page-item"><a class="page-link" t-attf-href="/my/timetable/page/{{ p }}?view_type={{ timetable_view_type }}" t-esc="p"/></li>
                                                </t>
                                            </t>
                                            <li class="page-item"><a class="page-link" t-attf-href="/my/timetable/page/{{ timetable_pages_total }}?view_type={{ timetable_view_type }}">Suivant</a></li>
                                        </ul>
                                    </nav>
                                </td>
                            </tr>
                        </tbody>
                        <tfooter>
                            <tr>
                                <th class="text-left" colspan="8" style="box-shadow: inset 0 0 0 9999px transparent; border-style: hidden;"><br/></th>
                            </tr>
                        </tfooter>
                    </t>
                </t>
            </t>
        </template>

        <template id="siantou_ems_portal_my_home_timetable_list_views" name="siantou_ems_portal.print_timetable">
            <t t-call="portal.portal_layout">
                <t t-set="breadcrumbs_searchbar" t-value="True"/>
                <t t-call="portal.portal_searchbar">
                    <t t-set="title">Emploi du temps</t>
                </t>
                <t t-call="portal.portal_table">
                    <!-- <div id="siantou_ems_portal_print_timetable_container"></div> -->
                    <div>
                        <a t-attf-href="/my/timetable/download"><button class="btn btn-primary">Impression de l'emploi du temps</button></a>
                        <a t-attf-href="/my/timetable?view_type=calendar"><button class="btn btn-primary">Calendrier</button></a>
                        <a t-attf-href="/my/timetable?view_type=list"><button class="btn btn-primary">Liste</button></a><br/><br/>
                    </div>
                    <t t-set="total_timetables" t-value="[(i+1) for i in range(timetable_pages_total)]"/>
                    <t t-set="total_timetables" t-value="[total_timetables[i:i+5] for i in range(0, len(total_timetables), 5)]"/>
                    <t t-set="total_timetables" t-value="[p for p in total_timetables if (timetable_page_number in p or (timetable_page_number - 1) in p or (timetable_page_number + 1) in p)]"/>
                    <t t-set="total_timetables" t-value="[m for p in total_timetables for m in p] if len(total_timetables) > 0 else []"/>
                    <thead>
                        <tr class="active">
                            <th class="text-left">Date</th>
                            <th class="text-left">Filière</th>
                            <th class="text-left">Semestre</th>
                            <th class="text-left">Niveau</th>
                            <th class="text-left">Cours</th>
                            <th class="text-left">Salle de classe</th>
                            <th class="text-left">Enseignant</th>
                            <th class="text-left">Jour de la semaine</th>
                            <th class="text-left">Heure de début</th>
                            <th class="text-left">Heure de fin</th>
                            <th class="text-left">Statut</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="timetables" t-as="record">
                            <tr>
                                <td class='text-left'>
                                    <span t-esc="record['date']"/>
                                </td>
                                <td class='text-left'>
                                    <span t-esc="record['field_of_study_name']"/>
                                </td>
                                <td class='text-left'>
                                    <span t-esc="record['semester_name']"/>
                                </td>
                                <td class='text-left'>
                                    <span t-esc="record['level_name']"/>
                                </td>
                                <td class='text-left'>
                                    <span t-esc="record['subject_name']"/>
                                </td>
                                <td class='text-left'>
                                    <span t-esc="record['classroom_name']"/>
                                </td>
                                <td class='text-left'>
                                    <span t-esc="record['employee_name']"/>
                                </td>
                                <td class='text-left'>
                                    <span t-esc="record['day_of_week']"/>
                                </td>
                                <td class='text-left'>
                                    <span t-esc="record['start_time']"/>
                                </td>
                                <td class='text-left'>
                                    <span t-esc="record['end_time']"/>
                                </td>
                                <td class='text-left'>
                                    <span t-esc="record['status']"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                    <tfooter>
                        <tr>
                            <th class="text-left" colspan="11" style="box-shadow: inset 0 0 0 9999px transparent; border-style: hidden;"><br/></th>
                        </tr>
                    </tfooter>
                    <tbody>
                        <tr>
                            <td class="text-left" colspan="11">
                                <nav aria-label="Page navigation timetable">
                                    <ul class="pagination">
                                        <li class="page-item"><a class="page-link" t-attf-href="/my/timetable/page/1?view_type={{ timetable_view_type }}">Précédent</a></li>
                                        <t t-foreach="total_timetables" t-as="p">
                                            <t t-if="p == timetable_page_number">
                                                <li class="page-item active"><a class="page-link" t-attf-href="/my/timetable/page/{{ p }}?view_type={{ timetable_view_type }}" t-esc="p"/></li>
                                            </t>
                                            <t t-else="">
                                                <li class="page-item"><a class="page-link" t-attf-href="/my/timetable/page/{{ p }}?view_type={{ timetable_view_type }}" t-esc="p"/></li>
                                            </t>
                                        </t>
                                        <li class="page-item"><a class="page-link" t-attf-href="/my/timetable/page/{{ timetable_pages_total }}?view_type={{ timetable_view_type }}">Suivant</a></li>
                                    </ul>
                                </nav>
                            </td>
                        </tr>
                    </tbody>
                    <tfooter>
                        <tr>
                            <th class="text-left" colspan="11" style="box-shadow: inset 0 0 0 9999px transparent; border-style: hidden;"><br/></th>
                        </tr>
                    </tfooter>
                </t>
            </t>
        </template>

        <!-- Frais de scolarité -->

        <template id="siantou_ems_portal_schoolfee" name="siantou_ems_portal.schoolfee" inherit_id="portal.portal_breadcrumbs" priority="30">
            <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
                <li t-if="page_name == 'schoolfee'" t-attf-class="breadcrumb-item #{'active ' if schoolfee else ''}">
                    <a t-if="schoolfee" t-attf-href="/my/schoolfee?{{ keep_query() }}">Frais de scolarité</a>
                    <t t-else="">Frais de scolarité</t>
                </li>
            </xpath>
        </template>

        <template id="siantou_ems_portal_my_home_menu_schoolfee" name="siantou_ems_portal.schoolfee" inherit_id="portal.portal_my_home" priority="30">
            <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
                <t t-set="portal_client_category_enable" t-value="True"/>
