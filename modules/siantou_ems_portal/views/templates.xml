        <!-- Emploi du temps -->

        <template id="siantou_ems_portal_timetable" name="siantou_ems_portal.timetable" inherit_id="portal.portal_breadcrumbs" priority="30">
            <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
                <li t-if="page_name == 'timetable'" t-attf-class="breadcrumb-item #{'active ' if timetable else ''}">
                    <a t-if="timetable" t-attf-href="/my/timetable?{{ keep_query() }}">Emploi du temps</a>
                    <t t-else="">Emploi du temps</t>
                </li>
            </xpath>
        </template>

        <template id="siantou_ems_portal_my_home_menu_timetable" name="siantou_ems_portal.timetable" inherit_id="portal.portal_my_home" priority="30">
            <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
                <t t-set="portal_client_category_enable" t-value="True"/>
            </xpath>
            <div id="portal_client_category" position="inside">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/siantou_ems_portal/static/src/img/timesheet_grid.png'"/>
                    <t t-set="title">Emploi du temps</t>
                    <t t-set="url" t-value="'/my/timetable'"/>
                    <t t-set="text">Affichez votre emploi du temps</t>
                    <t t-set="placeholder_count" t-value="'portal_timetable'"/>
                </t>
            </div>
        </template>

        <template id="siantou_ems_portal_my_home_timetable_calendar_views" name="siantou_ems_portal.print_timetable">
            <t t-call="portal.portal_layout">
                <t t-set="breadcrumbs_searchbar" t-value="True"/>
                <t t-call="portal.portal_searchbar">
                    <t t-set="title">Emploi du temps</t>
                </t>
                <t t-call="portal.portal_table">
                    <!-- <div id="siantou_ems_portal_print_timetable_container"></div> -->
                    <div>
                        <a t-attf-href="/my/timetable/download"><button class="btn btn-primary">Impression de l'emploi du temps</button></a>
                        <a t-attf-href="/my/timetable?view_type=calendar"><button class="btn btn-primary">Calendrier</button></a>
                        <a t-attf-href="/my/timetable?view_type=list"><button class="btn btn-primary">Liste</button></a><br/><br/>
                    </div>
                    <t t-set="hour_timetables" t-value="[0, 1, 2, 3, 4]"/>
                    <t t-set="week_timetables" t-value="timetables.keys()"/>
                    <t t-foreach="week_timetables" t-as="monday">
                        <thead>
                            <tr>
                                <th class="text-center" colspan="8" style="box-shadow: inset 0 0 0 9999px transparent;">
                                    <span t-esc="'Période :'"/>
                                    <span t-esc="monday"/>
                                </th>
                            </tr>
                        </thead>
                        <thead>
                            <tr class="active">
                                <th class="text-center">Heure</th>
                                <th class="text-center">Lundi</th>
                                <th class="text-center">Mardi</th>
                                <th class="text-center">Mercredi</th>
                                <th class="text-center">Jeudi</th>
                                <th class="text-center">Vendredi</th>
                                <th class="text-center">Samedi</th>
                                <th class="text-center">Dimanche</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="hour_timetables" t-as="hour">
                                <tr>
                                    <td class='text-center'>
                                        <span t-esc="timetables[monday]['Heure'][hour]"/>
                                    </td>
                                    <td class='text-center'>
                                        <t t-if="timetables[monday]['Lundi'][hour] != ''">
                                            <span t-esc="timetables[monday]['Lundi'][hour]['subject_name']"/>
                                            <span t-esc="'(' + timetables[monday]['Lundi'][hour]['subject_code'] + ')'"/>
                                            <br/>
                                            <span t-esc="timetables[monday]['Lundi'][hour]['classroom_name']"/>
                                            <span t-esc="'/ ' + timetables[monday]['Lundi'][hour]['building_name']"/>
                                            <br/>
                                            <span t-esc="timetables[monday]['Lundi'][hour]['employee_name']"/>
                                        </t>
                                    </td>
                                    <td class='text-center'>
                                        <t t-if="timetables[monday]['Mardi'][hour] != ''">
                                            <span t-esc="timetables[monday]['Mardi'][hour]['subject_name']"/>
                                            <span t-esc="' (' + timetables[monday]['Mardi'][hour]['subject_code'] + ')'"/>
                                            <br/>
                                            <span t-esc="timetables[monday]['Mardi'][hour]['classroom_name']"/>
                                            <span t-esc="'/ ' + timetables[monday]['Mardi'][hour]['building_name']"/>
                                            <br/>
                                            <span t-esc="timetables[monday]['Mardi'][hour]['employee_name']"/>
                                        </t>
                                    </td>
                                    <td class='text-center'>
                                        <t t-if="timetables[monday]['Mercredi'][hour] != ''">
                                            <span t-esc="timetables[monday]['Mercredi'][hour]['subject_name']"/>
                                            <span t-esc="' (' + timetables[monday]['Mercredi'][hour]['subject_code'] + ')'"/>
                                            <br/>
                                            <span t-esc="timetables[monday]['Mercredi'][hour]['classroom_name']"/>
                                            <span t-esc="'/ ' + timetables[monday]['Mercredi'][hour]['building_name']"/>
                                            <br/>
                                            <span t-esc="timetables[monday]['Mercredi'][hour]['employee_name']"/>
                                        </t>
                                    </td>
                                    <td class='text-center'>
                                        <t t-if="timetables[monday]['Jeudi'][hour] != ''">
                                            <span t-esc="timetables[monday]['Jeudi'][hour]['subject_name']"/>
                                            <span t-esc="' (' + timetables[monday]['Jeudi'][hour]['subject_code'] + ')'"/>
                                            <br/>
                                            <span t-esc="timetables[monday]['Jeudi'][hour]['classroom_name']"/>
                                            <span t-esc="'/ ' + timetables[monday]['Jeudi'][hour]['building_name']"/>
                                            <br/>
                                            <span t-esc="timetables[monday]['Jeudi'][hour]['employee_name']"/>
                                        </t>
                                    </td>
                                    <td class='text-center'>
                                        <t t-if="timetables[monday]['Vendredi'][hour] != ''">
                                            <span t-esc="timetables[monday]['Vendredi'][hour]['subject_name']"/>
                                            <span t-esc="' (' + timetables[monday]['Vendredi'][hour]['subject_code'] + ')'"/>
                                            <br/>
                                            <span t-esc="timetables[monday]['Vendredi'][hour]['classroom_name']"/>
                                            <span t-esc="'/ ' + timetables[monday]['Vendredi'][hour]['building_name']"/>
                                            <br/>
                                            <span t-esc="timetables[monday]['Vendredi'][hour]['employee_name']"/>
                                        </t>
                                    </td>
                                    <td class='text-center'>
                                        <t t-if="timetables[monday]['Samedi'][hour] != ''">
                                            <span t-esc="timetables[monday]['Samedi'][hour]['subject_name']"/>
                                            <span t-esc="' (' + timetables[monday]['Samedi'][hour]['subject_code'] + ')'"/>
                                            <br/>
                                            <span t-esc="timetables[monday]['Samedi'][hour]['classroom_name']"/>
                                            <span t-esc="'/ ' + timetables[monday]['Samedi'][hour]['building_name']"/>
                                            <br/>
                                            <span t-esc="timetables[monday]['Samedi'][hour]['employee_name']"/>
                                        </t>
                                    </td>
                                    <td class='text-center'>
                                        <t t-if="timetables[monday]['Dimanche'][hour] != ''">
                                            <span t-esc="timetables[monday]['Dimanche'][hour]['subject_name']"/>
                                            <span t-esc="' (' + timetables[monday]['Dimanche'][hour]['subject_code'] + ')'"/>
                                            <br/>
                                            <span t-esc="timetables[monday]['Dimanche'][hour]['classroom_name']"/>
                                            <span t-esc="'/ ' + timetables[monday]['Dimanche'][hour]['building_name']"/>
                                            <br/>
                                            <span t-esc="timetables[monday]['Dimanche'][hour]['employee_name']"/>
                                        </t>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                        <tfooter>
                            <tr>
                                <th class="text-left" colspan="8" style="box-shadow: inset 0 0 0 9999px transparent;"><br/></th>
                            </tr>
                        </tfooter>
                        <tbody>
                            <tr>
                                <td class="text-left" colspan="8">
                                    <nav aria-label="Page navigation timetable">
                                        <ul class="pagination">
                                            <li class="page-item"><a class="page-link" t-attf-href="/my/timetable/page/{{ timetable_page_number }}?view_type={{ timetable_view_type }}">Précédent</a></li>
                                            <li class="page-item"><a class="page-link" t-attf-href="/my/timetable/page/{{ timetable_page_number }}?view_type={{ timetable_view_type }}">1</a></li>
                                            <li class="page-item"><a class="page-link" t-attf-href="/my/timetable/page/{{ timetable_page_number }}?view_type={{ timetable_view_type }}">2</a></li>
                                            <li class="page-item"><a class="page-link" t-attf-href="/my/timetable/page/{{ timetable_page_number }}?view_type={{ timetable_view_type }}">3</a></li>
                                            <li class="page-item"><a class="page-link" t-attf-href="/my/timetable/page/{{ timetable_page_number }}?view_type={{ timetable_view_type }}">Suivant</a></li>
                                        </ul>
                                    </nav>
                                </td>
                            </tr>
                        </tbody>
                        <tfooter>
                            <tr>
                                <th class="text-left" colspan="8" style="box-shadow: inset 0 0 0 9999px transparent;"><br/></th>
                            </tr>
                        </tfooter>
                    </t>
                </t>
            </t>
        </template>

        <template id="siantou_ems_portal_my_home_timetable_list_views" name="siantou_ems_portal.print_timetable">
            <t t-call="portal.portal_layout">
                <t t-set="breadcrumbs_searchbar" t-value="True"/>
                <t t-call="portal.portal_searchbar">
                    <t t-set="title">Emploi du temps</t>
                </t>
                <t t-call="portal.portal_table">
                    <!-- <div id="siantou_ems_portal_print_timetable_container"></div> -->
                    <div>
                        <a t-attf-href="/my/timetable/download"><button class="btn btn-primary">Impression de l'emploi du temps</button></a>
                        <a t-attf-href="/my/timetable?view_type=calendar"><button class="btn btn-primary">Calendrier</button></a>
                        <a t-attf-href="/my/timetable?view_type=list"><button class="btn btn-primary">Liste</button></a><br/><br/>
                    </div>
                    <thead>
                        <tr class="active">
                            <th class="text-left">Date</th>
                            <th class="text-left">Filière</th>
                            <th class="text-left">Semestre</th>
                            <th class="text-left">Niveau</th>
                            <th class="text-left">Cours</th>
                            <th class="text-left">Salle de classe</th>
                            <th class="text-left">Enseignant</th>
                            <th class="text-left">Jour de la semaine</th>
                            <th class="text-left">Heure de début</th>
                            <th class="text-left">Heure de fin</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="timetables" t-as="record">
                            <tr>
                                <td class='text-left'>
                                    <span t-esc="record['date']"/>
                                </td>
                                <td class='text-left'>
                                    <span t-esc="record['field_of_study_name']"/>
                                </td>
                                <td class='text-left'>
                                    <span t-esc="record['semester_name']"/>
                                </td>
                                <td class='text-left'>
                                    <span t-esc="record['level_name']"/>
                                </td>
                                <td class='text-left'>
                                    <span t-esc="record['subject_name']"/>
                                </td>
                                <td class='text-left'>
                                    <span t-esc="record['classroom_name']"/>
                                </td>
                                <td class='text-left'>
                                    <span t-esc="record['employee_name']"/>
                                </td>
                                <td class='text-left'>
                                    <span t-esc="record['day_of_week']"/>
                                </td>
                                <td class='text-left'>
                                    <span t-esc="record['start_time']"/>
                                </td>
                                <td class='text-left'>
                                    <span t-esc="record['end_time']"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                    <tfooter>
                        <tr>
                            <th class="text-left" colspan="10" style="box-shadow: inset 0 0 0 9999px transparent;"><br/></th>
                        </tr>
                    </tfooter>
                    <tbody>
                        <tr>
                            <td class="text-left" colspan="10">
                            </td>
                        </tr>
                    </tbody>
                    <tfooter>
                        <tr>
                            <th class="text-left" colspan="10" style="box-shadow: inset 0 0 0 9999px transparent;"><br/></th>
                        </tr>
                    </tfooter>
                </t>
            </t>
        </template>

        <!-- Frais de scolarité -->

        <template id="siantou_ems_portal_schoolfee" name="siantou_ems_portal.schoolfee" inherit_id="portal.portal_breadcrumbs" priority="30">
            <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
                <li t-if="page_name == 'schoolfee'" t-attf-class="breadcrumb-item #{'active ' if schoolfee else ''}">
                    <a t-if="schoolfee" t-attf-href="/my/schoolfee?{{ keep_query() }}">Frais de scolarité</a>
                    <t t-else="">Frais de scolarité</t>
                </li>
            </xpath>
        </template>

        <template id="siantou_ems_portal_my_home_menu_schoolfee" name="siantou_ems_portal.schoolfee" inherit_id="portal.portal_my_home" priority="30">
            <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
                <t t-set="portal_client_category_enable" t-value="True"/>
            </xpath>
            <div id="portal_client_category" position="inside">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/siantou_ems_portal/static/src/img/fee_grid.png'"/>
                    <t t-set="title">Frais de scolarité</t>
                    <t t-set="url" t-value="'/my/schoolfee'"/>
                    <t t-set="text">Affichez vos frais de scolarité</t>
                    <t t-set="placeholder_count" t-value="'portal_schoolfee'"/>
                </t>
            </div>
        </template>

        <template id="siantou_ems_portal_my_home_schoolfee_views" name="siantou_ems_portal.print_schoolfee">
            <t t-call="portal.portal_layout">
                <t t-set="breadcrumbs_searchbar" t-value="True"/>
                <t t-call="portal.portal_searchbar">
                    <t t-set="title">Frais de scolarité</t>
                </t>
                <t t-call="portal.portal_table">
                    <thead>
                        <tr class="active">
                            <th class="text-left">Date</th>
                            <th class="text-left">Réference</th>
                            <th class="text-left">Réference du reçu</th>
                            <th class="text-left">Type de paiement</th>
                            <th class="text-left">Description</th>
                            <th class="text-left">Net à payer</th>
                            <th class="text-left">Montant payé</th>
                            <th class="text-left">Statut</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="schoolfees" t-as="record">
                            <tr>
                                <td class='text-left'>
                                    <span t-esc="record['date_payment']"/>
                                </td>
                                <td class='text-left'>
                                    <span t-esc="record['name']"/>
                                </td>
                                <td class='text-left'>
                                    <span t-esc="record['reference']"/>
                                </td>
                                <td class='text-left'>
                                    <span t-esc="record['structure_frais_type_paiement']"/>
                                </td>
                                <td class='text-left'>
                                    <span t-esc="record['structure_frais_name']"/>
                                </td>
                                <td class='text-left'>
                                    <span t-esc="record['structure_frais_amount_total']"/>
                                </td>
                                <td class='text-left'>
                                    <span t-esc="record['amount']"/>
                                </td>
                                <td class='text-left'>
                                    <span t-esc="record['state']"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                    <tfooter>
                        <tr>
                            <th class="text-left" colspan="8" style="box-shadow: inset 0 0 0 9999px transparent;"><br/></th>
                        </tr>
                        <tr>
                            <th class="text-left" colspan="1">Total net à payer</th>
                            <th class="text-left" colspan="7"><span t-esc="total_structure_amount"/></th>
                        </tr>
                        <tr>
                            <th class="text-left" colspan="1">Total montant payé</th>
                            <th class="text-left" colspan="7"><span t-esc="total_amount"/></th>
                        </tr>
                        <tr>
                            <th class="text-left" colspan="1">Total restant à payer</th>
                            <th class="text-left" colspan="7"><span t-esc="total_rest_amount"/></th>
                        </tr>
                    </tfooter>
                </t>
            </t>
        </template>

