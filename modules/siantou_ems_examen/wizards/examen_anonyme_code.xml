<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>

        <record id="create_examen_session_line_result_wizard_form_view" model="ir.ui.view">
            <field name="name">examen.session.line.result.wizard.form</field>
            <field name="model">examen.session.line.result.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <field name="results">
                        <tree editable="top">
                            <field name="student_id"/>
                            <field name="anonyma_code"/>
                        </tree>
                    </field>
                </form>
            </field>
        </record>

        <record id="action_anonyma_wizard" model="ir.actions.act_window">
            <field name="name">Anonymation des notes</field>
            <field name="res_model">examen.session.line.result.wizard</field>
            <field name="view_mode">tree,form</field>
            <field name="type">ir.actions.act_window</field>
            <field name="target">new</field>
            <field name="view_id" ref="create_examen_session_line_result_wizard_form_view"/>
        </record>
    </data>
</odoo>