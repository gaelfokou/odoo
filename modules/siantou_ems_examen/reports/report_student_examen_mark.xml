<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_examen_mark" model="report.paperformat">
        <field name="name">Format du papier</field>
        <field name="default" eval="True" />
        <field name="orientation">Landscape</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="True" />
        <field name="header_spacing">5</field>
        <field name="dpi">90</field>
    </record>
    <record id="action_report_student_examen_mark_pdf" model="ir.actions.report">
        <field name="name">Note PDF</field>
        <field name="model">examen.resultat.subject</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">siantou_ems_examen.report_student_examen_mark_pdf_template</field>
        <field name="report_file">siantou_ems_examen.report_student_examen_mark_pdf_template</field>
        <field name="print_report_name">f"Notes - {student['name']}" </field>
        <!-- <field name="print_report_name">'Paiement de - %s' % (data.student)</field> -->
        <!-- <field name="binding_model_id" eval="'False'"/> -->
        <!-- <field name="paperformat_id" ref="paperformat_examen_mark" /> -->
        <!-- <field name="binding_type">report</field> -->
    </record>

