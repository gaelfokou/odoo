        <record id="seq_student_qr_code" model="ir.sequence">
            <field name="name">Séquence QR Code Étudiant</field>
            <field name="code">student.qr.code</field>
            <field name="prefix">QR-</field>
            <field name="padding">5</field>
        </record>
        

    </data>


</odoo>