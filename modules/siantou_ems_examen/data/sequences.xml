<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>

        <record id="seq_aft_examen" model="ir.sequence">
            <field name="name">Creer un examen</field>
            <field name="code">aft_examen.identifiant</field>
            <field name="prefix">EX-%(y)s-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False" />
        </record>

        <record id="seq_aft_examen_participant" model="ir.sequence">
