<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="module_category_aft_examen">
        <field name="name">Gestion des examens</field>
        <field name="description">Gestion des examens</field>
        <field name="sequence">5</field>
    </record>

    <record id="group_examen_base" model="res.groups">
        <field name="name">Lecteur</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="category_id" ref="module_category_aft_examen"/>
    </record>

    <record id="group_examen_gest" model="res.groups">
        <field name="name">Gestionnaire</field>
        <field name="implied_ids" eval="[(4, ref('group_examen_base'))]"/>
        <field name="category_id" ref="module_category_aft_examen"/>
    </record>

    <record id="group_examen_admin" model="res.groups">
        <field name="name">Administrateur</field>
        <field name="category_id" ref="module_category_aft_examen"/>
        <field name="implied_ids" eval="[(4, ref('group_examen_gest'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>
