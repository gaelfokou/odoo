<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
        <!-- Exam Grade -->
        <record id="exam_secretariat_tree_view" model="ir.ui.view">
			<field name="name">exam.secretariat.tree.view</field>
			<field name="model">siantou.ems.examen.secretariat</field>
			<field name="arch" type="xml">
				<tree string="Grades de l'examen" >
					<field name="name"/>
					<field name="type_examen_id"/>
					<field name="year_id"/>
					<field name="responsable_id"/>
					<field name="responsable_adj_id"/>
					<field name="create_date"/>
				</tree>
			</field>
		</record>

        <record id="exam_secretariat_form_view" model="ir.ui.view">
            <field name="name">exam.secretariat.form.view</field>
            <field name="model">siantou.ems.examen.secretariat</field>
            <field name="priority" eval="1"/>
            <field name="arch" type="xml">
                <form string="Sécretariat de l'examen">
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" placeholder="Ex : Sécretariat pour les CC "/>
                            </h1>
                        </div>
                        <group col="4">
                            <group colspan="2">
                                <field name="school_id" />
                                <field name="year_id" />
                                <field name="responsable_id" />
                            </group>
                            <group colspan="2">
                                <field name="level_id" />
                                <field name="type_examen_id" />
                                <field name="responsable_adj_id" />
                            </group>

                        </group>
                        <notebook>
                            <page string="Surveillants permanents">
                                <field name="surveillent_perm_ids">
                                    <tree>
                                        <field name="name" />    
                                        <field name="work_phone" />    
                                    </tree>
                                </field>
                            </page>
                            <!-- <page string="Surveillants vacataires">
                                <field name="surveillent_vac_ids" />
                            </page> -->
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="exam_secretariat_search_view" model="ir.ui.view">
            <field name="name">exam.secretariat.search.view</field>
            <field name="model">siantou.ems.examen.secretariat</field>
            <field name="arch" type="xml">
                <search string="Sécretariat de l'examen">
                    <field name="name" string="Libellé"/>
                </search>
             </field>
        </record>

        <record id="action_exam_secretariat" model="ir.actions.act_window">
            <field name="name">Sécretariat de l'examen</field>
            <field name="res_model">siantou.ems.examen.secretariat</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="exam_secretariat_search_view"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer un nouveau sécretariat
                </p>
            </field>
        </record>

        <menuitem
            id="secretariat_configuration_menu"
            groups="siantou_ems_examen.group_examen_base"
            name="Sécretariat d'examen"
            action="action_exam_secretariat"
            parent="examen_configuration_menu"
            sequence="7" 
        />

    </data>
</odoo>