                    <group expand="0" string="Group By">
                        <filter string="Subject" name="group_subject" domain="[]" context="{'group_by': 'subject_id'}"/>
                        <filter string="State" name="group_state" domain="[]" context="{'group_by': 'state'}"/>
                    </group>
                </search>
             </field>
        </record> -->

        <record id="action_exam" model="ir.actions.act_window">
            <field name="name">Examens</field>
            <field name="res_model">examen.session.line</field>
            <field name="view_mode">tree,form</field>
            <!-- <field name="search_view_id" ref="exam_search_view"/> -->
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer un nouvelle examen
                </p>
            </field>
        </record>

        <menuitem
            name="Examens" 
            id="menu_examen_examen"
            parent="examen_menu_plannification_sn_cc"
            action="action_exam"
            sequence="20"
        />

    </data>
</odoo>