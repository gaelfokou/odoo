<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
        <!-- Exam -->
        <record id="exam_subject_tree_view" model="ir.ui.view">
			<field name="name">session.line.tree.view</field>
			<field name="model">examen.session.line.subject</field>
			<field name="arch" type="xml">
				<tree string="Examens" default_order="id desc" default_group_by="exam_id">
                    <field name="name"/>
                    <field name="exam_id"/>
					<field name="field_of_study_id"/>
					<field name="level_id"/>
					<field name="year_id"/>
                    <field name="date_start" />
                    <field name="date_end" />
                    <field name="state" />
				</tree>
			</field>
		</record>

        <record id="exam_subject_form_view" model="ir.ui.view">
            <field name="name">session.line.form.view</field>
            <field name="model">examen.session.line.subject</field>
            <field name="priority" eval="1"/>
            <field name="arch" type="xml">
                <form string="Exam">
                    <header>
                        <!-- <button name="button_draft" invisible="state != 'cancel'" string="Brouillo," type="object" data-hotkey="n"/>
                        <button name="button_schedule" invisible="state != 'draft'" string="Programmé" type="object" class="oe_highlight" data-hotkey="o" />
                        <button name="button_open_results" invisible="state not in ('prepare','done')" string="Voir les résultats" type="object" class="oe_highlight" data-hotkey="o" />
                        <button name="button_close" type="object" string="Terminé l'examen" invisible="state != 'schedule'" class="oe_highlight" data-hotkey="l"/>
                        <button name="button_open_anonyma_form" type="object" string="Préparer les résultats" invisible="state != 'complete'" class="oe_highlight" data-hotkey="l"/>
                         -->
                        <!-- <button 
                            name="button_complete_result" 
                            type="object" string="Mettre les note" 
                            invisible="state != 'prepare'" 
                            class="oe_highlight" data-hotkey="l"/>

                        <button name="button_cancel" invisible="state not in ('draft','schedule')" string="Annuler" type="object" data-hotkey="x" /> -->
                        <!-- <button 
                            name="action_anonyma_wizard"
                            class="btn btn-primary" 
                            type="object" 
                            string="Anonymation des notes"/> -->
                        <field name="state" widget="statusbar" statusbar_visible="draft,schedule,complete,prepare,done" readonly="1"/>

                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_attendees"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-users">
                                <field name="attendees_count" widget="statinfo" string="Participants"/>
                            </button>

                            <!-- <button name="button_open_results"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-trophy">
                                <field name="exam_result_count" widget="statinfo" string="Résultats"/>
                            </button> -->
                        </div>
                        <group>
                            <group>
                                <field name="exam_id" 
                                    options="{'no_create': True}"
                                    readonly="state != 'draft'"
                                />
                                <field name="name"/>
                                 <field name="field_of_study_id" 
                                    options="{'no_create': True}"
                                    required="1"
                                    readonly="state != 'draft'"
                                />

                                <label for="date_start" string="Schedule"/>
                                <div name="dates" class="o_row">
                                    <field name="date_start" readonly="state != 'draft'"/>
                                    <i class="fa fa-long-arrow-right mx-2 oe_edit_only" aria-label="Arrow icon" title="Arrow"/>
                                    <field name="date_end" readonly="state != 'draft'"/>
                                </div>

                            </group>
                            <group>
                                <field name="year_id" 
                                    options="{'no_create': True}"
                                    readonly="state != 'draft'"
                                />
                                 <field name="level_id" 
                                    options="{'no_create': True}"
                                    required="1"
                                    readonly="state != 'draft'"
                                />
                            </group>
                        </group>
                        <notebook>
                            <page string="Participants">
                                <field name="exam_attendee_ids">
                                    <tree string="Examens" default_order="id desc">
                                        <field name="student_id"/>
                                        <field name="status"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- <record id="exam_search_view" model="ir.ui.view">
            <field name="name">session.line.search.view</field>
            <field name="model">examen.session.line.subject</field>
            <field name="arch" type="xml">
                <search string="Exam">
                    <field name="subject_id" />
                    <filter string="Scheduled" domain="[('state', '=', 'schedule')]" name="schedule_exam_filter"/>
                    <filter string="Awaiting Result" domain="[('state', 'in', ['complete','prepare'])]" name="awaiting_result_filter"/>
                    <filter string="Result Updated" domain="[('state', 'in', ['done'])]" name="result_updated_filter"/>

                    <group expand="0" string="Group By">
                        <filter string="Subject" name="group_subject" domain="[]" context="{'group_by': 'subject_id'}"/>
                        <filter string="State" name="group_state" domain="[]" context="{'group_by': 'state'}"/>
                    </group>
                </search>
             </field>
        </record> -->

        <record id="action_view_subjects" model="ir.actions.act_window">
            <field name="name">Matières</field>
            <field name="res_model">examen.session.line.subject</field>
            <field name="view_mode">tree,form</field>
            <!-- <field name="search_view_id" ref="exam_search_view"/> -->
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer un nouvelle examen
                </p>
            </field>
        </record>

        <menuitem
            name="Matières programmées de session normal/Contrôle continu" 
            id="menu_examen_e"
            parent="examen_menu_plannification_cc_sn"
            action="action_view_subjects"
            sequence="20"
        />

    </data>
</odoo>