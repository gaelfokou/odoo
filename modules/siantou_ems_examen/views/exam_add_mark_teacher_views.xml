                    <group expand="0" string="Group By">
                        <filter string="Subject" name="group_subject" domain="[]" context="{'group_by': 'subject_id'}"/>
                        <filter string="attendance_status" name="group_state" domain="[]" context="{'group_by': 'attendance_status'}"/>
                    </group>
                </search>
             </field>
        </record> 
        -->

        <record id="action_exam_teacher_result" model="ir.actions.act_window">
            <field name="name">Notes</field>
            <field name="res_model">subject.mark</field>
            <field name="view_mode">tree,form</field>
            <!-- <field name="search_view_id" ref="exam_result_teacher_search_view"/> -->
            <!-- <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('exam_result_teacher_tree_view')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('exam_result_teacher_form_view')}),
            ]"/> -->
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Ajouter une note
                </p>
            </field>
        </record>

        
        <menuitem 
            id="menu_results_note_exam"
            name="Remplissage des notes" 
            action="action_exam_teacher_result"
            parent="examen_menu_note"
            sequence="30"
        />
        
    </data>
</odoo>