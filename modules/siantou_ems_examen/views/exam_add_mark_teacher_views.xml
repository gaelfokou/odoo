<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>

        <record id="exam_result_teacher_tree_view" model="ir.ui.view">
			<field name="name">exam.result.teacher.tree.view</field>
			<field name="model">subject.mark</field>
			<field name="arch" type="xml">
				<tree string="Notes">
                    <field name="name" />
                    <!-- <field name="exam_subject_mark_id" /> -->
				</tree>
			</field>
		</record>
        
        <record id="exam_result_teacher_form_view" model="ir.ui.view">
            <field name="name">exam.result.teacher.form.view</field>
            <field name="model">subject.mark</field>
            <field name="priority" eval="0"/>
            <field name="arch" type="xml">
                <form string="Notes">
                    <sheet>
                        <group>
                            <div class="oe_title">
                                <label for="exam_subject_mark_id"/>
                                <h1>
                                    <field name="exam_subject_mark_id" options="{'no_open':True,'no_create':True}"/>
                                </h1>
                            </div>
                            <group>
                                <field name="name" invisible="1" />
                            </group>
                        </group>
                        <notebook>
                            <page string="Remplir les notes">
                                <field name="anonymous_code_mark_ids">
                                    <tree editable="top" delete="false" create="false">
                                        <field name="anonymous_id" column_invisible="1"/>
                                        <field name="anonyma_code" readonly="1"/>
                                        <field name="marks" />
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        
        <!-- 
        <record id="exam_result_teacher_search_view" model="ir.ui.view">
            <field name="name">exam.result.search.view</field>
            <field name="model"subject.mark</field>
            <field name="arch" type="xml">
                <search string="Exam">
                    <field name="student_id" />
