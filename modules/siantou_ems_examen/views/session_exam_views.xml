<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
        <!-- Exam -->
        <record id="session_exam_tree_view" model="ir.ui.view">
			<field name="name">examen.session.tree.view</field>
			<field name="model">siantou.ems.examen.session</field>
			<field name="arch" type="xml">
				<tree string="Session d'examen" default_order="id desc">
                    <field name="name"/>
                    <field name="type_examen_id"/>
					<field name="class_ids"/>
					<field name="year_id"/>
					<field name="semester_id"/>
                    <field name="date_start" />
                    <field name="date_end" />
                    <field name="state" />
				</tree>
			</field>
		</record>

        <record id="session_exam_form_view" model="ir.ui.view">
            <field name="name">examen.session.form.view</field>
            <field name="model">siantou.ems.examen.session</field>
            <field name="priority" eval="1"/>
            <field name="arch" type="xml">
                <form string="Exam">
                    <header>
                        <!-- <button name="button_draft" invisible="state == 'create'" string="Brouillon" type="object" data-hotkey="n"/> -->
                        <button name="button_open" invisible="state != 'draft'" 
                            string="Lancé la session" type="object" 
                            class="oe_highlight" data-hotkey="o" />
                        <button name="button_cancel" 
                            invisible="state == 'create'" 
                            string="Annulé" type="object" data-hotkey="x" />
                        <button name="button_close" 
                            type="object" string="Termié la session" 
                            invisible="state != 'progress'" class="oe_highlight" data-hotkey="l"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,progress,close,cancel" readonly="1"/>
                    </header>
                    <sheet>
                        <field name="show_field" invisible="1" />
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_exams" type="object"
                                class="oe_stat_button" icon="fa-clipboard" invisible="show_field==False">
                                <field name="exam_count" widget="statinfo" string="Examens [matières] lancés"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" placeholder="Ex : session de cc 2023-2024"
                                    readonly="state != 'create'"
                                />
                            </h1>
                        </div>
                        <group col="4">
                            <group colspan="2">
                                <field name="secretariat_examen_id" 
                                    options="{'no_open':True,'no_create':True}"
                                    readonly="state != 'create'"
                                />
                                <field name="type_examen_id" 
                                    options="{'no_open':True,'no_create':True}"
                                    readonly="state != 'create'"
                                />
                                <field name="year_id" 
                                    options="{'no_open':True,'no_create':True}"
                                    readonly="state != 'create'"
                                />
                                <label for="date_start" string="Horaires"/>
                                <div name="dates" class="o_row">
                                    <field name="date_start" readonly="state != 'create'"/>
                                    <i class="fa fa-long-arrow-right mx-2 oe_edit_only" aria-label="Arrow icon" title="Arrow"/>
                                    <field name="date_end" readonly="state != 'create'"/>
                                </div>
                            </group>
                            <group colspan="2">
                                <field 
                                    name="school_id" 
                                    readonly="state != 'create'" 
                                    options="{'no_open':True,'no_create':True}"/>

                                <field 
                                    name="class_ids" widget="many2many_tags" 
                                    readonly="state != 'create'" 
                                    options="{'no_open':True,'no_create':True}"/>

                                <field 
                                    name="level_id" 
                                    readonly="state != 'create'" 
                                    options="{'no_open':True,'no_create':True}"/>

                                <field 
                                    name="semester_id" 
                                    readonly="state != 'create'" 
                                    options="{'no_open':True,'no_create':True}"/>

                                <!-- <field name="exam_hours" readonly="state != 'create'"/> -->
                            </group>
                        </group>
                        <notebook invisible="show_field==False">
                            <page name="exam_line_ids" string="Examens">
                                <field name="exam_subject_ids" 
                                    options="{'no_open':True,'no_create':True}">
                                    <tree string="Examens" default_order="id desc">
                                        <field name="name"/>
                                        <field name="field_of_study_id"/>
                                        <field name="level_id"/>
                                        <field name="year_id"/>
                                        <field name="date_start" />
                                        <field name="date_end" />
                                        <field name="state" />
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- <record id="session_exam_search_view" model="ir.ui.view">
            <field name="name">examen.session.search.view</field>
            <field name="model">siantou.ems.examen.session</field>
            <field name="arch" type="xml">
                <search string="Exam">
                    <field name="subject_id" />
                    <filter string="Horaire" domain="[('state', '=', 'schedule')]" name="schedule_session_exam_filter"/>
                    <filter string="Awaiting Result" domain="[('state', 'in', ['complete','prepare'])]" name="awaiting_result_filter"/>
                    <filter string="Result Updated" domain="[('state', 'in', ['done'])]" name="result_updated_filter"/>

                    <group expand="0" string="Group By">
                        <filter string="Subject" name="group_subject" domain="[]" context="{'group_by': 'subject_id'}"/>
                        <filter string="State" name="group_state" domain="[]" context="{'group_by': 'state'}"/>
                    </group>
                </search>
             </field>
        </record> -->

        <record id="action_session_exam" model="ir.actions.act_window">
            <field name="name">Sessions d'examen</field>
            <field name="res_model">siantou.ems.examen.session</field>
            <field name="view_mode">tree,form</field>
            <!-- <field name="search_view_id" ref="session_exam_search_view"/> -->
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer une nouvelle session d'examen
                </p>
            </field>
        </record>

        <menuitem 
            id="menu_session_examen"
            parent="examen_menu_plannification_cc_sn"
            action="action_session_exam"
            name="Examens de session normal/Contrôle continu"
            sequence="20"
        />

    </data>
</odoo>