<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="aft_examen_deliberation_jury_view_form" model="ir.ui.view">
        <field name="name">aft_examen_deliberation_jury_view_form.view.form</field>
        <field name="model">siantou.ems.examen.deliberation.jury</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group string="Information(s) classique(s)">
                        <group>
                            <field name="name" />
                        </group>
                        <group>
                            <field name="fonction" />
                        </group>
                        <group>
                            <field name="description" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="aft_examen_deliberation_jury_view_tree" model="ir.ui.view">
        <field name="name">aft_examen_deliberation_jury_view_tree.view.tree</field>
        <field name="model">siantou.ems.examen.deliberation.jury</field>
        <field name="arch" type="xml">
            <tree string="">
                <field name="name" />
                <field name="fonction" />
                <field name="description" />
            </tree>
        </field>
    </record>

    <record id="aft_examen_deliberation_jury_action" model="ir.actions.act_window">
        <field name="name">Jury de délibération</field>
        <field name="res_model">siantou.ems.examen.deliberation.jury</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Jury de délibération
            </p>
        </field>
    </record>
</odoo>