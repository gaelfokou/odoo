<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="aft_examen_student_subject_view_form" model="ir.ui.view">
        <field name="name">aft_examen_student_subject_view_form.view.form</field>
        <field name="model">siantou.ems.examen.student.subject</field>
        <field name="arch" type="xml">
            <form string="">
                <!-- <header>
                    <button string="Valider" name="action_validate" type="object"
                        class="oe_highlight"
                        states="draft" />

                    <button string="Confirmer" name="action_confirm" type="object"
                        class="oe_highlight"
                        states="validate" />

                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,validate,confirm" />
                </header> -->
                <sheet>
                    <group col="4">
                        <group colspan="2">
                            <field name="matiere_id" readonly="1"/>   
                        </group>
                        <group colspan="2">
                            <field name="coeficeint" readonly="1"/>   
                        </group>
                        <group colspan="2">
                            <field name="moyenne_matiere" readonly="1"/>   
                        </group>
                        <group colspan="2">
                            <field name="statut" readonly="1"/>   
                        </group>
                    </group>
                    <notebook>
                            <page name="examen_student_subject_id" string="Info">
                                <field name="examen_student_subject_ids">
                                    <tree editable="bottom">
                                        <field name="type_examen_id" />
                                        <field name="note" />
                                        <field name="pourcentage" />
                                        <field name="moyenne_type_examne" />
                                    </tree>
                                </field>
                            </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <record id="aft_examen_student_subject_view_tree" model="ir.ui.view">
        <field name="name">aft_examen_student_subject_view_tree.view.tree</field>
        <field name="model">siantou.ems.examen.student.subject</field>
        <field name="arch" type="xml">
            <tree 
            create="false"
            >
                <field name="matiere_id"/>   
                <field name="coeficeint"/>   
                <field name="moyenne_matiere"/> 
            </tree>
        </field>
    </record>

    <record id="aft_examen_student_subject__action" model="ir.actions.act_window">
        <field name="name">Moyenne par matière</field>
        <field name="res_model">siantou.ems.examen.student.subject</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Créer un document
            </p>
        </field>
    </record>
</odoo>