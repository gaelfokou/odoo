<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="type_examen_view_tree" model="ir.ui.view">
      <field name="name">type_examen_view_tree.view.tree</field>
      <field name="model">siantou.ems.type.examen</field>
      <field name="arch" type="xml">
        <tree string="" editable="top">
          <field name="code" />
          <field name="name" />
        </tree>
      </field>
    </record>

    <record id="type_examen_action" model="ir.actions.act_window">
      <field name="name">Type d'examen</field>
      <field name="res_model">siantou.ems.type.examen</field>
      <field name="view_mode">tree</field>
    </record>
</odoo>