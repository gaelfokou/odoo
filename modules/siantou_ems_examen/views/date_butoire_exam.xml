<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="siantou_ems_examen_date_butoire_view_tree" model="ir.ui.view">
      <field name="name">siantou_ems_examen_date_butoire_view_tree.view.tree</field>
      <field name="model">siantou.ems.examen.date.butoire</field>
      <field name="arch" type="xml">
        <tree>
          <field name="code" />
          <field name="name" />
          <field name="date" />
          <field name="type_examen_id"/>
          <field name="semestre_id"/>
          <field name="annee_acadmique_id"/>
          <field name="school_id"/>
        </tree>
      </field>
    </record>

    <!-- Affichage en vue formulaire -->
		<record
                id="siantou_ems_examen_date_butoire_form_view"
                model="ir.ui.view">
			<field name="name">siantou_ems_examen_date_butoire.form.view</field>
			<field name="model">siantou.ems.examen.date.butoire</field>
			<field name="arch" type="xml">
				<form string="Date Butoire">
					<sheet>
                        <group col="4">
                            <group colspan="2">
                                <field name="name"/>
                                <field name="type_examen_id"/>
                                <field name="semestre_id"/>
                            </group>
                            <group colspan="2">
                                <field name="date"/>
                                <field name="annee_acadmique_id"/>
                                <field name="school_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="classes" string="Classes">
                                <field name="class_ids">
                                    <tree 
                                    editable="bottom"
                                    >
                                    <field name="name" />
                                    <field name="niveau_id"/>
                                    <field name="annee_acadmique_id"/>
                                    <field name="filiere_id"/>
                                    <field name="school_id"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
					</sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user" />
                        <field name="message_ids" />
                    </div>
				</form>
			</field>
		</record>

    <!-- Action pour le menu s'affichage des dates butoires -->
        <record
                id="siantou_ems_examen_date_butoire_action"
                model="ir.actions.act_window">
            <field name="name">Date buttoire d'examen</field>
            <field name="res_model">siantou.ems.examen.date.butoire</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer une nouvelle date.
                </p>
            </field>
        </record>

    <menuitem
      id="examen_date_butoire_configuration_menu"
      groups="siantou_ems_examen.group_examen_base"
      name="Date buttoire d'examen"
      action="siantou_ems_examen_date_butoire_action"
      parent="examen_configuration_menu"
      sequence="20" />
</odoo>