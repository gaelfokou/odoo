<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
        <!-- Exam Grade -->
        <record id="exam_grade_tree_view" model="ir.ui.view">
			<field name="name">exam.type.tree.view</field>
			<field name="model">siantou.ems.examen.grade</field>
			<field name="arch" type="xml">
				<tree string="Grades de l'examen" >
					<field name="name"/>
					<field name="note"/>
					<field name="score_min"/>
					<field name="score_max"/>
					<field name="appreciation"/>
				</tree>
			</field>
		</record>

        <record id="exam_grade_form_view" model="ir.ui.view">
            <field name="name">exam.grade.form.view</field>
            <field name="model">siantou.ems.examen.grade</field>
            <field name="priority" eval="1"/>
            <field name="arch" type="xml">
                <form string="Grades de l'examen">
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" placeholder="Ex : A+"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="note" />
                                <field name="score_min" />
                            </group>
                            <group>
                                <field name="score_max" />
                                <field name="appreciation" />
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="exam_grade_search_view" model="ir.ui.view">
            <field name="name">exam.grade.search.view</field>
            <field name="model">siantou.ems.examen.grade</field>
            <field name="arch" type="xml">
                <search string="Grades de l'examen">
                    <field name="name" string="Grade"/>
                </search>
             </field>
        </record>

        <record id="action_exam_grade" model="ir.actions.act_window">
            <field name="name">Grades de l'examen</field>
            <field name="res_model">siantou.ems.examen.grade</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="exam_grade_search_view"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer un nouveau grade
                </p>
            </field>
        </record>

        <menuitem
            id="grade_configuration_menu"
            groups="siantou_ems_examen.group_examen_base"
            name="Grades d'examen"
            action="action_exam_grade"
            parent="examen_configuration_menu"
            sequence="6" 
        />

    </data>
</odoo>