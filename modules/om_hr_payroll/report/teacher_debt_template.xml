<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Template du rapport PDF -->
        <template id="template_report_debt">
            <t t-call="web.html_container">
                <t t-if="docdata and docdata['debt_data']">
                    <t t-call="web.basic_layout">
                        <style>
                            .table {
                                border-collapse: collapse;
                                width: 100%;
                            }
                            .table .thead th, .table td {
                                border: 1px solid lightgrey !important;
                                padding: 4px 4px !important;
                                margin: 2px 4px !important;
                                text-align: center;
                                font-size: 12px;
                            }
                            .table .thead th {
                                background-color: #f2f2f2;
                                font-size: 12px;
                            }
                            h3 {
                                font-size: 18px;
                                margin: 2px 4px !important;
                            }
                            h4 {
                                font-size: 16px;
                                margin: 2px 4px !important;
                            }
                            h5 {
                                font-size: 14px;
                                margin: 2px 4px !important;
                            }
                            br {
                                padding: 1px 0px !important;
                                margin: 1px 0px !important;
                            }
                        </style>
                        <div class="page">
                            <table class="table table-bordered table-sm text-center">
                                <thead>
                                    <tr>
                                        <th class="text-center" t-attf-colspan="6" style="box-shadow: inset 0 0 0 9999px transparent; border-style: hidden;">
                                            <h3>INSTITUT UNIVERSITAIRE SIANTOU</h3>
                                            <h4>
                                                <span t-esc="docdata['title']"/>
                                            </h4>
                                            <h5 class="text-left">
                                                <span t-esc="'Filtre :'"/>
                                                <span t-esc="docdata['filter'] or 'Non spécifié'"/>
                                            </h5>
                                        </th>
                                    </tr>
                                </thead>
                                <thead>
                                    <tr>
                                        <th class="text-left" t-attf-colspan="6" style="box-shadow: inset 0 0 0 9999px transparent; border-style: hidden;"><br/></th>
                                    </tr>
                                </thead>
                                <thead class="thead">
                                    <tr class="active">
                                        <th class="text-center">Matricule</th>
                                        <th class="text-center">Enseignant</th>
                                        <th class="text-center">Date de début</th>
                                        <th class="text-center">Date de fin</th>
                                        <th class="text-center">Montant</th>
                                        <th class="text-center">Montant restant</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="debt_data" t-value="dict(sorted(docdata['debt_data'].items(), key=lambda item: item[1]['name'] if item[1]['name'] else ''))"/>
                                    <t t-set="keys" t-value="debt_data.keys()"/>
                                    <t t-foreach="keys" t-as="key">
                                        <t t-set="debts" t-value="sorted(debt_data[key]['data'], key=lambda item: item['start_date'] if 'start_date' in item else datetime.strptime('2015-12-15', '%Y-%m-%d').date())"/>
                                        <t t-foreach="debts" t-as="debt">
                                            <tr>
                                                <td class="text-center">
                                                    <span t-esc="debt['identifier']"/>
                                                </td>
                                                <td class="text-left">
                                                    <span t-esc="debt['employee_name']"/>
                                                </td>
                                                <td class="text-center">
                                                    <span t-esc="debt['start_date_of_week']"/>
                                                </td>
                                                <td class="text-center">
                                                    <span t-esc="debt['end_date_of_week']"/>
                                                </td>
                                                <td class="text-center">
                                                    <span t-esc="'{:,.2f}'.format(debt['amount'])"/>
                                                </td>
                                                <td class="text-center">
                                                    <span t-esc="'{:,.2f}'.format(debt['rest_amount'])"/>
                                                </td>
                                            </tr>
                                        </t>
                                        <tr>
                                            <td class="text-center" style="background-color: #f2f2f2;">TOTAL</td>
                                            <td class="text-center" style="background-color: #f2f2f2;"></td>
                                            <td class="text-center" style="background-color: #f2f2f2;"></td>
                                            <td class="text-center" style="background-color: #f2f2f2;"></td>
                                            <td class="text-center" style="background-color: #f2f2f2;">
                                                <span t-esc="'{:,.2f}'.format(debt_data[key]['amount'])"/>
                                            </td>
                                            <td class="text-center" style="background-color: #f2f2f2;">
                                                <span t-esc="'{:,.2f}'.format(debt_data[key]['rest_amount'])"/>
                                            </td>
                                        </tr>
                                    </t>
                                    <tr>
                                        <td class="text-center" style="background-color: #f2f2f2;">TOTAL GLOBAL</td>
                                        <td class="text-center" style="background-color: #f2f2f2;"></td>
                                        <td class="text-center" style="background-color: #f2f2f2;"></td>
                                        <td class="text-center" style="background-color: #f2f2f2;"></td>
                                        <td class="text-center" style="background-color: #f2f2f2;">
                                            <span t-esc="'{:,.2f}'.format(docdata['total_amount'])"/>
                                        </td>
                                        <td class="text-center" style="background-color: #f2f2f2;">
                                            <span t-esc="'{:,.2f}'.format(docdata['total_rest_amount'])"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </t>
                </t>
                <t t-else="">
                    <div>Aucune donnée d'emploi du temps disponible. Veuillez vérifier vos filtres.</div>
                </t>
            </t>
        </template>

        <record id="paperformat_debt" model="report.paperformat">
            <field name="name">Format du diplome</field>
            <field name="default" eval="True"/>
            <field name="format">A2</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">5</field>
            <field name="margin_bottom">15</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="True"/>
            <field name="header_spacing">5</field>
            <field name="dpi">90</field>
        </record>
        <record id="action_report_debt" model="ir.actions.report">
            <field name="name">Dettes des enseignants PDF</field>
            <field name="model">teacher.debt</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">om_hr_payroll.template_report_debt</field>
            <field name="report_file">om_hr_payroll.template_report_debt</field>
            <field name="print_report_name">'Fiche de - %s' % (docdata.semester)</field>
            <field name="binding_model_id" eval="False"/>
            <field name="paperformat_id" ref="paperformat_debt"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>
