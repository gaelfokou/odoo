<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Template du rapport PDF -->
        <template id="template_report_teacher_timetable_attendance">
            <t t-call="web.html_container">
                <t t-if="docdata and docdata['teacher_timetable_attendance_data']">
                    <t t-call="web.basic_layout">
                        <style>
                            .table {
                                border-collapse: collapse;
                                width: 100%;
                            }
                            .table .thead th, .table td {
                                border: 1px solid lightgrey !important;
                                padding: 4px 4px !important;
                                margin: 2px 4px !important;
                                text-align: center;
                                font-size: 12px;
                            }
                            .table .thead th {
                                background-color: #f2f2f2;
                                font-size: 12px;
                            }
                            h3 {
                                font-size: 18px;
                                margin: 2px 4px !important;
                            }
                            h4 {
                                font-size: 16px;
                                margin: 2px 4px !important;
                            }
                            h5 {
                                font-size: 14px;
                                margin: 2px 4px !important;
                            }
                            br {
                                padding: 1px 0px !important;
                                margin: 1px 0px !important;
                            }
                        </style>
                        <div class="page">
                            <table class="table table-bordered table-sm text-center">
                                <thead>
                                    <tr>
                                        <th class="text-center" t-attf-colspan="#{'12' if docdata['is_permanent'] == False else '10'}" style="box-shadow: inset 0 0 0 9999px transparent; border-style: hidden;">
                                            <h3>INSTITUT UNIVERSITAIRE SIANTOU</h3>
                                            <h4>
                                                <span t-esc="docdata['title']"/>
                                            </h4>
                                            <h5 class="text-left">
                                                <span t-esc="'Filtre :'"/>
                                                <span t-esc="docdata['filter'] or 'Non spécifié'"/>
                                            </h5>
                                        </th>
                                    </tr>
                                </thead>
                                <thead>
                                    <tr>
                                        <th class="text-left" t-attf-colspan="#{'12' if docdata['is_permanent'] == False else '10'}" style="box-shadow: inset 0 0 0 9999px transparent; border-style: hidden;"><br/></th>
                                    </tr>
                                </thead>
                                <thead class="thead">
                                    <tr class="active">
                                        <th class="text-center">Matricule</th>
                                        <th class="text-center">Enseignant</th>
                                        <th class="text-center">Classe</th>
                                        <th class="text-center">Cours</th>
                                        <th class="text-center">Date</th>
                                        <!-- <th class="text-center">Heure</th> -->
                                        <th class="text-center">Heure effectuée</th>
                                        <th class="text-center">Nombre d'heures effectuées</th>
                                        <th class="text-center" t-if="docdata['is_permanent'] == False">Taux horaire</th>
                                        <th class="text-center" t-if="docdata['is_permanent'] == False">Montant</th>
                                        <th class="text-center">Volume horaire</th>
                                        <th class="text-center">Volume horaire effectué</th>
                                        <th class="text-center">Volume horaire restant</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="docdata['sort_type'] == 'hour'">
                                        <t t-set="teacher_timetable_attendance_data" t-value="dict(sorted(docdata['teacher_timetable_attendance_data'].items(), key=lambda item: item[1]['worked_time'] if item[1]['worked_time'] else 0.0, reverse=True))"/>
                                    </t>
                                    <t t-else="">
                                        <t t-set="teacher_timetable_attendance_data" t-value="dict(sorted(docdata['teacher_timetable_attendance_data'].items(), key=lambda item: item[1]['name'] if item[1]['name'] else ''))"/>
                                    </t>
                                    <t t-set="keys" t-value="teacher_timetable_attendance_data.keys()"/>
                                    <t t-foreach="keys" t-as="key">
                                        <t t-set="timetables" t-value="sorted(teacher_timetable_attendance_data[key]['data'], key=lambda item: ((item['level_id'] if 'level_id' in item else 10), (item['rate'] if 'rate' in item and item['rate'] else 100000.0)))"/>
                                        <t t-foreach="timetables" t-as="timetable">
                                            <tr t-if="docdata['is_permanent'] == False or docdata['is_permanent'] == True and timetable['class_name']">
                                                <t t-if="timetable['class_name']">
                                                    <td class="text-center">
                                                        <span t-esc="timetable['identifier']"/>
                                                    </td>
                                                    <td class="text-left">
                                                        <span t-esc="timetable['employee_name']"/>
                                                    </td>
                                                </t>
                                                <t t-else="">
                                                    <td class="text-center">
                                                        <span t-esc="timetable['employee_name']"/>
                                                    </td>
                                                    <td class="text-center"></td>
                                                </t>
                                                <td class="text-center">
                                                    <span t-esc="timetable['class_name']"/>
                                                    <t t-if="timetable['class_name'] and timetable['class_group_id']">
                                                        <span t-esc="'(' + timetable['class_group_name'] + ')'"/>
                                                    </t>
                                                </td>
                                                <td class="text-center">
                                                    <span t-esc="timetable['subject_name']"/>
                                                </td>
                                                <td class="text-center">
                                                    <span t-esc="timetable['date_of_week']"/>
                                                </td>
                                                <!-- <td class="text-center">
                                                    <span t-esc="timetable['start_time'] + '-' + timetable['end_time'] if timetable['class_name'] else ''"/>
                                                </td> -->
                                                <td class="text-center">
                                                    <span t-esc="timetable['worked_start_time'] + '-' + timetable['worked_end_time'] if timetable['class_name'] else ''"/>
                                                </td>
                                                <td class="text-center">
                                                    <span t-esc="timetable['worked_time']"/>
                                                </td>
                                                <td class="text-center" t-if="docdata['is_permanent'] == False">
                                                    <span t-esc="timetable['rate']"/>
                                                </td>
                                                <td class="text-center" t-if="docdata['is_permanent'] == False">
                                                    <span t-esc="'{:,.2f}'.format(timetable['amount'])"/>
                                                </td>
                                                <td class="text-center">
                                                    <span t-esc="timetable['hours_credit']"/>
                                                </td>
                                                <td class="text-center">
                                                    <t t-if="timetable['class'] == 'text-danger'">
                                                        <span t-esc="timetable['total_done']" style="color: red !important;"/>
                                                    </t>
                                                    <t t-else="">
                                                        <span t-esc="timetable['total_done']"/>
                                                    </t>
                                                </td>
                                                <td class="text-center">
                                                    <span t-esc="timetable['total_awaiting']"/>
                                                </td>
                                            </tr>
                                        </t>
                                        <tr>
                                            <td class="text-center" style="background-color: #f2f2f2;">TOTAL</td>
                                            <td class="text-center" style="background-color: #f2f2f2;"></td>
                                            <td class="text-center" style="background-color: #f2f2f2;"></td>
                                            <td class="text-center" style="background-color: #f2f2f2;"></td>
                                            <td class="text-center" style="background-color: #f2f2f2;"></td>
                                            <!-- <td class="text-center" style="background-color: #f2f2f2;"></td> -->
                                            <td class="text-center" style="background-color: #f2f2f2;"></td>
                                            <td class="text-center" style="background-color: #f2f2f2;">
                                                <span t-esc="teacher_timetable_attendance_data[key]['worked_time']"/>
                                            </td>
                                            <td class="text-center" style="background-color: #f2f2f2;" t-if="docdata['is_permanent'] == False"></td>
                                            <td class="text-center" style="background-color: #f2f2f2;" t-if="docdata['is_permanent'] == False">
                                                <span t-esc="'{:,.2f}'.format(teacher_timetable_attendance_data[key]['amount'])"/>
                                            </td>
                                            <td class="text-center" style="background-color: #f2f2f2;"></td>
                                            <td class="text-center" style="background-color: #f2f2f2;"></td>
                                            <td class="text-center" style="background-color: #f2f2f2;"></td>
                                        </tr>
                                    </t>
                                    <tr>
                                        <td class="text-center" style="background-color: #f2f2f2;">TOTAL GLOBAL</td>
                                        <td class="text-center" style="background-color: #f2f2f2;"></td>
                                        <td class="text-center" style="background-color: #f2f2f2;"></td>
                                        <td class="text-center" style="background-color: #f2f2f2;"></td>
                                        <td class="text-center" style="background-color: #f2f2f2;"></td>
                                        <!-- <td class="text-center" style="background-color: #f2f2f2;"></td> -->
                                        <td class="text-center" style="background-color: #f2f2f2;"></td>
                                        <td class="text-center" style="background-color: #f2f2f2;">
                                            <span t-esc="docdata['total_worked_time']"/>
                                        </td>
                                        <td class="text-center" style="background-color: #f2f2f2;" t-if="docdata['is_permanent'] == False"></td>
                                        <td class="text-center" style="background-color: #f2f2f2;" t-if="docdata['is_permanent'] == False">
                                            <span t-esc="'{:,.2f}'.format(docdata['total_amount'])"/>
                                        </td>
                                        <td class="text-center" style="background-color: #f2f2f2;"></td>
                                        <td class="text-center" style="background-color: #f2f2f2;"></td>
                                        <td class="text-center" style="background-color: #f2f2f2;"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </t>
                </t>
                <t t-else="">
                    <div>Aucune donnée d'emploi du temps disponible. Veuillez vérifier vos filtres.</div>
                </t>
            </t>
        </template>

        <record id="paperformat_teacher_timetable_attendance" model="report.paperformat">
            <field name="name">Format du diplome</field>
            <field name="default" eval="True"/>
            <field name="format">A2</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">5</field>
            <field name="margin_bottom">15</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="True"/>
            <field name="header_spacing">5</field>
            <field name="dpi">90</field>
        </record>
        <record id="action_report_teacher_timetable_attendance" model="ir.actions.report">
            <field name="name">Émargements des enseignants PDF</field>
            <field name="model">teacher.timetable.attendance</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">om_hr_payroll.template_report_teacher_timetable_attendance</field>
            <field name="report_file">om_hr_payroll.template_report_teacher_timetable_attendance</field>
            <field name="print_report_name">'Fiche de - %s' % (docdata.semester)</field>
            <field name="binding_model_id" eval="False"/>
            <field name="paperformat_id" ref="paperformat_teacher_timetable_attendance"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>
