<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="teacher_timetable_attendance" model="ir.ui.view">
            <field name="name">teacher.timetable.attendance.tree</field>
            <field name="model">teacher.timetable.attendance</field>
            <field name="arch" type="xml">
                <tree string="Émargements des enseignants">
                    <header>
                        <button name="action_reset_filter" 
                            type="object" 
                            string="Réinitialiser" 
                            class="oe_highlight" 
                            display="always"/>
                        <button name="action_open_filter" 
                            type="object" 
                            string="Filtrer" 
                            class="oe_highlight" 
                            display="always"/>
                        <button name="action_print_pdf" 
                            type="object" 
                            string="Imprimer PDF" 
                            class="oe_highlight" 
                            display="always"/>
                    </header>
                    <field name="timetable_id"/>
                    <field name="class_id"/>
                    <field name="subject_id"/>
                    <field name="employee_id"/>
                    <field name="date"/>
                    <field name="start_time"/>
                    <field name="end_time"/>
                    <field name="worked_start_time"/>
                    <field name="worked_end_time"/>
                    <field name="worked_time"/>
                    <field name="rate"/>
                    <field name="amount"/>
                    <field name="total_all"/>
                    <field name="total_done"/>
                    <field name="total_awaiting"/>
                    <field name="status"/>
                </tree>
            </field>
        </record>

        <!-- Define an action to open the tree view -->
        <record id="action_show_teacher_timetable_attendance" model="ir.actions.act_window">
            <field name="name">Émargements des enseignants</field>
            <field name="res_model">teacher.timetable.attendance</field>
            <field name="view_mode">tree</field>
            <field name="target">current</field>
            <field name="view_id" ref="teacher_timetable_attendance"/>
        </record>

        <menuitem
            id="menu_teacher_timetable_attendance"
            name="Émargements des enseignants"
            action="action_show_teacher_timetable_attendance"
            parent="menu_payroll_employee"
            sequence="21"/>
    </data>
</odoo>