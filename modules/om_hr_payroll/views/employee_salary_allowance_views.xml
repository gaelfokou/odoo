<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="employee_salary_allowance_tree_view" model="ir.ui.view">
            <field name="name">employee.salary.allowance.tree.view</field>
            <field name="model">employee.salary.allowance</field>
            <field name="arch" type="xml">
                <tree string="Primes sur les salaires">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="allowance_type"/>
                    <field name="amount"/>
                </tree>
            </field>
        </record>

        <record id="employee_salary_allowance_form_view" model="ir.ui.view">
            <field name="name">employee.salary.allowance.form.view</field>
            <field name="model">employee.salary.allowance</field>
            <field name="arch" type="xml">
                <form string="Primes sur les salaires">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="allowance_type"/>
                    <field name="amount"/>
                </form>
            </field>
        </record>

        <!-- Define an action to open the tree view -->
        <record id="action_show_employee_salary_allowance" model="ir.actions.act_window">
            <field name="name">Primes sur les salaires</field>
            <field name="res_model">employee.salary.allowance</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer une nouvelle prime sur le salaire.
                </p>
            </field>
        </record>

        <menuitem
            id="menu_employee_salary_allowance"
            name="Primes sur les salaires"
            action="action_show_employee_salary_allowance"
            parent="menu_payroll_employee"
            sequence="23"/>
    </data>
</odoo>