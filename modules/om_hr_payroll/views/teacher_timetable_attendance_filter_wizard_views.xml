<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="teacher_timetable_attendance_filter_wizard" model="ir.ui.view">
            <field name="name">teacher.timetable.attendance.filter.wizard.form</field>
            <field name="model">teacher.timetable.attendance.filter.wizard</field>
            <field name="arch" type="xml">
                <form string="Filtre des émargements des enseignants">
                    <group>
                        <field name="is_teacher"/>
                        <field name="is_permanent"/>
                        <field name="is_temporary"/>
                        <field name="employee_id_domain" invisible="1"/>
                        <field name="employee_id" options="{'no_create': True}" domain="employee_id_domain"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="has_rate" invisible="is_permanent == True"/>
                        <field name="status" invisible="is_permanent == True"/>
                        <field name="sort_type" invisible="is_permanent == False"/>
                    </group>
                    <footer>
                        <button string="Filtrer" type="object" name="action_filter" class="btn-primary"/>
                        <button string="Annuler" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Define an action to open the form view -->
        <record id="action_filter_teacher_timetable_attendance_wizard" model="ir.actions.act_window">
            <field name="name">Filtre des émargements des enseignants</field>
            <field name="res_model">teacher.timetable.attendance.filter.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="teacher_timetable_attendance_filter_wizard"/>
            <field name="context">{'default_is_permanent': False}</field>
        </record>
    </data>
</odoo>