<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--Template to send demo mail template for the customer-->
        <record id="om_hr_payroll_template_timetable_notification_absence" model="mail.template">
            <field name="name">Email Notification Absence</field>
            <field name="model_id" ref="om_hr_payroll.model_siantou_ems_timetable_notification"/>
            <field name="email_from">{{ user.email }}</field>
            <t t-if="object.template == 'om_hr_payroll.om_hr_payroll_template_timetable_notification_absence'">
                <field name="email_to">{{ object.timetable_id.employee_id.work_email }}</field>
            </t>
            <t t-elif="object.template == 'om_hr_payroll.om_hr_payroll_template_timetable_notification_exception'">
                <field name="email_to">{{ object.attendance_id.employee_id.work_email }}</field>
            </t>
            <field name="subject">Notification Absence</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <div style="justify-content: center;background-color: #714B67; padding:0.6rem;padding-left: 35px;text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;width:40%">
                        <h2>
                            Bonjour/Bonsoir,
                            <t t-if="object.template == 'om_hr_payroll.om_hr_payroll_template_timetable_notification_absence'">
                                <t t-out="object.timetable_id.employee_id.name"/>
                            </t>
                            <t t-elif="object.template == 'om_hr_payroll.om_hr_payroll_template_timetable_notification_exception'">
                                <t t-out="object.attendance_id.employee_id.name"/>
                            </t>
                        </h2>
                        <div>
                            <h3>Ceci est un message de notification d'absence.</h3>
                        </div>
                    </div>
                    <br/>
                    <br/>
                    Cordialement,
                    <br/>
                    <t t-out="user.name"/>
                    <br/>
                </div>
            </field>
        </record>
        <!--Template to send demo mail template for the customer-->
        <record id="om_hr_payroll_template_timetable_notification_exception" model="mail.template">
            <field name="name">Email Notification Exception</field>
            <field name="model_id" ref="om_hr_payroll.model_siantou_ems_timetable_notification"/>
            <field name="email_from">{{ user.email }}</field>
            <t t-if="object.template == 'om_hr_payroll.om_hr_payroll_template_timetable_notification_absence'">
                <field name="email_to">{{ object.timetable_id.employee_id.work_email }}</field>
            </t>
            <t t-elif="object.template == 'om_hr_payroll.om_hr_payroll_template_timetable_notification_exception'">
                <field name="email_to">{{ object.attendance_id.employee_id.work_email }}</field>
            </t>
            <field name="subject">Notification Exception</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <div style="justify-content: center;background-color: #714B67; padding:0.6rem;padding-left: 35px;text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;width:40%">
                        <h2>
                            Bonjour/Bonsoir,
                            <t t-if="object.template == 'om_hr_payroll.om_hr_payroll_template_timetable_notification_absence'">
                                <t t-out="object.timetable_id.employee_id.name"/>
                            </t>
                            <t t-elif="object.template == 'om_hr_payroll.om_hr_payroll_template_timetable_notification_exception'">
                                <t t-out="object.attendance_id.employee_id.name"/>
                            </t>
                        </h2>
                        <div>
                            <h3>Ceci est un message de notification d'exception.</h3>
                        </div>
                    </div>
                    <br/>
                    <br/>
                    Cordialement,
                    <br/>
                    <t t-out="user.name"/>
                    <br/>
                </div>
            </field>
        </record>
    </data>
</odoo>