                          (0, 0, {'view_mode': 'pivot', 'view_id': ref('hr_expense.view_hr_expense_sheet_pivot')}),
                          (0, 0, {'view_mode': 'kanban', 'view_id': ref('hr_expense.view_hr_expense_sheet_kanban')})]"/>

            <field name="search_view_id" ref="hr_expense.hr_expense_sheet_view_search"/>
        </record>
    </data>
</odoo>