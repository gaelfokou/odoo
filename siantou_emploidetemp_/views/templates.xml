<odoo>
    <data>

        <template id="emploidetemp_listing">
          <ul>
            <li t-foreach="emploidetemps" t-as="emploidetemp">
              <a t-attf-href="#{ root }/#{ emploidetemp.id }">
                <t t-esc="emploidetemp.display_name"/>
              </a>
            </li>
          </ul>
        </template>

        <template id="niveau_listing">
          <ul>
            <li t-foreach="niveaux" t-as="niveau">
              <a t-attf-href="#{ root }/#{ niveau.id }">
                <t t-esc="niveau.display_name"/>
              </a>
            </li>
          </ul>
        </template>

        <template id="semestre_listing">
          <ul>
            <li t-foreach="semestres" t-as="semestre">
              <a t-attf-href="#{ root }/#{ semestre.id }">
                <t t-esc="semestre.display_name"/>
              </a>
            </li>
          </ul>
        </template>

        <template id="salledecour_listing">
          <ul>
            <li t-foreach="salledecours" t-as="salledecour">
              <a t-attf-href="#{ root }/#{ salledecour.id }">
                <t t-esc="salledecour.display_name"/>
              </a>
            </li>
          </ul>
        </template>


        <template id="emploidetemp_object">
          <h1><t t-esc="emploidetemp.display_name"/></h1>
          <dl>
            <t t-foreach="emploidetemp._fields" t-as="field">
              <dt><t t-esc="field"/></dt>
              <dd><t t-esc="emploidetemp[field]"/></dd>
            </t>
          </dl>
        </template>

        <template id="niveau_object">
          <h1><t t-esc="niveau.display_name"/></h1>
          <dl>
            <t t-foreach="niveau._fields" t-as="field">
              <dt><t t-esc="field"/></dt>
              <dd><t t-esc="niveau[field]"/></dd>
            </t>
          </dl>
        </template>

        <template id="semestre_object">
          <h1><t t-esc="semestre.display_name"/></h1>
          <dl>
            <t t-foreach="semestre._fields" t-as="field">
              <dt><t t-esc="field"/></dt>
              <dd><t t-esc="semestre[field]"/></dd>
            </t>
          </dl>
        </template>

        <template id="salledecour_object">
          <h1><t t-esc="salledecour.display_name"/></h1>
          <dl>
            <t t-foreach="salledecour._fields" t-as="field">
              <dt><t t-esc="field"/></dt>
              <dd><t t-esc="salledecour[field]"/></dd>
            </t>
          </dl>
        </template>

    </data>
</odoo>