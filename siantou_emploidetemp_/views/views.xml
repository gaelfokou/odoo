<odoo>
  <data>
    <!-- explicit list view definition -->

    <record model="ir.ui.view" id="siantou_emploidetemp.emploidetemp_list">
      <field name="name">Emploi de temps</field>
      <field name="model">siantou.emploidetemp</field>
      <field name="arch" type="xml">
        <tree>
          <field name="filiere"/>
          <field name="niveau"/>
          <field name="semestre"/>
        </tree>
      </field>
    </record>

    <record model="ir.ui.view" id="siantou_emploidetemp.niveau_list">
      <field name="name">Niveaux</field>
      <field name="model">siantou.niveau</field>
      <field name="arch" type="xml">
        <tree>
          <field name="intitule"/>
          <field name="valeur"/>
        </tree>
      </field>
    </record>

    <record model="ir.ui.view" id="siantou_emploidetemp.semestre_list">
      <field name="name">Semestres</field>
      <field name="model">siantou.semestre</field>
      <field name="arch" type="xml">
        <tree>
          <field name="annee"/>
          <field name="valeur"/>
        </tree>
      </field>
    </record>

    <record model="ir.ui.view" id="siantou_emploidetemp.salledecour_list">
      <field name="name">Salle de cours</field>
      <field name="model">siantou.salledecour</field>
      <field name="arch" type="xml">
        <tree>
          <field name="intitule"/>
          <field name="code"/>
          <field name="capacite"/>
        </tree>
      </field>
    </record>


    <!-- actions opening views on models -->

    <record model="ir.actions.act_window" id="siantou_emploidetemp.emploidetemp_action_window">
      <field name="name">Emploi de temps</field>
      <field name="res_model">siantou.emploidetemp</field>
      <field name="view_mode">tree,form</field>
    </record>

    <record model="ir.actions.act_window" id="siantou_emploidetemp.niveau_action_window">
      <field name="name">Niveaux</field>
      <field name="res_model">siantou.niveau</field>
      <field name="view_mode">tree,form</field>
    </record>

    <record model="ir.actions.act_window" id="siantou_emploidetemp.semestre_action_window">
      <field name="name">Semestres</field>
      <field name="res_model">siantou.semestre</field>
      <field name="view_mode">tree,form</field>
    </record>

    <record model="ir.actions.act_window" id="siantou_emploidetemp.salledecour_action_window">
      <field name="name">Salle de cours</field>
      <field name="res_model">siantou.salledecour</field>
      <field name="view_mode">tree,form</field>
    </record>


    <!-- Top menu item -->

    <menuitem name="Emploi de temps" id="siantou_emploidetemp.menu_root"
              action="siantou_emploidetemp.emploidetemp_action_window"/>

    <!-- menu categories -->

    <menuitem name="Emploi de temps" id="siantou_emploidetemp.menu_emploidetemp" parent="siantou_emploidetemp.menu_root"
              action="siantou_emploidetemp.emploidetemp_action_window"/>
    <menuitem name="Niveaux" id="siantou_emploidetemp.menu_niveau" parent="siantou_emploidetemp.menu_root"
              action="siantou_emploidetemp.niveau_action_window"/>
    <menuitem name="Semestres" id="siantou_emploidetemp.menu_semestre" parent="siantou_emploidetemp.menu_root"
              action="siantou_emploidetemp.semestre_action_window"/>
    <menuitem name="Salle de cours" id="siantou_emploidetemp.menu_salledecour" parent="siantou_emploidetemp.menu_root"
              action="siantou_emploidetemp.salledecour_action_window"/>

  </data>
</odoo>