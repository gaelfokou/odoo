<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="siantou_site_action" model="ir.actions.act_window">
        <field name="name">Sites</field>
        <field name="res_model">siantou.site</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p>Cliquez sur nouveau pour créer un nouveau site</p>
        </field>
    </record>

    <record id="siantou_site_form" model="ir.ui.view">
        <field name="name">siantou.site.form</field>
        <field name="model">siantou.site</field>
        <field name="arch" type="xml">
            <form string="site">
                <header>
                </header>
                <sheet>
                <group>
                    <group>
                        <field name="code"/>
                    </group>
                    <group>
                        <field name="name"/>
                    </group>
                    <notebook>
                        <page name="site_specialite" string="Batiments">
                            <field name="batiment_ids">
                                <tree>
                                    <field name="code"/>
                                    <field name="name"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    
                </group>
                    
                </sheet>
            </form>
        </field>
    </record>



    <record id="siantou_site_tree" model="ir.ui.view">
        <field name="name">siantou.site.tree</field>
        <field name="model">siantou.site</field>
        <field name="arch" type="xml">
            <tree string="Sites">
                <field name="code"/>
                <field name="name"/>
            </tree>
        </field>
    </record>


    <menuitem
        id="siantou_menu"
        name="Scolarité"
        sequence="0"/>
    
    <menuitem
        id="siantou_site_menu"
        name="Sites"
        action="siantou_site_action"
        parent="siantou_menu"
        sequence="7"/>
</odoo>