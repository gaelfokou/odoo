<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="siantou_cycle_action" model="ir.actions.act_window">
        <field name="name">Cycles</field>
        <field name="res_model">siantou.cycle</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p>Cliquez sur nouveau pour créer un nouveau cycle</p>
        </field>
    </record>

    <record id="siantou_cycle_form" model="ir.ui.view">
        <field name="name">siantou.cycle.form</field>
        <field name="model">siantou.cycle</field>
        <field name="arch" type="xml">
            <form string="Cycle">
                <header>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="name"/>
                        </group>
                        <notebook>
                            <page name="cycle_filiere" string="Filières">
                                <field name="filiere_ids">
                                    <tree>
                                        <field name="code"/>
                                        <field name="name"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="siantou_cycle_tree" model="ir.ui.view">
        <field name="name">siantou.cycle.tree</field>
        <field name="model">siantou.cycle</field>
        <field name="arch" type="xml">
            <tree string="Cycle">
                <field name="code"/>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <menuitem
        id="siantou_menu"
        name="Scolarité"
        sequence="0"/>
    
    <menuitem
        id="siantou_cycle_menu"
        name="Cycles"
        action="siantou_cycle_action"
        parent="siantou_menu"
        sequence="15"/>
</odoo>