<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="siantou_filiere_action" model="ir.actions.act_window">
        <field name="name">Filières</field>
        <field name="res_model">siantou.filiere</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p>Cliquez sur nouveau pour créer un nouvelle filiere</p>
        </field>
    </record>

    <record id="siantou_filiere_form" model="ir.ui.view">
        <field name="name">siantou.filiere.form</field>
        <field name="model">siantou.filiere</field>
        <field name="arch" type="xml">
            <form string="filiere">
                <header>
                </header>
                <sheet>
                <group>
                    <group>
                        <field name="code"/>
                    </group>
                    <group>
                        <field name="name"/>
                    </group>
                    <group>
                        <field name="cycle_id"/>
                    </group>
                    <notebook>
                        <page name="filiere_niveau" string="Niveaux">
                            <field name="niveau_ids">
                                <tree>
                                    <field name="code"/>
                                    <field name="name"/>
                                </tree>
                            </field>
                        </page>
                        <page name="filiere_specialite" string="Spécialités">
                            <field name="specialite_ids">
                                <tree>
                                    <field name="code"/>
                                    <field name="name"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    
                </group>
                    
                </sheet>
            </form>
        </field>
    </record>

    <record id="siantou_filiere_tree" model="ir.ui.view">
        <field name="name">siantou.filiere.tree</field>
        <field name="model">siantou.filiere</field>
        <field name="arch" type="xml">
            <tree string="Filères">
                <field name="code"/>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <menuitem
        id="siantou_menu"
        name="Scolarité"
        sequence="0"/>
    
    <menuitem
        id="siantou_filiere_menu"
        name="Filières"
        action="siantou_filiere_action"
        parent="siantou_menu"
        sequence="3"/>
</odoo>