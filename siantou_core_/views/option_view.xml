<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="siantou_option_action" model="ir.actions.act_window">
        <field name="name">Options</field>
        <field name="res_model">siantou.option</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p>Cliquez sur nouveau pour créer un nouveau option</p>
        </field>
    </record>

    <menuitem
        id="siantou_menu"
        name="Scolarité"
        sequence="0"/>
    
    <menuitem
        id="siantou_option_menu"
        name="Options"
        action="siantou_option_action"
        parent="siantou_menu"
        sequence="5"/>
</odoo>