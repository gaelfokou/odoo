<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_academic_year_tree" model="ir.ui.view">
			<field name="name">school.academic_year.tree</field>
			<field name="model">is.university.academic_year</field>
			<field name="arch" type="xml">
				<tree string="Années académiques" editable="bottom" edit="1">
                    <field name="name"/>
					<field name="date_start"/>
					<field name="date_end"/>
                    <field name="active"/>
				</tree>
			</field>
		</record>

        <record id="action_university_academic_year" model="ir.actions.act_window">
            <field name="name">Années académiques</field>
            <field name="res_model">is.university.academic_year</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>