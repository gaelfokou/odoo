<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_student_batch_form" model="ir.ui.view">
        <field name="name">student.batch.form</field>
        <field name="model">is.university.school.student.batch</field>
        <field name="arch" type="xml">
            <form string="Lot d'étudiants">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="school_id"/>
                        <field name="program_id"/>
                        <field name="student_ids"/>
                        <field name="max_students"/>
                        <field name="current_size"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_student_batch_tree" model="ir.ui.view">
        <field name="name">student.batch.tree</field>
        <field name="model">is.university.school.student.batch</field>
        <field name="arch" type="xml">
            <tree string="Lots d'étudiants">
                <field name="name"/>
                <field name="school_id"/>
                <field name="program_id"/>
                <field name="max_students"/>
                <field name="current_size"/>
            </tree>
        </field>
    </record>

    <record id="action_student_batch" model="ir.actions.act_window">
        <field name="name">Lots d'étudiants</field>
        <field name="res_model">is.university.school.student.batch</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>