<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_field_of_study_form" model="ir.ui.view">
        <field name="name">field.of.study.form</field>
        <field name="model">is.university.school.field_of_study</field>
        <field name="arch" type="xml">
            <form string="Filière">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="school_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_field_of_study_tree" model="ir.ui.view">
        <field name="name">field.of.study.tree</field>
        <field name="model">is.university.school.field_of_study</field>
        <field name="arch" type="xml">
            <tree string="Filières">
                <field name="name"/>
                <field name="school_id"/>
            </tree>
        </field>
    </record>

    <record id="action_field_of_study" model="ir.actions.act_window">
        <field name="name">Filières</field>
        <field name="res_model">is.university.school.field_of_study</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
