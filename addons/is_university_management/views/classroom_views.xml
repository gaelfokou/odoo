<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_building_classroom_form" model="ir.ui.view">
        <field name="name">building.classroom.form</field>
        <field name="model">is.university.building.classroom</field>
        <field name="arch" type="xml">
            <form string="Salle de classe">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="building_id"/>
                        <field name="capacity"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_building_classroom_tree" model="ir.ui.view">
        <field name="name">building.classroom.tree</field>
        <field name="model">is.university.building.classroom</field>
        <field name="arch" type="xml">
            <tree string="Salles de classe">
                <field name="name"/>
                <field name="building_id"/>
                <field name="capacity"/>
            </tree>
        </field>
    </record>

    <record id="action_building_classroom" model="ir.actions.act_window">
        <field name="name">Salles de classe</field>
        <field name="res_model">is.university.building.classroom</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>