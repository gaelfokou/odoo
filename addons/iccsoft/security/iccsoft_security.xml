<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="module_iccsoft_security" model="ir.module.category">
        <field name="name">ICCSOFT</field>
        <field name="description">Droits de ICCSOFT</field>
    </record>

    <record id="iccsoft_group_user" model="res.groups">
        <field name="name">Utilisateur</field>
        <field name="category_id" ref="module_iccsoft_security" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="iccsoft_group_manager" model="res.groups">
        <field name="name">Administrateur</field>
        <field name="category_id" ref="module_iccsoft_security" />
        <field name="implied_ids" eval="[(4, ref('iccsoft_group_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')),(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
