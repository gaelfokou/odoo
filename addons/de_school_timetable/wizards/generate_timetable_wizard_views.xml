<odoo>
    <data>
        <!-- Define a form view for Timetable Wizard -->
        <record id="timetable_wizard_form_view" model="ir.ui.view">
            <field name="name">oe.school.timetable.wizard.form</field>
            <field name="model">oe.school.generatetimetable.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="semester_id"/>
                            <field name="course_id"/>
                        </group>
                        <footer>
                            <button name="generate_timetable" string="Créer l\'emploi du temps" type="object" class="btn-primary"/>
                            <button string="Annuler" class="btn-secondary" special="cancel"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Define an action to open the form view -->
        <record id="action_generatetimetable_wizard" model="ir.actions.act_window">
            <field name="name">Emploi du temps</field>
            <field name="res_model">oe.school.generatetimetable.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="timetable_wizard_form_view"/>
        </record>

    </data>
</odoo>
