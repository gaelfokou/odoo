        <field name="report_name">account_cash_bank_management.report_recu_payment</field>
        <field name="report_file">account_cash_bank_management.report_recu_payment</field>
        <field name="paperformat_id" ref="recu_payment_paperformat"/>
        <field name="print_report_name">f"Paiement de - {student['name']}" </field>
