<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_recu_payment">
        <t t-call="web.html_container">
            <t t-call="account_cash_bank_management.external_layout">
                <div class="page">
                    <div class="container">
                        <table classe="table table-striped" style="width: 100%;">
                            <tbody>
                                <tr>
                                    <td style="border: 1px solid;padding: 4px;text-align: center; width:30%; vertical-align:top; font-size: 0.8em;">
                                        INSTITUT UNIVERSITAIRE SIANTOU
                                        <br/>
                                        ECOLE SUPERIEUR DE MANAGEMENT,
                                        <br/>
                                        DE GESTION ET DE
                                        <br/>
                                        <small>
                                            B.P. : 04 Yaoundé Cameroun
                                            <br/>
                                            Tél : 22-30-62-71
                                            <br/>
                                            Fax :
                                        </small>
                                    </td>

                                    <td style="border: none;padding: 4px;text-align: center; width:40%">
                                        <img src="siantou_ems_fee/static/src/img/logo.png" alt="logo"
                                             style="width: 200px; height: 120px;"/>
                                    </td>
                                    <td style="border: 1px solid;padding: 4px; text-align: center; width:30%;vertical-align:top; font-size: 0.8em;">
                                        SIANTOU UNIVERSITY INSTITUTE
                                        <br/>
                                        MANAGEMENT SCHOOL,
                                        <br/>
                                        AND MANAGEMENT
                                        <br/>
                                        <small>
                                            B.P. : 04 Yaounde Cameroon
                                            <br/>
                                            Phone : 22-30-62-71
                                            <br/>
                                            Fax :
                                        </small>
                                    </td>
                                </tr>
                                <!-- <tr style="border: none;">
                                    <td colspan="4"
                                        style="text-align: center; border: none;padding: 4px">
                                        <img src="siantou_ems_core/static/src/img/logo.png"
                                            alt="logo"
                                            style="width: 100px; height: 100px;"/>
                                    </td>
                                </tr> -->
                            </tbody>
                        </table>
                        <center>
                            <b style="text-decoration:underline">
                                RECU DE CAISSE SCOLARITE N°
                                <span t-esc="data['info_entete']['numero_recu']"/>
                                DU
                                <span t-esc="data['info_entete']['date']"
                                      t-options="{&quot;widget&quot;: &quot;date&quot;,&quot;format&quot;: &quot;d/MM/Y&quot;}"/>
                            </b>
                            <br/>
                            <b>
                                Année académique :
                                <span t-esc="data['info_entete']['anne_academique']"/>
                            </b>
                        </center>

                        <div class="row" style="margin-top: 10px;">
                            <div class="col-sm-12">
                                <table classe="table table-condensed" style="width: 100%;">
                                    <tbody>
                                        <tr>
                                            <th style="text-align: left;">
                                                <span>Nom(s) et prénom(s)</span>
                                            </th>
                                            <th style="text-align: left;">
                                                <span>Matricule</span>
                                            </th>
                                            <th style="text-align: left;">
                                                <span>Filière</span>
                                            </th>
                                            <th style="text-align: left;">
                                                <span>Niveau académique</span>
                                            </th>
                                        </tr>
                                        <tr>
                                            <td>
                                                <span t-esc="data['info_etudiant']['nom']"/>
                                            </td>
                                            <td>
                                                <span t-esc="data['info_etudiant']['matricule']"/>
                                            </td>
                                            <td>
                                                <span t-esc="data['info_etudiant']['filiere']"/>
                                            </td>
                                            <td>
                                                <span t-esc="data['info_etudiant']['niveau']"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-12">
                                <table classe="table table-striped" style="width: 100%;">
                                    <thead>
                                        <tr style="border: 1px solid black;text-align: left;">
                                            <th style="border: 1px solid black;text-align: left;padding: 4px; width: 50%">
                                                Libellé
                                            </th>
                                            <th style="border: 1px solid black;text-align: left;padding: 4px; width: 25%">
                                                Perçue
                                            </th>
                                            <th style="border: 1px solid black;text-align: left;padding: 4px; width: 25%">
                                                Observation
                                            </th>
                                            <!-- <th style="border: 1px solid black;padding: 4px">Reste
                                                à payer</th> -->
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="data['lignes_de_recouvrements']" t-as="l">
                                            <tr style="border: 1px solid black">
                                                <td style="border: 1px solid black;padding: 4px">
                                                    <t t-esc="l['libelle']"/>
                                                </td>
                                                <td style="border: 1px solid black;padding: 4px;">
                                                    <t t-esc="l['montant_recu']"/>
                                                </td>
                                                <td style="border: 1px solid black;padding: 4px">
                                                    <span/>
                                                </td>
                                            </tr>
                                        </t>
                                        <tr style="border: 1px solid black; background-color:floralwhite">
                                            <td colspan="4"
                                                style="text-align: center; border: 1px solid black;padding: 4px">
                                                <b>
                                                    <span>Montant total versé :
                                                        <t t-esc="data['info_entete']['montant_verse']"/>
                                                    </span>
                                                </b>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="row mt-3 mb-3">
                            <div class="col-12 text-center">
                                <h5>Arrête la présente facture à la somme de :
                                    <strong>
                                        <span t-esc="data['info_entete']['montant_verse']"/>
                                    </strong>
                                    au titre de l'année académique
                                    <span t-esc="data['info_entete']['anne_academique']"/>
                                </h5>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>