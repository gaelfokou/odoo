<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="recu_payment_paperformat" model="report.paperformat">
        <field name="name">PAPER FORMAT RECU PAIEMENT</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">7</field>
            <field name="margin_bottom">32</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="False" />
            <field name="header_spacing">15</field>
            <field name="dpi">90</field>
    </record>

    <record id="paperformat_fee_payment" model="report.paperformat">
        <field name="name">Format du diplome</field>
        <field name="default" eval="True" />
        <field name="orientation">Landscape</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="True" />
        <field name="header_spacing">5</field>
        <field name="dpi">90</field>
    </record>
</odoo>
