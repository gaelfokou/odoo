        <record id="view_bank_statement_form_custom" model="ir.ui.view">
            <field name="name">account.bank.statement.form.custom</field>
            <field name="model">account.bank.statement</field>
            <field name="priority">1</field>
            <field name="arch" type="xml">
                <form string="Bank Statement">
                    <header>
                        <button name="action_encaisser" invisible="state != 'open'" string="Encaisser" type="object"
                                class="oe_highlight" data-hotkey="e"/>
                        <button name="action_open_reconcile_statement" invisible="statement_line_count == 0" string="Reconcilier" type="object"
                                class="oe_highlight" data-hotkey="r"/>
                        <button name="action_confirm" invisible="state != 'open'" string="Clôturer" type="object"
                                class="oe_highlight" data-hotkey="q"/>
                        <button name="action_draft" invisible="state != 'confirm'" string="Set to new" type="object" data-hotkey="q"/>
                        <field name="all_lines_reconciled" invisible="1"/>
                        <field name="state" widget="statusbar" statusbar_visible="open,confirm"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" name="button_journal_entries"
                                    string="Journal Entries" type="object"
                                    invisible="move_line_count == 0" icon="fa-bars"/>
                            <field name="move_line_count" invisible="1"/>
                            <field name="statement_line_count" invisible="1"/>

                        </div>
                        <div class="oe_title oe_inline">
                            <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name" readonly="state == 'confirm'"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="journal_type" invisible="1"/>
                                <!--<field name="cashbox_start_id" invisible="1"/>-->
                                <!--<field name="cashbox_end_id" invisible="1"/>-->
                                <field name="journal_id" domain="[('type', '=', journal_type)]"
                                       readonly="move_line_count != 0 or state == 'confirm'" widget="selection"/>
                                <!--<field name="journal_trick_id" domain="[('type', '=', journal_type)]"
                                       readonly="move_line_count != 0" widget="selection"/>-->
                                <field name="date" readonly="state == 'confirm'"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                            <group>
                                <field name="caissier_id"/>
                                <label for="balance_start"/>
                                <div>
                                    <field class="oe_inline" name="balance_start" readonly="state == 'confirm'"/>
                                </div>
                                <label for="balance_end_real"/>
                                <div>
                                    <field class="oe_inline" name="balance_end_real" readonly="state == 'confirm'"/>
                                </div>
                            </group>
                        </group>

                        <notebook>
                            <page string="Transactions" name="statement_line_ids">
                                <field name="line_ids" context="{'date':date}" readonly="1">
                                    <tree string="Statement lines">
                                        <field name="is_reconciled" column_invisible="True" invisible="True"/>
                                        <field name="currency_id" column_invisible="True" readonly="is_reconciled == True"/>
                                        <field name="move_id" column_invisible="True" readonly="is_reconciled == True"/>
                                        <field name="amount_currency" column_invisible="True" readonly="is_reconciled == True"/>
                                        <field name="sequence" widget="handle" readonly="is_reconciled == True"/>
                                        <field name="date" readonly="1" decoration-muted="is_reconciled == True"/>
                                        <field name="payment_ref" readonly="is_reconciled == True" decoration-muted="is_reconciled == True"/>
                                        <field name="partner_id" decoration-muted="is_reconciled == True"
                                               domain="['|',('parent_id', '=', False),('is_company', '=', True)]"
                                               context="{'default_supplier': 1}" readonly="is_reconciled == True"/>
                                        <field name="ecole_id" optional="show" readonly="is_reconciled == True"/>
                                        <field name="departement_id" optional="show" readonly="is_reconciled == True"/>
                                        <field name="field_of_study_id" optional="show" readonly="is_reconciled == True"/>
                                        <field name="specialite_id" optional="show" readonly="is_reconciled == True"/>
                                        <field name="annee_academique_id" optional="show" readonly="is_reconciled == True"/>
                                        <field name="cycle_id" optional="show" readonly="is_reconciled == True"/>
                                        <field name="level_id" optional="show" readonly="is_reconciled == True"/>
                                        <field name="semestre_id" optional="show" readonly="is_reconciled == True"/>
                                        <field name="ref" readonly="is_reconciled == True" decoration-muted="is_reconciled == True"/>
                                        <field name="montant_recu" readonly="is_reconciled == True" decoration-muted="is_reconciled == True"/>
                                        <field name="amount" string="Montant payé" readonly="is_reconciled == True" decoration-muted="is_reconciled == True"/>
                                        <button class="btn btn-warning" name="imprimer_recu" string="Imprimer" readonly="is_reconciled == True" type="object" icon="fa-print" data-hotkey="F"/>
                                    </tree>
                                    <form>
                                        <!-- <header>
                                            <button 
                                                class="btn btn-success" 
                                                name="action_search_student" 
                                                string="Rechercher" 
                                                type="object" icon="fa-search"/>
                                        </header> -->
                                        <sheet>
                                            <group>
                                                <group string="Informations sur l'étudiant(e)">
                                                    <field string="Etudiant(e)" name="partner_id" 
                                                        domain="['|',('parent_id', '=', False),('is_company', '=', True)]"
                                                        context="{'default_supplier': 1}"/>
                                                    <field name="ecole_id" optional="show"/>
                                                    <field name="departement_id" optional="hide"/>
                                                    <field name="field_of_study_id" optional="show"/>
                                                    <field name="currency_id" invisible="1"/>
                                                    <field name="specialite_id" optional="show"/>
                                                    <field name="annee_academique_id" optional="hide"/>
                                                    <field name="cycle_id" optional="show"/>
                                                    <field name="level_id" optional="show"/>
                                                </group>
                                                <group string="Informations sur le paiement">
                                                    <field name="ref" optional="show"/>
                                                    <field name="payment_ref" optional="show"/>
                                                    <field name="date" optional="show"/>
                                                    <div class="oe_title">
                                                        <label for="amount" string="Montant"/>
                                                        <h1><field name="amount"/></h1>
                                                    </div>
                                                </group>
                                            </group>
                                        </sheet>
                                    </form>
                                </field>
                            </page>
                        </notebook>
                        <group class="oe_subtotal_footer oe_right" colspan="2" name="sale_total">
                            <div class="oe_subtotal_footer_separator oe_inline">
                                <label for="balance_end"/>
                            </div>
                            <field name="balance_end" nolabel="1" class="oe_subtotal_footer_separator"/>
                        </group>
                        <div class="oe_clear"/>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="view_bank_statement_line_tree_bank_rec_widget_inherit" model="ir.ui.view">
            <field name="name">account.bank.statement.line.tree.bank_rec_widget.inherit</field>
            <field name="model">account.bank.statement.line</field>
            <field name="inherit_id" ref="account_accountant.view_bank_statement_line_tree_bank_rec_widget"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='statement_id']" position="replace">
                    <field name="statement_id"
                           decoration-danger="statement_complete == False or statement_valid == False"/>
                </xpath>
            </field>
        </record>

        <record id="action_account_bank_statements" model="ir.actions.act_window">
            <field name="name">Bank Statements</field>
            <field name="res_model">account.bank.statement</field>
            <field name="views">view_bank_statement_tree_custom,view_bank_statement_form_custom</field>
            <field name="view_mode">tree,form</field>
            <field name="target">current</field>
            <field name="context">{'journal_type':'bank'}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click to register a bank statement.
                </p>
                <p>
                    A bank statement is a summary of all financial transactions
                    occurring over a given period of time on a bank account. You
                    should receive this periodicaly from your bank.
                </p>
                <p>
                    Odoo allows you to reconcile a statement line directly with
                    the related sale or puchase invoices.
                </p>
            </field>
        </record>

        <menuitem
                parent="account.menu_finance_entries_accounting_miscellaneous"
                action="action_account_bank_statements"
                id="menu_account_bank_statements"
                sequence="30"
        />

    </data>
</odoo>