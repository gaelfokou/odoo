<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_move_form" model="ir.ui.view">
            <field name="name">account.move.form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='other_info']" position="after">
                    <page string="Université" name="university_info" invisible="move_type not in ['entry', 'out_invoice', 'out_refund']">
                        <group>
                            <group string="Établissement">
                                <field name="ecole_id" readonly="1"/>
                                <field name="departement_id" readonly="1"/>
                            </group>
                            <group string="Spécialité">
                                <field name="field_of_study_id" readonly="1"/>
                                <field name="specialite_id" readonly="1"/>
                            </group>
                            <group string="Grade">
                                <field name="cycle_id" readonly="1"/>
                                <field name="level_id" readonly="1"/>
                            </group>
                            <group string="Période scolaire">
                                <field name="annee_academique_id" readonly="1"/>
                                <field name="semestre_id" readonly="1"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

        <record id="view_move_tree" model="ir.ui.view">
            <field name="name">account.move.tree2</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="ecole_id" optional="hide" />
                    <field name="departement_id" optional="hide" />
                    <field name="field_of_study_id" optional="hide" />
                    <field name="specialite_id" optional="hide" />
                    <field name="annee_academique_id" optional="hide" />
                    <field name="cycle_id" optional="hide" />
                    <field name="level_id" optional="hide" />
                    <field name="semestre_id" optional="hide" />
                </xpath>
            </field>
        </record>


    </data>
</odoo>