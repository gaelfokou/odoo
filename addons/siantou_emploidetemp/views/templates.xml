<odoo>
    <data>

        <template id="emploidetemp_listing">
          <ul>
            <li t-foreach="emploidetemps" t-as="emploidetemp">
              <a t-attf-href="#{ root }/#{ emploidetemp.id }">
                <t t-esc="emploidetemp.display_name"/>
              </a>
            </li>
          </ul>
        </template>

        <template id="semestre_listing">
          <ul>
            <li>
              <t t-esc="semestre"/>
            </li>
          </ul>
        </template>


        <template id="emploidetemp_object">
          <h1><t t-esc="emploidetemp.display_name"/></h1>
          <dl>
            <t t-foreach="emploidetemp._fields" t-as="field">
              <dt><t t-esc="field"/></dt>
              <dd><t t-esc="emploidetemp[field]"/></dd>
            </t>
          </dl>
        </template>

    </data>
</odoo>