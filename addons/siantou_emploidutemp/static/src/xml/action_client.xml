<?xml version="1.0" encoding="utf-8"?>
<templates id="siantou_emploidutemp.custom_client_template" xml:space="preserve">
  <t t-name="siantou_emploidutemp.document_scanner">
      <div id="siantou_emploidutemp.container">
        <div>
          <h5>Document scanner</h5>
        </div>
        <div>
          <video id="siantou_emploidutemp.video_element" width="320" height="0" autoplay="1"></video>
        </div>
        <div>
          <canvas id="siantou_emploidutemp.canvas_element" width="320" height="0"></canvas>
        </div>
        <div>
          <img id="siantou_emploidutemp.photo_element" style="display: none;"/>
        </div>
        <div>
          <button id="siantou_emploidutemp.start_button" disabled="1">Start webcam</button>
          <button id="siantou_emploidutemp.capture_button" disabled="1">Capture document</button>
        </div>
      </div>
  </t>
</templates>