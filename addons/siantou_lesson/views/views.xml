<odoo>
  <data>
    <!-- explicit list view definition -->

    <record model="ir.ui.view" id="siantou_lesson.list">
      <field name="name">siantou_lesson list</field>
      <field name="model">siantou.lesson</field>
      <field name="arch" type="xml">
        <tree>
          <field name="name"/>
          <field name="value"/>
          <field name="value2"/>
        </tree>
      </field>
    </record>


    <!-- actions opening views on models -->

    <record model="ir.actions.act_window" id="siantou_lesson.action_window">
      <field name="name">siantou_lesson window</field>
      <field name="res_model">siantou.lesson</field>
      <field name="view_mode">tree,form</field>
    </record>


    <!-- server action to the one above -->

    <record model="ir.actions.server" id="siantou_lesson.action_server">
      <field name="name">siantou_lesson server</field>
      <field name="model_id" ref="model_siantou_lesson"/>
      <field name="state">code</field>
      <field name="code">
        action = {
          "type": "ir.actions.act_window",
          "view_mode": "tree,form",
          "res_model": model._name,
        }
      </field>
    </record>


    <!-- Top menu item -->

    <menuitem name="siantou_lesson" id="siantou_lesson.menu_root"/>

    <!-- menu categories -->

    <menuitem name="Menu 1" id="siantou_lesson.menu_1" parent="siantou_lesson.menu_root"/>
    <menuitem name="Menu 2" id="siantou_lesson.menu_2" parent="siantou_lesson.menu_root"/>

    <!-- actions -->

    <menuitem name="List" id="siantou_lesson.menu_1_list" parent="siantou_lesson.menu_1"
              action="siantou_lesson.action_window"/>
    <menuitem name="Server to list" id="siantou_lesson" parent="siantou_lesson.menu_2"
              action="siantou_lesson.action_server"/>

  </data>
</odoo>