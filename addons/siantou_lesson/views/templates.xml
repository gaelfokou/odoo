<odoo>
    <data>

        <template id="listing">
          <ul>
            <li t-foreach="lessons" t-as="lesson">
              <a t-attf-href="#{ root }/#{ lesson.id }">
                <t t-esc="lesson.display_name"/>
              </a>
            </li>
          </ul>
        </template>
        <template id="object">
          <h1><t t-esc="lesson.display_name"/></h1>
          <dl>
            <t t-foreach="lesson._fields" t-as="field">
              <dt><t t-esc="field"/></dt>
              <dd><t t-esc="lesson[field]"/></dd>
            </t>
          </dl>
        </template>

    </data>
</odoo>