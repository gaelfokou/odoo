<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="siantou_matiere_action" model="ir.actions.act_window">
        <field name="name">Matières</field>
        <field name="res_model">siantou.matiere</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p>Cliquez sur nouveau pour créer un nouveau matiere</p>
        </field>
    </record>

    <record id="siantou_matiere_tree" model="ir.ui.view">
        <field name="name">siantou.matiere.tree</field>
        <field name="model">siantou.matiere</field>
        <field name="arch" type="xml">
            <tree string="Matières">
                <field name="code"/>
                <field name="name"/>
                <field name="nbre_cm"/>
                <field name="nbre_tp"/>
                <field name="nbre_tpe"/>
                <field name="nbre_credit"/>
                <field name="specialite_id"/>
                <field name="option_id"/>
            </tree>
        </field>
    </record>

    <menuitem
        id="siantou_menu"
        name="Siantou Université"
        sequence="0"/>
    
    <menuitem
        id="siantou_matiere_menu"
        name="Matieres"
        action="siantou_matiere_action"
        parent="siantou_menu"
        sequence="4"/>
</odoo>