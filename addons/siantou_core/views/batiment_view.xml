<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="siantou_batiment_action" model="ir.actions.act_window">
        <field name="name">Batiments</field>
        <field name="res_model">siantou.batiment</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p>Cliquez sur nouveau pour créer un nouveau batiment</p>
        </field>
    </record>

    <record id="siantou_batiment_form" model="ir.ui.view">
        <field name="name">siantou.batiment.form</field>
        <field name="model">siantou.batiment</field>
        <field name="arch" type="xml">
            <form string="batiment">
                <header>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="name"/>
                        </group>
                    </group>
                    <group>
                        <field name="site_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="siantou_batiment_tree" model="ir.ui.view">
        <field name="name">siantou.batiment.tree</field>
        <field name="model">siantou.batiment</field>
        <field name="arch" type="xml">
            <tree string="Batiments">
                <field name="code"/>
                <field name="name"/>
                <field name="site_id"/>
            </tree>
        </field>
    </record>

    <menuitem
        id="siantou_menu"
        name="Siantou Université"
        sequence="0"/>
    
    <menuitem
        id="siantou_batiment_menu"
        name="Batiments"
        action="siantou_batiment_action"
        parent="siantou_menu"
        sequence="1"/>
</odoo>