<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="siantou_salle_action" model="ir.actions.act_window">
        <field name="name">Salles</field>
        <field name="res_model">siantou.salle</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p>Cliquez sur nouveau pour créer une nouvelle salle</p>
        </field>
    </record>

    <record id="siantou_salle_tree" model="ir.ui.view">
        <field name="name">siantou.salle.tree</field>
        <field name="model">siantou.salle</field>
        <field name="arch" type="xml">
            <tree string="Salles">
                <field name="code"/>
                <field name="name"/>
                <field name="batiment_id"/>
            </tree>
        </field>
    </record>

    <menuitem
        id="siantou_menu"
        name="Siantou Université"
        sequence="0"/>
    
    <menuitem
        id="siantou_salle_menu"
        name="Salles"
        action="siantou_salle_action"
        parent="siantou_menu"
        sequence="6"/>
</odoo>